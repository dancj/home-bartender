---
import { Image } from 'astro:assets';
import type { Recipe } from '../lib/recipes';
import { label } from '../lib/taxonomy';
import { iconUrl } from '../lib/icon-urls';
import { spiritAccentVar } from '../lib/accents';

interface Props {
  recipe: Recipe;
}
const { recipe } = Astro.props;
const slug = recipe.id.split('/').pop();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = recipe.data;
const primarySpirit = data.spirits[0];
const accent = spiritAccentVar(primarySpirit);
// Photo when hero_image is set, else a fallback tile (see plan KD3).
const hasPhoto = Boolean(data.hero_image);
const glassIcon = iconUrl('glass', data.glass);
// Meta row is text only (no icons): method, then up to two flavors. Keeps the
// row from wrapping past a line on flavor-heavy recipes.
const metaFlavors = data.flavors.slice(0, 2).map((f) => label('flavor', f));
---
<li
  class="recipe-card"
  data-title={data.title}
  data-spirits={data.spirits.join(',')}
  data-flavors={data.flavors.join(',')}
  data-method={data.method}
>
  <a href={`${base}/recipes/${slug}/`} class="card h-full recipe-photo-card" style={`--accent: ${accent}`}>
    <div class:list={['card-media', !hasPhoto && 'card-media--empty']}>
      {data.hero_image ? (
        <Image
          class="card-img"
          src={data.hero_image}
          alt=""
          widths={[256, 320, 512]}
          sizes="(min-width: 70rem) 300px, (min-width: 40rem) 45vw, 90vw"
          loading="lazy"
          decoding="async"
        />
      ) : (
        glassIcon && (
          <span class="tax-icon card-tile-icon" style={`--icon-url: url("${glassIcon}")`} aria-hidden="true"></span>
        )
      )}
      {primarySpirit && <span class="card-badge">{label('spirits', primarySpirit)}</span>}
    </div>
    <div class="card-body">
      <h2 class="card-title">{data.title}</h2>
      <p class="card-blurb">{data.blurb}</p>
      <p class="recipe-card-meta">
        <span>{label('method', data.method)}</span>
        {metaFlavors.map((f) => (
          <>
            <span class="meta-dot" aria-hidden="true"></span>
            <span>{f}</span>
          </>
        ))}
      </p>
    </div>
  </a>
</li>

<style>
  /* Photo-first card. Builds on the shared .card primitive (surface, lift
     transition, reduced-motion zeroing) but goes edge-to-edge: no padding, its
     own 20px radius, and overflow-hidden so the image clips to the top corners.
     The whole <a> is the link (middle-click + keyboard focus work). --accent is
     set inline per spirit and drives the badge, tile, and dots. */
  .recipe-photo-card {
    padding: 0;
    gap: 0;
    overflow: hidden;
    border-radius: var(--radius-card-photo);
    box-shadow: var(--shadow-photo-card);
  }
  @media (hover: hover) {
    .recipe-photo-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-photo-card-hover);
    }
  }

  .card-media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--color-surface-muted);
  }
  .card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* No-photo fallback: an accent band, 72px minimum. In a row with a photo
     card it grows to absorb the extra height (flex: 1) so the text section
     stays its natural size. Accent hue at 8% alpha, hairline at ~13%, masked
     glass icon in the accent hue; the badge carries the spirit name. */
  .card-media--empty {
    aspect-ratio: auto;
    flex: 1;
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 18px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 13%, transparent);
  }
  .card-tile-icon {
    --icon-size: 40px;
    color: var(--accent);
    opacity: 0.55;
  }

  .card-badge {
    position: absolute;
    left: 12px;
    top: 12px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgb(251 248 242 / 0.94);
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card-media--empty .card-badge {
    top: 50%;
    transform: translateY(-50%);
    left: 18px;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 18px 16px;
  }
  .card-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-fg);
  }
  .card-blurb {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-fg-muted);
  }
  .recipe-card-meta {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-subtle);
  }
  .meta-dot {
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: var(--color-rule-strong);
  }
</style>
