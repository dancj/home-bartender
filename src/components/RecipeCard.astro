---
import type { Recipe } from '../lib/recipes';
import { label } from '../lib/taxonomy';
import Icon from './Icon.astro';

interface Props {
  recipe: Recipe;
}
const { recipe } = Astro.props;
const slug = recipe.id.split('/').pop();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = recipe.data;
const primarySpirit = data.spirits[0];
---
<li
  class="recipe-card"
  data-spirits={data.spirits.join(',')}
  data-flavors={data.flavors.join(',')}
  data-method={data.method}
  data-difficulty={data.difficulty}
>
  <a href={`${base}/recipes/${slug}/`} class="card h-full">
    <h2 class="font-serif text-xl font-semibold leading-[1.2] tracking-[-0.01em] text-fg">{data.title}</h2>
    {primarySpirit && <p class="eyebrow card-spirit">{label('spirits', primarySpirit)}</p>}
    <p class="font-serif italic text-[0.95rem] leading-[1.45] text-fg-muted flex-1">{data.blurb}</p>
    <p class="recipe-card-meta">
      <span><Icon field="method" slug={data.method} /> {label('method', data.method)}</span>
      {data.format !== 'single' && (
        <>
          <span aria-hidden="true">·</span>
          <span><Icon field="format" slug={data.format} /> {label('format', data.format)}</span>
        </>
      )}
    </p>
    {data.flavors.length > 0 && (
      <p class="recipe-card-flavors" aria-hidden="true">
        {data.flavors.map((f) => <Icon field="flavor" slug={f} class="recipe-card-flavor" />)}
      </p>
    )}
  </a>
</li>

<style>
  /* Meta row: small caps mini-badge. Kept as a scoped class so the
     descendant span[aria-hidden] opacity selector stays clean — the
     equivalent Tailwind arbitrary variant string is noisy enough to
     hurt readability for one selector. */
  .recipe-card-meta {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .recipe-card-meta span[aria-hidden] { opacity: 0.5; }
  .card-spirit {
    color: var(--color-accent);
  }
  .recipe-card-meta :global(.tax-icon) {
    --icon-size: 3.6em;
    vertical-align: -1.4em;
  }

  /* Flavor row: a glance-able strip of the recipe's flavor icons, replacing
     the difficulty badge. Decorative — the flavors stay machine-readable via
     the card's data-flavors attribute for filtering. */
  .recipe-card-flavors {
    margin-top: 0.45rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    color: var(--color-fg-subtle);
  }
  .recipe-card-flavors :global(.recipe-card-flavor) {
    --icon-size: 20px;
  }
</style>
