---
import type { Recipe } from '../lib/recipes';
import { label } from '../lib/taxonomy';

interface Props {
  recipe: Recipe;
}
const { recipe } = Astro.props;
const slug = recipe.id.split('/').pop();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = recipe.data;
const primarySpirit = data.spirits[0];
---
<li
  class="recipe-card"
  data-spirits={data.spirits.join(',')}
  data-flavors={data.flavors.join(',')}
  data-method={data.method}
  data-difficulty={data.difficulty}
>
  <a href={`${base}/recipes/${slug}/`} class="card">
    {primarySpirit && <p class="card-eyebrow eyebrow">{label('spirits', primarySpirit)}</p>}
    <h2 class="card-title">{data.title}</h2>
    <p class="card-blurb">{data.blurb}</p>
    <p class="card-meta">
      <span>{label('method', data.method)}</span>
      <span aria-hidden="true">·</span>
      <span>{label('difficulty', data.difficulty)}</span>
      {data.format !== 'single' && (
        <>
          <span aria-hidden="true">·</span>
          <span>{data.format}</span>
        </>
      )}
    </p>
  </a>
</li>

<style>
  .recipe-card {
    list-style: none;
  }
  .card-eyebrow {
    margin: 0;
    color: var(--color-fg-muted);
  }
  .card-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-fg);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .card-blurb {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--color-fg-muted);
    line-height: 1.45;
    margin: 0;
    flex: 1;
  }
  .card-meta {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .card-meta span[aria-hidden] { opacity: 0.5; }
</style>
