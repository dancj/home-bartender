---
import type { Recipe } from '../lib/recipes';
import { label } from '../lib/taxonomy';

interface Props {
  recipe: Recipe;
}
const { recipe } = Astro.props;
const slug = recipe.id.split('/').pop();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = recipe.data;
---
<li
  class="recipe-card"
  data-spirits={data.spirits.join(',')}
  data-flavors={data.flavors.join(',')}
  data-method={data.method}
  data-difficulty={data.difficulty}
>
  <a href={`${base}/recipes/${slug}/`}>
    <h2>{data.title}</h2>
    <p class="blurb">{data.blurb}</p>
    <ul class="meta">
      <li class="method">{label('method', data.method)}</li>
      <li class="difficulty">{label('difficulty', data.difficulty)}</li>
      {data.spirits[0] && <li class="spirit">{label('spirits', data.spirits[0])}</li>}
    </ul>
  </a>
</li>

<style>
  .recipe-card > a {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    background: var(--color-bg);
    transition: border-color 150ms, transform 150ms;
    height: 100%;
  }
  .recipe-card > a:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .recipe-card h2 {
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
  }
  .recipe-card .blurb {
    font-size: 0.9rem;
    color: var(--color-muted);
    font-style: italic;
    margin: 0 0 0.75rem;
    line-height: 1.4;
  }
  .meta {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .meta li {
    padding: 0.2rem 0.5rem;
    background: var(--color-soft);
    border-radius: 3px;
  }
</style>
