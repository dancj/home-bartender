---
import type { Recipe } from '../lib/recipes';
import { label } from '../lib/taxonomy';

interface Props {
  recipe: Recipe;
}
const { recipe } = Astro.props;
const slug = recipe.id.split('/').pop();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = recipe.data;
const primarySpirit = data.spirits[0];
---
<li
  class="recipe-card"
  data-spirits={data.spirits.join(',')}
  data-flavors={data.flavors.join(',')}
  data-method={data.method}
  data-difficulty={data.difficulty}
>
  <a href={`${base}/recipes/${slug}/`} class="card h-full">
    {primarySpirit && <p class="eyebrow">{label('spirits', primarySpirit)}</p>}
    <h2 class="font-serif text-xl font-semibold leading-[1.2] tracking-[-0.01em] text-fg">{data.title}</h2>
    <p class="font-serif italic text-[0.95rem] leading-[1.45] text-fg-muted flex-1">{data.blurb}</p>
    <p class="recipe-card-meta">
      <span>{label('method', data.method)}</span>
      <span aria-hidden="true">·</span>
      <span>{label('difficulty', data.difficulty)}</span>
      {data.format !== 'single' && (
        <>
          <span aria-hidden="true">·</span>
          <span>{data.format}</span>
        </>
      )}
    </p>
  </a>
</li>

<style>
  /* Meta row: small caps mini-badge. Kept as a scoped class so the
     descendant span[aria-hidden] opacity selector stays clean — the
     equivalent Tailwind arbitrary variant string is noisy enough to
     hurt readability for one selector. */
  .recipe-card-meta {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .recipe-card-meta span[aria-hidden] { opacity: 0.5; }
</style>
