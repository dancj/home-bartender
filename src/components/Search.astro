---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props {
  mode?: 'compact' | 'full';
  /** Unique element id — required when more than one Search mounts on a page
      (e.g. the header search + the 404's inline search). Defaults preserve the
      single-instance case. */
  id?: string;
}
const { mode = 'compact', id = 'search' } = Astro.props;
---
<link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
<div id={id} class:list={['search-ui', mode]}></div>
<script is:inline define:vars={{ base, mode, id }}>
  (async function () {
    try {
      await import(`${base}/pagefind/pagefind-ui.js`);
      new PagefindUI({
        element: `#${id}`,
        bundleDirectory: `${base}/pagefind/`,
        showImages: false,
        resetStyles: false,
        showSubResults: mode === 'full',
        pageSize: mode === 'full' ? 20 : 5,
      });
    } catch (e) {
      const el = document.getElementById(id);
      if (el) el.innerHTML = '<p class="search-fallback">Search index not built yet. Run <code>npm run build</code>.</p>';
    }
  })();
</script>

<style is:global>
  /* Scope tokens at .pagefind-ui — Pagefind defines its own vars here. */
  .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-fg);
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-rule);
    --pagefind-ui-tag: var(--color-surface-muted);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: var(--font-sans);
  }
  .pagefind-ui input,
  .pagefind-ui .pagefind-ui__search-input {
    background: var(--color-surface);
    color: var(--color-fg);
    border-color: var(--color-rule);
  }
  .pagefind-ui input::placeholder { color: var(--color-fg-subtle); }
  .pagefind-ui input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-ring);
    outline: none;
  }
  .pagefind-ui .pagefind-ui__search-clear {
    background: var(--color-surface-muted);
    color: var(--color-fg);
  }
  .pagefind-ui mark {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
  .search-ui.compact { width: 100%; }
  .search-ui.full { max-width: 100%; }
  .search-fallback {
    color: var(--color-fg-muted);
    font-size: 0.875rem;
    font-family: var(--font-sans);
  }

  /* Compact mode (in-header) — input chrome flips to dark to read on the
     header slab. Results area inherits the global cream theming since it
     renders below the input against the page bg. */
  .search-ui.compact .pagefind-ui input,
  .search-ui.compact .pagefind-ui .pagefind-ui__search-input {
    background: rgb(255 255 255 / 0.06);
    color: var(--color-header-fg);
    border-color: rgb(255 255 255 / 0.1);
  }
  .search-ui.compact .pagefind-ui input::placeholder {
    color: var(--color-header-fg-muted);
  }
  .search-ui.compact .pagefind-ui input:focus,
  .search-ui.compact .pagefind-ui .pagefind-ui__search-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-ring);
  }
  .search-ui.compact .pagefind-ui .pagefind-ui__search-clear {
    background: rgb(255 255 255 / 0.08);
    color: var(--color-header-fg);
  }
</style>
