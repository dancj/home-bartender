---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props {
  mode?: 'compact' | 'full';
}
const { mode = 'compact' } = Astro.props;
---
<link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
<div id="search" class:list={[mode]}></div>
<script is:inline define:vars={{ base, mode }}>
  (async function () {
    try {
      await import(`${base}/pagefind/pagefind-ui.js`);
      new PagefindUI({
        element: '#search',
        bundleDirectory: `${base}/pagefind/`,
        showImages: false,
        resetStyles: false,
        showSubResults: mode === 'full',
        pageSize: mode === 'full' ? 20 : 5,
      });
    } catch (e) {
      const el = document.getElementById('search');
      if (el) el.innerHTML = '<p class="search-fallback">Search index not built yet. Run <code>npm run build</code>.</p>';
    }
  })();
</script>

<style is:global>
  /* Scope tokens at .pagefind-ui — Pagefind defines its own vars here. */
  .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: hsl(var(--accent));
    --pagefind-ui-text: hsl(var(--fg));
    --pagefind-ui-background: hsl(var(--surface));
    --pagefind-ui-border: hsl(var(--rule));
    --pagefind-ui-tag: hsl(var(--surface-muted));
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: var(--font-sans);
  }
  .pagefind-ui input,
  .pagefind-ui .pagefind-ui__search-input {
    background: hsl(var(--surface));
    color: hsl(var(--fg));
    border-color: hsl(var(--rule));
  }
  .pagefind-ui input::placeholder { color: hsl(var(--fg-subtle)); }
  .pagefind-ui input:focus {
    border-color: hsl(var(--accent));
    box-shadow: 0 0 0 3px hsl(var(--accent-ring));
    outline: none;
  }
  .pagefind-ui .pagefind-ui__search-clear {
    background: hsl(var(--surface-muted));
    color: hsl(var(--fg));
  }
  .pagefind-ui mark {
    background: hsl(var(--accent));
    color: hsl(var(--accent-fg));
  }
  #search.compact { width: 100%; }
  #search.full { max-width: 100%; }
  .search-fallback {
    color: hsl(var(--fg-muted));
    font-size: 0.875rem;
    font-family: var(--font-sans);
  }
</style>
