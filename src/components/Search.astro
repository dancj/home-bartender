---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props {
  mode?: 'compact' | 'full';
}
const { mode = 'compact' } = Astro.props;
---
<link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
<div id="search" class:list={[mode]}></div>
<script is:inline define:vars={{ base, mode }}>
  (async function () {
    try {
      await import(`${base}/pagefind/pagefind-ui.js`);
      new PagefindUI({
        element: '#search',
        bundleDirectory: `${base}/pagefind/`,
        showImages: false,
        resetStyles: false,
        showSubResults: mode === 'full',
        pageSize: mode === 'full' ? 20 : 5,
      });
    } catch (e) {
      const el = document.getElementById('search');
      if (el) el.innerHTML = '<p style="color:var(--color-muted); font-size:0.875rem;">Search index not built yet. Run <code>npm run build</code>.</p>';
    }
  })();
</script>

<style is:global>
  /* Override at .pagefind-ui scope, not :root — Pagefind's own CSS defines
     its variables on .pagefind-ui so root overrides get shadowed. */
  .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-bg);
    --pagefind-ui-border: var(--color-rule);
    --pagefind-ui-tag: var(--color-soft);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: var(--font-serif);
  }
  /* Pagefind's input doesn't inherit colors cleanly in some themes. */
  .pagefind-ui input,
  .pagefind-ui .pagefind-ui__search-input {
    background: var(--color-bg);
    color: var(--color-text);
    border-color: var(--color-rule);
  }
  .pagefind-ui input::placeholder { color: var(--color-muted); }
  .pagefind-ui .pagefind-ui__search-clear {
    background: var(--color-soft);
    color: var(--color-text);
  }
  .pagefind-ui mark { background: var(--color-accent); color: var(--color-bg); }
  #search.compact { max-width: 18rem; }
  #search.full { max-width: 100%; }
</style>
