---
import Icon from '../Icon.astro';

interface Props {
  name: string;
  yield?: string;
  ingredients?: string[];
  steps: string[];
  // Link to the standalone syrups/ page; when set, the prep collapses into a drawer.
  href?: string;
}
const { name, yield: yieldText, ingredients, steps, href } = Astro.props;
const Wrap = href ? 'details' : Fragment;
---
<Wrap class:list={[href && 'house-made-drawer']}>
  {href ? (
    <summary><h2><Icon field="sections" slug="house-made" /> House-Made {name}</h2></summary>
  ) : (
    <h2><Icon field="sections" slug="house-made" /> House-Made {name}</h2>
  )}
  {yieldText && <p><em>{yieldText}</em></p>}
  {ingredients && ingredients.length > 0 && (
    <ul>
      {ingredients.map((item) => <li>{item}</li>)}
    </ul>
  )}
  {steps.length > 0 && (
    <ol>
      {steps.map((step) => <li>{step}</li>)}
    </ol>
  )}
  {href && <p><a href={href}>Full {name} page →</a></p>}
</Wrap>

<style>
  .house-made-drawer summary {
    cursor: pointer;
    list-style-position: outside;
  }
  .house-made-drawer summary h2 {
    display: inline;
  }
</style>
