---
import Icon from '../Icon.astro';

interface Props {
  name: string;
  yield?: string;
  ingredients?: string[];
  steps: string[];
}
const { name, yield: yieldText, ingredients, steps } = Astro.props;
---
<h2><Icon field="sections" slug="house-made" /> House-Made {name}</h2>
{yieldText && <p><em>{yieldText}</em></p>}
{ingredients && ingredients.length > 0 && (
  <ul>
    {ingredients.map((item) => <li>{item}</li>)}
  </ul>
)}
{steps.length > 0 && (
  <ol>
    {steps.map((step) => <li>{step}</li>)}
  </ol>
)}
