---
import Icon from '../Icon.astro';

interface Props {
  items: string[];
  garnish?: string;
  float?: string;
}
const { items, garnish, float: floatProp } = Astro.props;
---
<h2><Icon field="sections" slug="ingredients" /> Ingredients</h2>
<ul>
  {items.map((item) => <li>{item}</li>)}
</ul>
{garnish && <p><Icon field="sections" slug="garnish" class="inline-icon" /> <strong>Garnish:</strong> {garnish}</p>}
{floatProp && <p><Icon field="sections" slug="float" class="inline-icon" /> <strong>Float:</strong> {floatProp}</p>}
