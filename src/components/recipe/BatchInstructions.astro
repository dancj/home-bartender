---
import Icon from '../Icon.astro';
import { baseServings } from '../../lib/batchScale';

interface Props {
  yield: string;
  ingredients?: string[];
  instructions?: string;
}
const { yield: yieldText, ingredients, instructions } = Astro.props;
const paragraphs = instructions
  ? instructions.split(/\n\s*\n+/).map((p) => p.trim()).filter(Boolean)
  : [];
const base = baseServings(yieldText);
---
<h2><Icon field="sections" slug="batch" /> How to Batch It</h2>
<div data-batch-scaler={base ?? undefined}>
  {base && (
    <label class="batch-servings" hidden>
      Servings
      <input type="number" inputmode="numeric" min="1" max="99" step="1" value={base} />
    </label>
  )}
  <p><em data-original={yieldText}>{yieldText}</em></p>
  {ingredients && ingredients.length > 0 && (
    <ul>
      {ingredients.map((item) => <li data-original={item}>{item}</li>)}
    </ul>
  )}
</div>
{paragraphs.map((para) => <p>{para}</p>)}

<script>
  import { scaleLine, scaleYield } from '../../lib/batchScale';

  // Rewrite from data-original each time so repeated edits never compound rounding.
  for (const root of document.querySelectorAll<HTMLElement>('[data-batch-scaler]')) {
    const base = Number(root.dataset.batchScaler);
    const label = root.querySelector<HTMLElement>('.batch-servings');
    const input = label?.querySelector('input');
    if (!base || !label || !input) continue;
    label.hidden = false;
    input.addEventListener('input', () => {
      const n = Number(input.value);
      if (!Number.isInteger(n) || n < 1 || n > 99) return;
      for (const el of root.querySelectorAll<HTMLElement>('[data-original]')) {
        const original = el.dataset.original!;
        el.textContent = el.tagName === 'LI' ? scaleLine(original, n / base) : scaleYield(original, n);
      }
    });
  }
</script>

<style>
  .batch-servings {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-fg-subtle);
  }
  .batch-servings[hidden] {
    display: none;
  }
  .batch-servings input {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-fg);
    background: var(--color-surface);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.5rem;
    width: 4.5rem;
  }
  .batch-servings input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-ring);
    outline: none;
  }
</style>
