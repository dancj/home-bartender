---
import Icon from '../Icon.astro';

interface Props {
  yield: string;
  ingredients?: string[];
  instructions?: string;
}
const { yield: yieldText, ingredients, instructions } = Astro.props;
const paragraphs = instructions
  ? instructions.split(/\n\s*\n+/).map((p) => p.trim()).filter(Boolean)
  : [];
---
<h2><Icon field="sections" slug="batch" /> How to Batch It</h2>
<p><em>{yieldText}</em></p>
{ingredients && ingredients.length > 0 && (
  <ul>
    {ingredients.map((item) => <li>{item}</li>)}
  </ul>
)}
{paragraphs.map((para) => <p>{para}</p>)}
