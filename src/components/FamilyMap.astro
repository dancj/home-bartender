---
import type { Recipe } from '../lib/recipes';
import {
  buildFamilyMap,
  layoutFamilyMap,
  buildArrowSpecs,
  rootNodeId,
  branchNodeId,
  subNodeId,
} from '../lib/familyMap';
import { ROOT_NOTES } from '../lib/taxonomy';
import Icon from './Icon.astro';
import FlavorIcons from './FlavorIcons.astro';

interface Props {
  family: string;
  recipes: Recipe[];
}
const { family, recipes } = Astro.props;

const model = buildFamilyMap(recipes, family, import.meta.env.BASE_URL);
const layout = layoutFamilyMap(model);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const [, , vbW, vbH] = layout.viewBox.split(' ').map(Number);
// Position HTML nodes over the SVG by percentage of the viewBox so they track
// the connectors as the SVG scales responsively.
const pct = (n: number, total: number) => `${(n / total) * 100}%`;

// Ordered arrow descriptors for the scroll-arrows group; serialized onto the
// figure and consumed by the client script. Geometry comes from the live nodes.
const arrowSpecs = buildArrowSpecs(model);

const isEmpty = model.branches.length === 0;
// Non-empty roots have a /by-root/<slug>/ page; empty ones (Flip) do not.
const rootHref = isEmpty ? null : `${base}/by-root/${family}/`;
// Cocktail Codex template for this family — the distinguishing trait, shown
// under the root name.
const rootNote = ROOT_NOTES[family as keyof typeof ROOT_NOTES];
---

<figure
  class:list={['family-map', { 'is-empty': isEmpty }]}
  data-family={family}
  data-arrow-specs={JSON.stringify(arrowSpecs)}
  style={`--vb-w:${vbW};--vb-h:${vbH}`}
  role="group"
  aria-label={`${model.root.label} family map`}
>
  {/* Connectors are drawn by scroll-arrows on hydration (progressive enhancement);
      the relationships live in the labelled links below for the no-JS path. */}
  <div class="family-map-nodes">
    <div id={rootNodeId(family)} class="family-map-node is-root" style={`left:${pct(layout.root.x, vbW)};top:${pct(layout.root.y, vbH)}`}>
      {rootHref
        ? <a href={rootHref} class="family-map-node-inner"><Icon field="root" slug={family} class="family-map-glyph" /><span class="family-map-label">{model.root.label}</span>{rootNote && <span class="family-map-tagline">{rootNote}</span>}</a>
        : <span class="family-map-node-inner"><Icon field="root" slug={family} class="family-map-glyph" /><span class="family-map-label">{model.root.label}</span>{rootNote && <span class="family-map-tagline">{rootNote}</span>}</span>}
    </div>

    {layout.branches.map((branch) => (
      <>
        <a id={branchNodeId(family, branch.slug)} class="family-map-node" href={branch.url} style={`left:${pct(branch.x, vbW)};top:${pct(branch.y, vbH)}`}>
          <span class="family-map-label">
            {branch.title}
            {branch.deltaFlavors.length > 0 && (
              <span class="family-map-flavors" aria-hidden="true">
                <FlavorIcons slugs={branch.deltaFlavors} iconClass="family-map-flavor" />
              </span>
            )}
          </span>
        </a>
        {branch.subBranches.map((sub) => (
          <a
            id={subNodeId(family, branch.slug, sub.slug)}
            class="family-map-node is-sub"
            href={sub.url}
            style={`left:${pct(sub.x, vbW)};top:${pct(sub.y, vbH)}`}
            aria-label={`${sub.title}, related to ${branch.title}`}
          >
            <span class="family-map-label">
              {sub.title}
              {sub.deltaFlavors.length > 0 && (
                <span class="family-map-flavors" aria-hidden="true">
                  <FlavorIcons slugs={sub.deltaFlavors} iconClass="family-map-flavor" />
                </span>
              )}
            </span>
          </a>
        ))}
      </>
    ))}

    {isEmpty && (
      <p class="family-map-empty" style={`top:${pct(layout.root.y + 115, vbH)}`}>No recipes yet in this family.</p>
    )}
  </div>

</figure>

<style>
  .family-map {
    position: relative;
    width: 100%;
    margin: 0;
    /* viewBox aspect ratio reserves the canvas the absolutely-placed nodes sit
       in (and that scroll-arrows draws across). */
    aspect-ratio: var(--vb-w, 600) / var(--vb-h, 400);
  }

  .family-map-nodes {
    position: absolute;
    inset: 0;
  }
  .family-map-node {
    position: absolute;
    transform: translate(-50%, -50%);
    display: block;
    text-decoration: none;
  }
  .family-map-node .family-map-label,
  .family-map-node-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    background: var(--color-surface);
    border: 1px solid var(--color-rule-strong);
    border-radius: 999px;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.2;
    color: var(--color-fg);
    white-space: nowrap;
    transition: var(--transition-base);
  }
  .family-map-node.is-sub .family-map-label {
    font-size: 0.85rem;
    color: var(--color-fg-muted);
  }
  /* Hover + keyboard parity — SVG-area links don't inherit card styles. */
  .family-map-node:hover .family-map-label,
  .family-map-node:focus-visible .family-map-label {
    border-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: underline;
  }
  .family-map-node:focus-visible {
    outline: none;
  }
  .family-map-node:focus-visible .family-map-label {
    box-shadow: 0 0 0 3px var(--color-accent-ring);
  }

  .family-map-node.is-root {
    transform: translate(-50%, -50%);
  }
  .family-map-node.is-root .family-map-node-inner {
    flex-direction: column;
    padding: 0.7rem 1rem;
    background: var(--color-surface-muted);
    border-color: var(--color-rule-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }
  a.family-map-node-inner:hover,
  a.family-map-node-inner:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  /* The glyph span is rendered by the Icon child component, so it doesn't
     carry this component's scope hash — reach it with :global, scoped under
     .family-map (which is in this template). */
  .family-map :global(.family-map-glyph) {
    --icon-size: 64px;
    color: var(--color-accent);
  }

  /* Distinguishing-trait tagline under the root name (Cocktail Codex template). */
  .family-map-tagline {
    margin-top: 0.2rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0.01em;
    color: var(--color-fg-muted);
    white-space: normal;
    text-align: center;
    max-width: 18ch;
  }

  /* Delta-flavor icons: what this drink adds over its base. Tucked into the
     node pill after the title, muted so the recipe name stays primary. */
  .family-map-flavors {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-fg-subtle);
  }
  .family-map-flavors :global(.family-map-flavor) {
    --icon-size: 16px;
  }

  .family-map-empty {
    position: absolute;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    color: var(--color-fg-subtle);
    font-family: var(--font-serif);
    font-style: italic;
    text-align: center;
  }
  .family-map.is-empty .family-map-node.is-root .family-map-node-inner {
    opacity: 0.7;
  }

  /* The right-fanning SVG layout doesn't fit a phone — long pills anchored at
     62–82% of the viewBox overflow the right edge. Below 30rem, drop the
     absolute overlay and reflow the nodes into a left-aligned vertical tree:
     root on top, branches under it, sub-branches indented. Wires are decorative
     and hidden. Inline left/top styles go inert under position: static. */
  @media (max-width: 30rem) {
    .family-map {
      aspect-ratio: auto;
      height: auto;
      container-type: normal;
    }
    .family-map-empty {
      position: static;
      transform: none;
      left: auto;
      text-align: left;
    }
    .family-map-nodes {
      position: static;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .family-map-node,
    .family-map-node.is-root {
      position: static;
      transform: none;
      max-width: 100%;
    }
    .family-map-node.is-root {
      margin-bottom: 0.85rem;
    }
    .family-map-node.is-sub {
      margin-left: 1.5rem;
    }
    .family-map-label,
    .family-map-node-inner {
      font-size: 0.9rem;
      white-space: normal;
    }
    .family-map-node.is-sub .family-map-label {
      font-size: 0.82rem;
    }
    .family-map :global(.family-map-glyph) {
      --icon-size: 48px;
    }
    .family-map-flavors :global(.family-map-flavor) {
      --icon-size: 15px;
    }
  }
</style>

<script>
  import { scrollArrowGroup } from 'scroll-arrows';
  import type { ScrollArrowGroup, ScrollArrowOptions } from 'scroll-arrows';
  import type { ArrowSpec } from '../lib/familyMap';

  // One hand-drawn arrow group per root map. scroll-arrows owns all geometry,
  // reduced-motion handling (respectReducedMotion default true), and the
  // hidden-anchor redraw for tab panels. This DOM wiring is the untested seam,
  // per the repo's headerProgress convention; the spec logic lives in the
  // tested buildArrowSpecs.
  const groups = new Map<string, ScrollArrowGroup>();

  // The overlay <svg> mounts on <body>, so resolve the design token to a
  // concrete color rather than relying on var() resolving in that context.
  const stroke =
    getComputedStyle(document.documentElement)
      .getPropertyValue('--color-rule-strong')
      .trim() || '#cfc4ac';

  // Below this width the map reflows to a vertical stack — arrows off.
  const mq = window.matchMedia('(max-width: 30rem)');

  function specToArrow(s: ArrowSpec): ScrollArrowOptions {
    return {
      start: `#${s.startId}`,
      end: `#${s.endId}`,
      // Sketchy-curved look; sub-branch arrows read lighter and scratchier.
      roughness: s.sub ? 0.9 : 0.7,
      strokeWidth: s.sub ? 1.5 : 2.5,
      stroke,
      head: 'end',
      startSocketOffset: s.startSocketOffset,
    };
  }

  document.querySelectorAll<HTMLElement>('.family-map').forEach((fig) => {
    const family = fig.dataset.family;
    if (!family) return;

    let specs: ArrowSpec[];
    try {
      specs = JSON.parse(fig.dataset.arrowSpecs || '[]');
    } catch {
      return;
    }
    if (!specs.length) return; // empty root (Flip) — no arrows

    groups.set(
      family,
      scrollArrowGroup({
        arrows: specs.map(specToArrow),
        stagger: 1,
        scroll: { target: fig },
        enabled: !mq.matches,
      }),
    );
  });

  // Suspend/restore every group across the reflow breakpoint without teardown.
  mq.addEventListener('change', () => {
    for (const g of groups.values()) g.setEnabled(!mq.matches);
  });

  // Expose for the Roots tab handler (a separate component script): a panel
  // hidden with display:none has no box, so its arrows must be refreshed the
  // moment the tab reveals it.
  (window as unknown as { rootMapGroups?: Map<string, ScrollArrowGroup> }).rootMapGroups =
    groups;
</script>
