---
import type { Recipe } from '../lib/recipes';
import { buildFamilyMap, layoutFamilyMap } from '../lib/familyMap';
import Icon from './Icon.astro';
import FlavorIcons from './FlavorIcons.astro';

interface Props {
  family: string;
  recipes: Recipe[];
}
const { family, recipes } = Astro.props;

const model = buildFamilyMap(recipes, family, import.meta.env.BASE_URL);
const layout = layoutFamilyMap(model);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const [, , vbW, vbH] = layout.viewBox.split(' ').map(Number);
// Position HTML nodes over the SVG by percentage of the viewBox so they track
// the connectors as the SVG scales responsively.
const pct = (n: number, total: number) => `${(n / total) * 100}%`;

// Flat connector list with a running index that drives the draw stagger (U4).
let wireIndex = 0;
const wires = layout.branches.flatMap((branch) => [
  { d: branch.connector, sub: false, i: wireIndex++ },
  ...branch.subBranches.map((sub) => ({ d: sub.connector, sub: true, i: wireIndex++ })),
]);

const isEmpty = model.branches.length === 0;
// Non-empty roots have a /by-family/<slug>/ page; empty ones (Flip) do not.
const rootHref = isEmpty ? null : `${base}/by-family/${family}/`;
const arrowId = `arrow-${family}`;
const arrowSubId = `arrow-sub-${family}`;
---

<figure
  class:list={['family-map', { 'is-empty': isEmpty }]}
  data-family={family}
  style={`--vb-w:${vbW};--vb-h:${vbH}`}
  role="group"
  aria-label={`${model.root.label} family map`}
>
  {/* Connectors are decorative; the relationships live in the labelled links below. */}
  <svg
    class="family-map-wires"
    viewBox={layout.viewBox}
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
  >
    <defs>
      <marker id={arrowId} viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M1 1 L6 4 L1 7" class="family-map-arrowhead" />
      </marker>
      <marker id={arrowSubId} viewBox="0 0 8 8" refX="6" refY="4" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M1 1 L6 4 L1 7" class="family-map-arrowhead is-sub" />
      </marker>
    </defs>
    {wires.map((w) => (
      <path
        class:list={['family-map-wire', { 'is-sub': w.sub }]}
        style={`--i:${w.i}`}
        d={w.d}
        pathLength="1"
        marker-end={`url(#${w.sub ? arrowSubId : arrowId})`}
      />
    ))}
  </svg>

  <div class="family-map-nodes">
    <div class="family-map-node is-root" style={`left:${pct(layout.root.x, vbW)};top:${pct(layout.root.y, vbH)}`}>
      {rootHref
        ? <a href={rootHref} class="family-map-node-inner"><Icon field="family" slug={family} class="family-map-glyph" /><span class="family-map-label">{model.root.label}</span></a>
        : <span class="family-map-node-inner"><Icon field="family" slug={family} class="family-map-glyph" /><span class="family-map-label">{model.root.label}</span></span>}
    </div>

    {layout.branches.map((branch) => (
      <>
        <a class="family-map-node" href={branch.url} style={`left:${pct(branch.x, vbW)};top:${pct(branch.y, vbH)}`}>
          <span class="family-map-label">
            {branch.title}
            {branch.deltaFlavors.length > 0 && (
              <span class="family-map-flavors" aria-hidden="true">
                <FlavorIcons slugs={branch.deltaFlavors} iconClass="family-map-flavor" />
              </span>
            )}
          </span>
        </a>
        {branch.subBranches.map((sub) => (
          <a
            class="family-map-node is-sub"
            href={sub.url}
            style={`left:${pct(sub.x, vbW)};top:${pct(sub.y, vbH)}`}
            aria-label={`${sub.title}, related to ${branch.title}`}
          >
            <span class="family-map-label">
              {sub.title}
              {sub.deltaFlavors.length > 0 && (
                <span class="family-map-flavors" aria-hidden="true">
                  <FlavorIcons slugs={sub.deltaFlavors} iconClass="family-map-flavor" />
                </span>
              )}
            </span>
          </a>
        ))}
      </>
    ))}

    {isEmpty && (
      <p class="family-map-empty" style={`top:${pct(layout.root.y + 80, vbH)}`}>No recipes yet in this family.</p>
    )}
  </div>

</figure>

<style>
  .family-map {
    position: relative;
    width: 100%;
    margin: 0;
    /* Draw-on-scroll timing, chosen in the spike bake-off (U1). */
    --draw-dur: 1200ms;
    --draw-stagger: 200ms;
    /* viewBox aspect ratio keeps the node overlay aligned with the wires. */
    aspect-ratio: var(--vb-w, 600) / var(--vb-h, 400);
    /* Node pills are absolutely positioned over a scaling SVG; size them in
       container units so they shrink with the map on narrow viewports instead
       of overlapping the compressed anchor points. */
    container-type: inline-size;
  }
  .family-map-wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .family-map-wire {
    fill: none;
    stroke: var(--color-rule-strong);
    stroke-width: 2;
    stroke-linecap: round;
    /* pathLength="1" normalises every connector to a 0–1 dash range.
       Default offset 0 = fully drawn (no-JS / reduced-motion fallback). */
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .family-map-wire.is-sub {
    stroke-opacity: 0.5;
    stroke-width: 1.5;
  }

  /* Draw-on-scroll (U4): JS adds .is-armed (undrawn), then .is-drawn to
     transition the stroke in, staggered per connector by --i. */
  .family-map.is-armed .family-map-wire {
    stroke-dashoffset: 1;
  }
  .family-map.is-drawn .family-map-wire {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--draw-dur) ease-out;
    transition-delay: calc(var(--i) * var(--draw-stagger));
  }
  @media (prefers-reduced-motion: reduce) {
    .family-map .family-map-wire {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
  }
  .family-map-arrowhead {
    fill: none;
    stroke: var(--color-rule-strong);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .family-map-arrowhead.is-sub {
    stroke-opacity: 0.5;
  }

  .family-map-nodes {
    position: absolute;
    inset: 0;
  }
  .family-map-node {
    position: absolute;
    transform: translate(-50%, -50%);
    display: block;
    text-decoration: none;
  }
  .family-map-node .family-map-label,
  .family-map-node-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    background: var(--color-surface);
    border: 1px solid var(--color-rule-strong);
    border-radius: 999px;
    font-family: var(--font-serif);
    /* Scale with the map width (≈0.95rem at full size, smaller as it narrows)
       so pills don't overrun their anchors on a phone. */
    font-size: clamp(0.72rem, 2.6cqw, 0.95rem);
    line-height: 1.2;
    color: var(--color-fg);
    white-space: nowrap;
    transition: var(--transition-base);
  }
  .family-map-node.is-sub .family-map-label {
    font-size: clamp(0.66rem, 2.3cqw, 0.85rem);
    color: var(--color-fg-muted);
  }
  /* Hover + keyboard parity — SVG-area links don't inherit card styles. */
  .family-map-node:hover .family-map-label,
  .family-map-node:focus-visible .family-map-label {
    border-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: underline;
  }
  .family-map-node:focus-visible {
    outline: none;
  }
  .family-map-node:focus-visible .family-map-label {
    box-shadow: 0 0 0 3px var(--color-accent-ring);
  }

  .family-map-node.is-root {
    transform: translate(-50%, -50%);
  }
  .family-map-node.is-root .family-map-node-inner {
    flex-direction: column;
    padding: 0.7rem 1rem;
    background: var(--color-surface-muted);
    border-color: var(--color-rule-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }
  a.family-map-node-inner:hover,
  a.family-map-node-inner:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .family-map-glyph {
    --icon-size: clamp(40px, 9.5cqw, 56px);
    color: var(--color-accent);
  }

  /* Delta-flavor icons: what this drink adds over its base. Tucked into the
     node pill after the title, muted so the recipe name stays primary. */
  .family-map-flavors {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-fg-subtle);
  }
  .family-map-flavors :global(.family-map-flavor) {
    --icon-size: clamp(13px, 2.8cqw, 16px);
  }

  .family-map-empty {
    position: absolute;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    color: var(--color-fg-subtle);
    font-family: var(--font-serif);
    font-style: italic;
    text-align: center;
  }
  .family-map.is-empty .family-map-node.is-root .family-map-node-inner {
    opacity: 0.7;
  }

  /* The right-fanning SVG layout doesn't fit a phone — long pills anchored at
     62–82% of the viewBox overflow the right edge. Below 30rem, drop the
     absolute overlay and reflow the nodes into a left-aligned vertical tree:
     root on top, branches under it, sub-branches indented. Wires are decorative
     and hidden. Inline left/top styles go inert under position: static. */
  @media (max-width: 30rem) {
    .family-map {
      aspect-ratio: auto;
      height: auto;
      container-type: normal;
    }
    .family-map-wires {
      display: none;
    }
    .family-map-empty {
      position: static;
      transform: none;
      left: auto;
      text-align: left;
    }
    .family-map-nodes {
      position: static;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .family-map-node {
      position: static;
      transform: none;
      max-width: 100%;
    }
    .family-map-node.is-sub {
      margin-left: 1.5rem;
    }
    .family-map-label,
    .family-map-node-inner {
      font-size: 0.9rem;
      white-space: normal;
    }
    .family-map-node.is-sub .family-map-label {
      font-size: 0.82rem;
    }
    .family-map-glyph {
      --icon-size: 44px;
    }
    .family-map-flavors :global(.family-map-flavor) {
      --icon-size: 15px;
    }
  }
</style>

<script>
  import { shouldAnimate } from '../lib/familyMap';

  // shouldAnimate is the tested pure gate; the DOM wiring below stays here,
  // untested, per the repo's headerProgress seam.
  const animate = shouldAnimate({
    prefersReducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
    hasIntersectionObserver: 'IntersectionObserver' in window,
  });

  function draw(map: Element) {
    map.classList.add('is-armed');
    map.classList.remove('is-drawn');
    void (map as HTMLElement).offsetWidth; // reflow → paint the undrawn state
    map.classList.add('is-drawn');
  }

  if (animate) {
    // Redraw each time a map enters view. Hidden (display:none) maps don't
    // intersect, so a map drawn-in by U5's tab switch fires here on reveal —
    // no separate switch wiring needed. No unobserve: re-entry replays.
    // threshold 0 (any visibility) guarantees a tab-revealed map draws even if
    // partly below the fold — the active map sits at the top of the page, shown
    // via tabs rather than scrolled to, so an earlier trigger reads the same.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) draw(e.target);
    });
    document.querySelectorAll('.family-map').forEach((map) => io.observe(map));
  }
</script>
