---
import { iconUrl } from '../lib/icon-urls';

interface Props {
  field: string;
  slug: string;
  class?: string;
  /** Hover tooltip. When set, the icon is also exposed to AT via aria-label
      instead of being hidden. */
  title?: string;
}
const { field, slug, class: className, title } = Astro.props;
const url = iconUrl(field, slug);
---
{url && (
  <span
    class:list={['tax-icon', className]}
    style={`--icon-url: url("${url}")`}
    title={title}
    aria-label={title}
    aria-hidden={title ? undefined : 'true'}
  ></span>
)}
