---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { publishedRecipes } from '../../lib/recipes';
import { groupByTax, label } from '../../lib/taxonomy';
import Icon from '../../components/Icon.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { breadcrumbTrail } from '../../lib/breadcrumbs';

export async function getStaticPaths() {
  const recipes = await publishedRecipes();
  const grouped = groupByTax(recipes, 'flavors');
  return [...grouped].map(([flavor, items]) => ({
    params: { flavor },
    props: { flavor, items },
  }));
}

const { flavor, items } = Astro.props;
const displayName = label('flavor', flavor);
---
<BaseLayout
  title={`${displayName} cocktails — Home Bartender`}
  description={`${items.length} cocktails tagged ${displayName.toLowerCase()}.`}
  width="wide"
>
  <section class="page-head">
    <Breadcrumb segments={breadcrumbTrail('flavor', displayName)} />
    <h1><Icon field="flavor" slug={flavor} class="head-icon" /> {displayName}</h1>
    <p class="lede">{items.length} {items.length === 1 ? 'recipe' : 'recipes'}.</p>
  </section>
  <ul class="recipe-grid">
    {items
      .sort((a, b) => a.data.title.localeCompare(b.data.title))
      .map((r) => <RecipeCard recipe={r} />)}
  </ul>
</BaseLayout>
