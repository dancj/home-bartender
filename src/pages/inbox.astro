---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { unpublishedRecipes } from '../lib/recipes';

const recipes = (await unpublishedRecipes()).sort(
  (a, b) => (b.data.created?.getTime() ?? 0) - (a.data.created?.getTime() ?? 0)
);
---
<BaseLayout
  title="Inbox — Home Bartender"
  description="Pending recipes awaiting review."
  width="wide"
>
  <div id="inbox-gate" class="gate">
    <h1>Inbox</h1>
    <p>This page lists recipes pending review. They are not surfaced from the site index.</p>
    <p>Add <code>?preview=1</code> to the URL to view them.</p>
  </div>

  <div id="inbox-content" hidden>
    <section class="page-head">
      <p class="eyebrow">Drafts</p>
      <h1>Inbox <span class="count">({recipes.length})</span></h1>
      <p class="lede">
        Pending recipes — review, edit, then run <code>npm run publish &lt;slug&gt;</code>
        to move them out of <code>recipes/inbox/</code> and flip <code>publish: true</code>.
      </p>
    </section>
    <ul class="recipe-grid">
      {recipes.map((r) => <RecipeCard recipe={r} />)}
    </ul>
  </div>

  <script is:inline>
    if (new URLSearchParams(location.search).get('preview') === '1') {
      document.getElementById('inbox-gate').hidden = true;
      document.getElementById('inbox-content').hidden = false;
    }
  </script>
</BaseLayout>

<style>
  .gate {
    padding: 2.5rem 1.5rem;
    background: hsl(var(--surface));
    border: 1px solid hsl(var(--rule));
    border-radius: var(--radius-md);
    text-align: center;
    font-family: var(--font-sans);
  }
  .gate h1 {
    margin-bottom: 0.75rem;
  }
  .gate p {
    color: hsl(var(--fg-muted));
    margin-top: 0.5rem;
  }
  .count {
    color: hsl(var(--fg-muted));
    font-weight: 400;
    font-size: 0.7em;
    vertical-align: middle;
    margin-left: 0.25rem;
  }
</style>
