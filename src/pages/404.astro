---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import Search from '../components/Search.astro';

// Astro emits this as dist/404.html; GitHub Pages serves it for unknown paths.
// Dead links are routine here — the inbox→category publish flow renames slugs.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/`, label: 'All recipes' },
  { href: `${base}/roots/`, label: 'Roots' },
  { href: `${base}/learn/`, label: 'Learn' },
];
---
<BaseLayout title="Not found — Home Bartender" description="That page is off the menu.">
  <EmptyState
    title="This drink isn’t on the shelf."
    message="The page you’re after has moved or never existed. Search for it, or head back to the bar."
  >
    <nav class="notfound-links" aria-label="Browse">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    {/* Distinct id from the header search (BaseLayout) so both Pagefind
        instances mount without an element collision on this page. */}
    <div class="notfound-search">
      <Search mode="full" id="notfound-search" />
    </div>
  </EmptyState>
</BaseLayout>

<style>
  .notfound-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
  }
  .notfound-links a {
    display: inline-flex;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: border-color var(--transition-base), color var(--transition-base);
  }
  .notfound-links a:hover {
    border-color: var(--color-rule-strong);
    color: var(--color-fg);
  }
  .notfound-search {
    width: min(28rem, 100%);
  }
</style>
