---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { publishedRecipes } from '../../lib/recipes';
import { groupByTax, label } from '../../lib/taxonomy';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const recipes = await publishedRecipes();
  const grouped = groupByTax(recipes, 'spirits');
  return [...grouped].map(([spirit, items]) => ({
    params: { spirit },
    props: { spirit, items },
  }));
}

const { spirit, items } = Astro.props;
const displayName = label('spirits', spirit);
---
<BaseLayout
  title={`${displayName} cocktails — Home Bartender`}
  description={`${items.length} cocktails featuring ${displayName.toLowerCase()}.`}
  width="wide"
>
  <section class="page-head">
    <p class="eyebrow">By spirit</p>
    <h1><Icon field="spirits" slug={spirit} class="head-icon" /> {displayName}</h1>
    <p class="lede">{items.length} {items.length === 1 ? 'recipe' : 'recipes'}.</p>
  </section>
  <ul class="recipe-grid">
    {items
      .sort((a, b) => a.data.title.localeCompare(b.data.title))
      .map((r) => <RecipeCard recipe={r} />)}
  </ul>
</BaseLayout>
