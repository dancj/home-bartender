---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { publishedRecipes } from '../lib/recipes';
import { label } from '../lib/taxonomy';
import { spiritAccentVar } from '../lib/accents';

const recipes = (await publishedRecipes()).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const spirits = [...new Set(recipes.flatMap((r) => r.data.spirits))].sort();
---
<BaseLayout
  title="Home Bartending"
  description="Personal cocktail recipe collection."
  width="wide"
>
  {/* Toolbar: Filter and My Bar tabs (at most one open; a filter applies only
      while its tab is open, #268), then the result count and Cards/List icons. */}
  <div class="filter-bar-row">
    <div class="index-tabs" role="group" aria-label="Narrow the list">
      <button type="button" class="index-tab" data-tab="filter" aria-expanded="false" aria-controls="spirit-panel">
        Filter
      </button>
      <button type="button" class="index-tab" data-tab="bar" aria-expanded="false" aria-controls="my-bar-panel">
        My Bar
      </button>
    </div>

    <div class="filter-bar-right">
      <span class="result-count" id="result-count">Showing {recipes.length} recipes</span>
      <div class="segmented" role="group" aria-label="View density">
        <button type="button" class="segmented-btn" data-view="cards" aria-pressed="true" aria-label="Cards" title="Cards">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1" /><rect x="9" y="1.5" width="5.5" height="5.5" rx="1" /><rect x="1.5" y="9" width="5.5" height="5.5" rx="1" /><rect x="9" y="9" width="5.5" height="5.5" rx="1" /></svg>
        </button>
        <button type="button" class="segmented-btn" data-view="compact" aria-pressed="false" aria-label="List" title="List">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="2" rx="1" /><rect x="1.5" y="7" width="13" height="2" rx="1" /><rect x="1.5" y="11.5" width="13" height="2" rx="1" /></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="tab-panel" id="spirit-panel" hidden>
    <ul class="chip-row">
      {spirits.map((s) => (
        <li>
          <button
            type="button"
            class="chip filter-chip filter-chip--dot"
            data-filter="spirit"
            data-value={s}
            data-label={label('spirits', s)}
            aria-pressed="false"
            style={`--accent: ${spiritAccentVar(s)}`}
          >
            <span class="chip-dot" aria-hidden="true"></span> {label('spirits', s)}
          </button>
        </li>
      ))}
    </ul>
  </div>

  <div class="tab-panel" id="my-bar-panel" hidden>
    <p class="mybar-hint">Mark the spirits you own — the list shows what you can make. The selection sticks around.</p>
    <ul class="chip-row">
      {spirits.map((s) => (
        <li>
          <button type="button" class="chip chip-mybar" data-mybar={s} aria-pressed="false">
            {label('spirits', s)}
          </button>
        </li>
      ))}
    </ul>
    <button type="button" class="chip share-bar-btn" id="share-bar">Share bar</button>
  </div>

  <ul class="recipe-grid recipe-grid--photo" id="recipe-grid">
    {recipes.map((r) => <RecipeCard recipe={r} />)}
  </ul>

  <EmptyState id="empty-state" message="No recipes match the current filters." hidden />
  <EmptyState
    id="empty-state-mybar"
    message="Mark spirits in My Bar to see what you can make."
    hidden
  />

  <script>
    // Processed module (not is:inline) so the tested lib code IS the shipped
    // code. It's a deferred module, but so was the previous end-of-body
    // inline script; both run after the DOM is parsed.
    import {
      isMakeable,
      parseOwnedSpirits,
      hasVisibleOwned,
      parseBarParam,
      buildBarShareUrl,
      MY_BAR_STORAGE_KEY,
      indexTabFromFilters,
      toggleIndexTab,
      resultCountText,
      type IndexTab,
      normalizeIndexFilters,
    } from '../lib/myBar';
    import { compareCards, parseSortMode } from '../lib/indexSort';
    import { SPIRITS } from '../taxonomy.generated';

    const INDEX_VIEW_STORAGE_KEY = 'hb:index-view';

    (function () {
      const gridOrNull = document.getElementById('recipe-grid');
      if (!gridOrNull) return;
      const grid: HTMLElement = gridOrNull;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.recipe-card'));
      const emptyEl = document.getElementById('empty-state');
      const emptyMyBarEl = document.getElementById('empty-state-mybar');
      const resultCountEl = document.getElementById('result-count');
      const summary = document.querySelector('#filter-panel > summary');
      const tabButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('button[data-tab]')
      );
      // Which tab is expanded. UI state, seeded from the URL; Filter can be open
      // with no spirit picked, which the URL can't express.
      let openTab: IndexTab | null = null;
      const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('button[data-filter]')
      );
      const myBarButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('button[data-mybar]')
      );
      const clearBtn = document.getElementById('clear-filters');
      const sortSelect = document.getElementById('sort-select');
      const viewButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('button[data-view]')
      );

      // The filter rows' own axes — the active count and Clear button ignore
      // `makeable`, which lives in the separate My Bar bar.
      const PANEL_FIELDS = ['spirit'];
      const FIELDS = [...PANEL_FIELDS, 'makeable'];

      // localStorage can throw (private mode, disabled) — degrade to
      // session-only state rather than breaking the page.
      const storage = {
        get(key: string): string | null {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        },
        set(key: string, value: string) {
          try {
            localStorage.setItem(key, value);
          } catch {
            /* session-only fallback */
          }
        },
      };

      let owned: string[] = parseOwnedSpirits(storage.get(MY_BAR_STORAGE_KEY), SPIRITS);
      function writeOwned(next: string[]) {
        owned = next;
        storage.set(MY_BAR_STORAGE_KEY, JSON.stringify(next));
      }

      function replaceUrl(params: URLSearchParams) {
        const qs = params.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }

      // Shareable bar URL (issue #151): a valid ?bar= list replaces the stored
      // bar, then the param is stripped so a stale URL can't silently revert
      // later toggles on reload/back-forward. Runs before the first apply() so
      // the shared bar drives the initial makeable filtering.
      {
        const params = new URLSearchParams(location.search);
        const sharedBar = parseBarParam(params.get('bar'), SPIRITS);
        if (sharedBar) {
          writeOwned(sharedBar);
          params.delete('bar');
          replaceUrl(params);
        }
      }

      // Chips only render for spirits with a published recipe, while ownership
      // is stored against the whole taxonomy — so "owns nothing" and "owns
      // nothing you can see" are different questions. Every prompt that tells
      // the user to go mark a spirit must ask the visible one. Fixed for the
      // page's lifetime: the chip set is server-rendered.
      const shownSpirits = new Set(
        myBarButtons.map((b) => b.dataset.mybar ?? '').filter(Boolean)
      );

      function readFilters(): Record<string, string> {
        const params = new URLSearchParams(location.search);
        const f: Record<string, string> = {};
        for (const key of FIELDS) {
          const v = params.get(key);
          if (v) f[key] = v;
        }
        return normalizeIndexFilters(f);
      }

      // Merge-safe: seed from the current URL and touch only filter keys, so
      // non-filter params (?sort=) survive chip clicks and clear-filters.
      function writeFilters(filters: Record<string, string>) {
        const params = new URLSearchParams(location.search);
        for (const key of FIELDS) params.delete(key);
        for (const [k, v] of Object.entries(filters)) if (v) params.set(k, v);
        replaceUrl(params);
      }

      function readSort() {
        return parseSortMode(new URLSearchParams(location.search).get('sort'));
      }

      function writeSort(mode: string) {
        const params = new URLSearchParams(location.search);
        if (mode === 'title') params.delete('sort');
        else params.set('sort', mode);
        replaceUrl(params);
      }

      // Comma-list data attribute → array. "" must read as empty, not [""] —
      // the zero-spirit-makeable edge the lib tests enshrine.
      function dataList(v: string | undefined): string[] {
        return (v ?? '').split(',').filter(Boolean);
      }

      function cardMatches(
        card: HTMLElement,
        filters: Record<string, string>,
        ownedSet: Set<string>
      ): boolean {
        const ds = card.dataset;
        if (filters.spirit && !dataList(ds.spirits).includes(filters.spirit)) return false;
        if (filters.makeable && !isMakeable(dataList(ds.spirits), ownedSet)) return false;
        return true;
      }

      function applySort() {
        const mode = readSort();
        if (sortSelect instanceof HTMLSelectElement) sortSelect.value = mode;
        const record = (c: HTMLElement) => ({
          title: c.dataset.title ?? '',
          primarySpirit: dataList(c.dataset.spirits)[0] ?? '',
        });
        // appendChild moves in-place; hidden state is untouched by reordering.
        for (const c of [...cards].sort((a, b) => compareCards(record(a), record(b), mode)))
          grid.appendChild(c);
      }

      // Filtering never changes order — only init, ?sort= changes (select,
      // popstate) re-run applySort.
      function applyFilters(filters: Record<string, string> = readFilters()) {
        const ownedSet = new Set(owned);
        let visible = 0;
        for (const c of cards) {
          const show = cardMatches(c, filters, ownedSet);
          c.hidden = !show;
          if (show) visible++;
        }
        const myBarEmpty =
          Boolean(filters.makeable) && !hasVisibleOwned(owned, shownSpirits);
        if (emptyEl) emptyEl.hidden = visible > 0 || myBarEmpty;
        if (emptyMyBarEl) emptyMyBarEl.hidden = visible > 0 || !myBarEmpty;
        const active = PANEL_FIELDS.filter((k) => filters[k]).length;
        const picked = buttons.find((b) => b.dataset.value === filters.spirit);
        if (resultCountEl)
          resultCountEl.textContent = resultCountText(visible, filters, picked?.dataset.label);
        for (const b of buttons) {
          const key = b.dataset.filter ?? '';
          const on = filters[key] === b.dataset.value;
          b.classList.toggle('chip-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        for (const b of tabButtons) {
          const isOpen = b.dataset.tab === openTab;
          b.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          const panel = document.getElementById(b.getAttribute('aria-controls') ?? '');
          if (panel) panel.hidden = !isOpen;
        }
        for (const b of myBarButtons) {
          const on = owned.includes(b.dataset.mybar ?? '');
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        if (active > 0 && summary?.parentElement instanceof HTMLDetailsElement)
          summary.parentElement.open = true;
      }

      function apply() {
        applySort();
        const f = readFilters();
        writeFilters(f); // drops ?spirit= from a URL that also has ?makeable=1
        openTab = indexTabFromFilters(f);
        applyFilters(f);
      }

      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          const f = readFilters();
          const key = btn.dataset.filter ?? '';
          const val = btn.dataset.value ?? '';
          if (f[key] === val) delete f[key];
          else f[key] = val;
          writeFilters(f);
          applyFilters(f);
        });
      }
      for (const btn of tabButtons) {
        btn.addEventListener('click', () => {
          const next = toggleIndexTab(openTab, btn.dataset.tab === 'bar' ? 'bar' : 'filter');
          openTab = next.open;
          writeFilters(next.filters);
          applyFilters(next.filters);
        });
      }
      for (const btn of myBarButtons) {
        btn.addEventListener('click', () => {
          const slug = btn.dataset.mybar ?? '';
          writeOwned(
            owned.includes(slug) ? owned.filter((s) => s !== slug) : [...owned, slug]
          );
          applyFilters();
        });
      }

      // `owned` is read once at init and every toggle rewrites the whole array,
      // so without this a second open tab silently clobbers the first one's
      // toggles. The event fires only in *other* tabs, so there is no loop.
      // applyFilters re-derives chip aria-pressed and the owned count from
      // `owned`.
      window.addEventListener('storage', (e) => {
        // key is null when another tab calls localStorage.clear(); that wipes
        // ownership too, so it must not be filtered out with the view-mode key.
        if (e.key !== null && e.key !== MY_BAR_STORAGE_KEY) return;
        owned = parseOwnedSpirits(e.newValue, SPIRITS); // null newValue → []
        applyFilters();
      });
      const shareBtn = document.getElementById('share-bar');
      shareBtn?.addEventListener('click', () => {
        const flash = (text: string) => {
          shareBtn.textContent = text;
          setTimeout(() => (shareBtn.textContent = 'Share bar'), 1500);
        };
        // writeText rejects when the document is unfocused or permission is
        // denied — don't show false success.
        navigator.clipboard
          .writeText(buildBarShareUrl(location.href, owned))
          .then(() => flash('Copied'), () => flash('Copy failed'));
      });
      clearBtn?.addEventListener('click', () => {
        // Clear only the panel's axes; makeable belongs to the My Bar bar and
        // is preserved explicitly (writeFilters deletes all FIELDS keys, so
        // the makeable chip itself can still toggle its param off).
        const f = { makeable: readFilters().makeable ?? '' };
        writeFilters(f);
        applyFilters(f);
      });
      sortSelect?.addEventListener('change', () => {
        if (sortSelect instanceof HTMLSelectElement) {
          writeSort(sortSelect.value);
          applySort();
        }
      });

      // View density is a personal preference, not shareable state —
      // localStorage, not URL. Degrades to session-only when storage throws.
      function applyView(view: string) {
        const compact = view === 'compact';
        grid.classList.toggle('grid-compact', compact);
        for (const b of viewButtons) {
          const on = (b.dataset.view === 'compact') === compact;
          b.classList.toggle('chip-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
      }
      applyView(storage.get(INDEX_VIEW_STORAGE_KEY) === 'compact' ? 'compact' : 'cards');
      for (const btn of viewButtons) {
        btn.addEventListener('click', () => {
          const view = btn.dataset.view === 'compact' ? 'compact' : 'cards';
          applyView(view);
          storage.set(INDEX_VIEW_STORAGE_KEY, view);
        });
      }

      window.addEventListener('popstate', apply);
      apply();
    })();
  </script>
</BaseLayout>

<style>
  /* ── Single-line filter bar: spirit chips | Mood/Method dropdowns … count + view ── */
  .filter-bar-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 12px;
    margin-bottom: 26px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-rule);
  }
  /* Filter / My Bar folder tabs: they sit on the toolbar's bottom rule, and the
     open tab merges into its panel below (the rule is the panel's top edge). */
  .index-tabs {
    display: inline-flex;
    align-self: flex-end;
    gap: 6px;
    margin-bottom: -21px; /* row padding-bottom + 1px rule: tabs sit on the rule */
  }
  .index-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border: 1px solid var(--color-rule);
    border-bottom: none;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: transparent;
    color: var(--color-fg-muted);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }
  .index-tab::after {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    margin: -0.2rem 0 0 2px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 150ms ease;
  }
  .index-tab[aria-expanded='true'] {
    position: relative;
    background: var(--color-surface);
    color: var(--color-accent);
    box-shadow: 0 1px 0 var(--color-surface); /* covers the rule under the open tab */
  }
  .index-tab[aria-expanded='true']::after {
    margin-top: 0.2rem;
    transform: rotate(-135deg);
  }
  /* When the count/view controls wrap, put them above so the tabs stay on the rule. */
  @media (max-width: 640px) {
    .filter-bar-right {
      order: -1;
      width: 100%;
      justify-content: flex-end;
    }
  }
  .filter-bar-row:has(.index-tab[aria-expanded='true']) {
    margin-bottom: 0;
  }
  .tab-panel {
    margin: 0 0 26px;
    padding: 1rem;
    border: 1px solid var(--color-rule);
    border-top: none;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    background: var(--color-surface);
  }
  .chip-row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  /* Filter chip = the shared .chip primitive, sized to the handoff (13px text,
     7px/15px padding). Active state is inherited from .chip[aria-pressed]. */
  .filter-chip {
    padding: 7px 15px;
    font-size: 13px;
    gap: 7px;
  }
  .filter-bar-right {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .result-count {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-fg-subtle);
    white-space: nowrap;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Cards/List segmented pill (handoff): a rounded rail; the active segment
     takes the terracotta fill. Drives the same data-view toggle as before. */
  .segmented {
    display: inline-flex;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
    border-radius: 999px;
    padding: 2px;
  }
  .segmented-btn {
    border: none;
    background: transparent;
    color: var(--color-fg-muted);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    padding: 5px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }
  .segmented-btn svg {
    display: block;
    fill: currentColor;
  }
  .segmented-btn[aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }

  /* ── My Bar panel ───── */
  .share-bar-btn {
    margin-top: 0.75rem;
  }
  .mybar-hint {
    margin: 0 0 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-fg-subtle);
  }
  .chip-mybar[aria-pressed='true'] {
    background: var(--color-surface);
    color: var(--color-accent);
    border-color: var(--color-accent);
    font-weight: 600;
  }
  .chip-mybar[aria-pressed='true']::before {
    content: '✓';
    font-weight: 700;
  }

  /* ── Photo-card grid: wider min + gap than the shared .recipe-grid ─────── */
  .recipe-grid--photo {
    grid-template-columns: repeat(auto-fill, minmax(256px, 1fr));
    gap: 22px;
  }

  /* Compact (List) density: hide the card image, lay title + meta as a row.
     Card internals live in RecipeCard.astro, so use :global(). */
  .recipe-grid.grid-compact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .recipe-grid.grid-compact :global(.recipe-photo-card) {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    padding: 0.55rem 1rem;
  }
  .recipe-grid.grid-compact :global(.card-media) {
    display: none;
  }
  .recipe-grid.grid-compact :global(.card-body) {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    padding: 0;
    flex: 1;
  }
  .recipe-grid.grid-compact :global(.card-title) {
    font-size: 1.05rem;
  }
  .recipe-grid.grid-compact :global(.card-blurb) {
    display: none;
  }
  .recipe-grid.grid-compact :global(.recipe-card-meta) {
    margin-top: 0;
    margin-left: auto;
    padding-top: 0;
  }
</style>
