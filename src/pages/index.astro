---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { publishedRecipes } from '../lib/recipes';
import { label, groupByTax } from '../lib/taxonomy';

const recipes = (await publishedRecipes()).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const spirits = [...new Set(recipes.flatMap((r) => r.data.spirits))].sort();
const flavors = [...groupByTax(recipes, 'flavors').keys()];
const difficulties = ['easy', 'medium', 'advanced'];
const methods = ['shaken', 'stirred', 'built', 'blended'].filter((m) =>
  recipes.some((r) => r.data.method === m)
);
---
<BaseLayout
  title="Home Bartender"
  description="Personal cocktail recipe collection."
  width="wide"
>
  <section class="page-head">
    <p class="kicker eyebrow">Recipe collection</p>
    <h1>Home Bartender</h1>
    <p class="lede">
      {recipes.length} recipes across classics, originals, and seasonal experiments.
    </p>
  </section>

  <details class="filter-bar">
    <summary>
      <span class="filter-label">Filters</span>
      <span class="filter-count" id="filter-count"></span>
    </summary>
    <div class="filter-groups">
      <div class="filter-group">
        <h3 class="eyebrow">Spirit</h3>
        <ul>
          {spirits.map((s) => (
            <li>
              <button type="button" class="chip" data-filter="spirit" data-value={s}>
                {label('spirits', s)}
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="filter-group">
        <h3 class="eyebrow">Difficulty</h3>
        <ul>
          {difficulties.map((d) => (
            <li>
              <button type="button" class="chip" data-filter="difficulty" data-value={d}>
                {label('difficulty', d)}
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="filter-group">
        <h3 class="eyebrow">Method</h3>
        <ul>
          {methods.map((m) => (
            <li>
              <button type="button" class="chip" data-filter="method" data-value={m}>
                {label('method', m)}
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="filter-group">
        <h3 class="eyebrow">Flavor</h3>
        <ul>
          {flavors.map((f) => (
            <li>
              <button type="button" class="chip" data-filter="flavor" data-value={f}>
                {label('flavor', f)}
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <button type="button" id="clear-filters" class="clear-btn">Clear filters</button>
  </details>

  <ul class="recipe-grid" id="recipe-grid">
    {recipes.map((r) => <RecipeCard recipe={r} />)}
  </ul>

  <p id="empty-state" class="empty" hidden>No recipes match the current filters.</p>

  <script is:inline>
    (function () {
      const grid = document.getElementById('recipe-grid');
      const cards = Array.from(grid.querySelectorAll('.recipe-card'));
      const emptyEl = document.getElementById('empty-state');
      const countEl = document.getElementById('filter-count');
      const summary = document.querySelector('.filter-bar > summary');
      const buttons = Array.from(document.querySelectorAll('button[data-filter]'));
      const clearBtn = document.getElementById('clear-filters');

      const FIELDS = ['spirit', 'difficulty', 'method', 'flavor'];

      function readFilters() {
        const params = new URLSearchParams(location.search);
        const f = {};
        for (const key of FIELDS) {
          const v = params.get(key);
          if (v) f[key] = v;
        }
        return f;
      }

      function writeFilters(filters) {
        const params = new URLSearchParams();
        for (const [k, v] of Object.entries(filters)) if (v) params.set(k, v);
        const qs = params.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }

      function cardMatches(card, filters) {
        const ds = card.dataset;
        if (filters.spirit && !ds.spirits.split(',').includes(filters.spirit)) return false;
        if (filters.flavor && !ds.flavors.split(',').includes(filters.flavor)) return false;
        if (filters.method && ds.method !== filters.method) return false;
        if (filters.difficulty && ds.difficulty !== filters.difficulty) return false;
        return true;
      }

      function apply() {
        const filters = readFilters();
        let visible = 0;
        for (const c of cards) {
          const show = cardMatches(c, filters);
          c.hidden = !show;
          if (show) visible++;
        }
        emptyEl.hidden = visible > 0;
        const active = Object.keys(filters).length;
        countEl.textContent = active ? `${active} active · ${visible}/${cards.length}` : '';
        for (const b of buttons) {
          const on = filters[b.dataset.filter] === b.dataset.value;
          b.classList.toggle('chip-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        if (active > 0 && summary) summary.parentElement.open = true;
      }

      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          const f = readFilters();
          const key = btn.dataset.filter, val = btn.dataset.value;
          if (f[key] === val) delete f[key];
          else f[key] = val;
          writeFilters(f);
          apply();
        });
      }
      clearBtn.addEventListener('click', () => { writeFilters({}); apply(); });
      window.addEventListener('popstate', apply);
      apply();
    })();
  </script>
</BaseLayout>

<style>
  .kicker {
    margin: 0 0 0.5rem;
  }

  .filter-bar {
    margin-bottom: 2rem;
    border: 1px solid hsl(var(--rule));
    border-radius: var(--radius-md);
    background: hsl(var(--surface));
  }
  .filter-bar > summary {
    cursor: pointer;
    padding: 0.85rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: hsl(var(--fg));
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .filter-bar > summary::-webkit-details-marker { display: none; }
  .filter-bar > summary::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid hsl(var(--fg-muted));
    border-bottom: 1.5px solid hsl(var(--fg-muted));
    transform: rotate(-45deg);
    transition: transform 150ms ease;
    margin-right: 0.25rem;
  }
  .filter-bar[open] > summary::before {
    transform: rotate(45deg);
  }
  .filter-label {
    flex: 0 0 auto;
  }
  .filter-count {
    color: hsl(var(--fg-muted));
    font-weight: 400;
    font-size: 0.75rem;
  }

  .filter-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.5rem;
    padding: 0.5rem 1rem 1.25rem;
    border-top: 1px solid hsl(var(--rule));
  }
  .filter-group h3 {
    margin: 0 0 0.65rem;
  }
  .filter-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .filter-group button {
    text-transform: capitalize;
  }

  .clear-btn {
    display: block;
    margin: 0 1rem 1rem auto;
    background: none;
    border: none;
    color: hsl(var(--fg-muted));
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-decoration: underline;
    text-decoration-color: hsl(var(--rule));
    text-underline-offset: 2px;
    cursor: pointer;
    padding: 0;
  }
  .clear-btn:hover {
    color: hsl(var(--fg));
  }

  .empty {
    text-align: center;
    color: hsl(var(--fg-muted));
    font-style: italic;
    font-family: var(--font-serif);
    padding: 3rem 1rem;
  }
</style>
