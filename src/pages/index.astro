---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { publishedRecipes } from '../lib/recipes';
import { label, groupByTax } from '../lib/taxonomy';
import Icon from '../components/Icon.astro';

const recipes = (await publishedRecipes()).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const spirits = [...new Set(recipes.flatMap((r) => r.data.spirits))].sort();
const flavors = [...groupByTax(recipes, 'flavors').keys()];
const difficulties = ['easy', 'medium', 'advanced'];
const methods = ['shaken', 'stirred', 'built', 'blended'].filter((m) =>
  recipes.some((r) => r.data.method === m)
);
---
<BaseLayout
  title="Home Bartending"
  description="Personal cocktail recipe collection."
  width="wide"
>
  <details class="filter-bar" id="filter-panel">
    <summary>
      <span class="filter-label">Filters</span>
      <span class="filter-count" id="filter-count"></span>
    </summary>
    <div class="filter-groups">
      <div class="filter-group">
        <h3 class="eyebrow">Spirit</h3>
        <ul>
          {spirits.map((s) => (
            <li>
              <button type="button" class="chip" data-filter="spirit" data-value={s}>
                <Icon field="spirits" slug={s} /> {label('spirits', s)}
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="filter-group">
        <h3 class="eyebrow">Difficulty</h3>
        <ul>
          {difficulties.map((d) => (
            <li>
              <button type="button" class="chip" data-filter="difficulty" data-value={d}>
                <Icon field="difficulty" slug={d} /> {label('difficulty', d)}
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="filter-group">
        <h3 class="eyebrow">Method</h3>
        <ul>
          {methods.map((m) => (
            <li>
              <button type="button" class="chip" data-filter="method" data-value={m}>
                <Icon field="method" slug={m} /> {label('method', m)}
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="filter-group">
        <h3 class="eyebrow">Flavor</h3>
        <ul>
          {flavors.map((f) => (
            <li>
              <button type="button" class="chip" data-filter="flavor" data-value={f}>
                <Icon field="flavor" slug={f} /> {label('flavor', f)}
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <button type="button" id="clear-filters" class="clear-btn">Clear filters</button>
  </details>

  <div class="my-bar-wrap">
    <details class="filter-bar my-bar" id="my-bar">
      <summary>
        <span class="filter-label">My Bar</span>
        <span class="filter-count" id="mybar-count"></span>
      </summary>
      <div class="mybar-body">
        <p class="mybar-hint">Mark the spirits you own — the selection sticks around.</p>
        <ul>
          {spirits.map((s) => (
            <li>
              <button type="button" class="chip chip-mybar" data-mybar={s} aria-pressed="false">
                <Icon field="spirits" slug={s} /> {label('spirits', s)}
              </button>
            </li>
          ))}
        </ul>
      </div>
    </details>
    <button type="button" class="chip chip-makeable" data-filter="makeable" data-value="1">
      What can I make?
    </button>
  </div>

  <div class="grid-toolbar">
    <label class="eyebrow sort-label" for="sort-select">Sort by</label>
    <select id="sort-select" class="sort-select">
      <option value="title">Title A–Z</option>
      <option value="spirit">Spirit</option>
      <option value="difficulty">Difficulty</option>
    </select>
    <div class="view-toggle" role="group" aria-label="View density">
      <button type="button" class="chip" data-view="cards" aria-pressed="true">Cards</button>
      <button type="button" class="chip" data-view="compact" aria-pressed="false">List</button>
    </div>
  </div>

  <ul class="recipe-grid" id="recipe-grid">
    {recipes.map((r) => <RecipeCard recipe={r} />)}
  </ul>

  <EmptyState id="empty-state" message="No recipes match the current filters." hidden />
  <EmptyState
    id="empty-state-mybar"
    message="Mark spirits in My Bar to see what you can make."
    hidden
  />

  <script>
    // Processed module (not is:inline) so the tested lib code IS the shipped
    // code. It's a deferred module, but so was the previous end-of-body
    // inline script; both run after the DOM is parsed.
    import {
      isMakeable,
      parseOwnedSpirits,
      hasVisibleOwned,
      MY_BAR_STORAGE_KEY,
    } from '../lib/myBar';
    import { compareCards, parseSortMode } from '../lib/indexSort';
    import { SPIRITS } from '../taxonomy.generated';

    const INDEX_VIEW_STORAGE_KEY = 'hb:index-view';

    (function () {
      const gridOrNull = document.getElementById('recipe-grid');
      if (!gridOrNull) return;
      const grid: HTMLElement = gridOrNull;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.recipe-card'));
      const emptyEl = document.getElementById('empty-state');
      const emptyMyBarEl = document.getElementById('empty-state-mybar');
      const countEl = document.getElementById('filter-count');
      const summary = document.querySelector('#filter-panel > summary');
      const myBarEl = document.getElementById('my-bar');
      const myBarCountEl = document.getElementById('mybar-count');
      const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('button[data-filter]')
      );
      const myBarButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('button[data-mybar]')
      );
      const clearBtn = document.getElementById('clear-filters');
      const sortSelect = document.getElementById('sort-select');
      const viewButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('button[data-view]')
      );

      // The Filters panel's own axes — its count, auto-open, and Clear button
      // ignore `makeable`, which lives in the separate My Bar bar.
      const PANEL_FIELDS = ['spirit', 'difficulty', 'method', 'flavor'];
      const FIELDS = [...PANEL_FIELDS, 'makeable'];

      // localStorage can throw (private mode, disabled) — degrade to
      // session-only state rather than breaking the page.
      const storage = {
        get(key: string): string | null {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        },
        set(key: string, value: string) {
          try {
            localStorage.setItem(key, value);
          } catch {
            /* session-only fallback */
          }
        },
      };

      let owned: string[] = parseOwnedSpirits(storage.get(MY_BAR_STORAGE_KEY), SPIRITS);
      function writeOwned(next: string[]) {
        owned = next;
        storage.set(MY_BAR_STORAGE_KEY, JSON.stringify(next));
      }

      // Chips only render for spirits with a published recipe, while ownership
      // is stored against the whole taxonomy — so "owns nothing" and "owns
      // nothing you can see" are different questions. Every prompt that tells
      // the user to go mark a spirit must ask the visible one. Fixed for the
      // page's lifetime: the chip set is server-rendered.
      const shownSpirits = new Set(
        myBarButtons.map((b) => b.dataset.mybar ?? '').filter(Boolean)
      );

      function readFilters(): Record<string, string> {
        const params = new URLSearchParams(location.search);
        const f: Record<string, string> = {};
        for (const key of FIELDS) {
          const v = params.get(key);
          if (v) f[key] = v;
        }
        return f;
      }

      // Merge-safe: seed from the current URL and touch only filter keys, so
      // non-filter params (?sort=) survive chip clicks and clear-filters.
      function writeFilters(filters: Record<string, string>) {
        const params = new URLSearchParams(location.search);
        for (const key of FIELDS) params.delete(key);
        for (const [k, v] of Object.entries(filters)) if (v) params.set(k, v);
        const qs = params.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }

      function readSort() {
        return parseSortMode(new URLSearchParams(location.search).get('sort'));
      }

      function writeSort(mode: string) {
        const params = new URLSearchParams(location.search);
        if (mode === 'title') params.delete('sort');
        else params.set('sort', mode);
        const qs = params.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }

      // Comma-list data attribute → array. "" must read as empty, not [""] —
      // the zero-spirit-makeable edge the lib tests enshrine.
      function dataList(v: string | undefined): string[] {
        return (v ?? '').split(',').filter(Boolean);
      }

      function cardMatches(
        card: HTMLElement,
        filters: Record<string, string>,
        ownedSet: Set<string>
      ): boolean {
        const ds = card.dataset;
        if (filters.spirit && !dataList(ds.spirits).includes(filters.spirit)) return false;
        if (filters.flavor && !dataList(ds.flavors).includes(filters.flavor)) return false;
        if (filters.method && ds.method !== filters.method) return false;
        if (filters.difficulty && ds.difficulty !== filters.difficulty) return false;
        if (filters.makeable && !isMakeable(dataList(ds.spirits), ownedSet)) return false;
        return true;
      }

      function applySort() {
        const mode = readSort();
        if (sortSelect instanceof HTMLSelectElement) sortSelect.value = mode;
        const record = (c: HTMLElement) => ({
          title: c.dataset.title ?? '',
          primarySpirit: dataList(c.dataset.spirits)[0] ?? '',
          difficulty: c.dataset.difficulty ?? '',
        });
        // appendChild moves in-place; hidden state is untouched by reordering.
        for (const c of [...cards].sort((a, b) => compareCards(record(a), record(b), mode)))
          grid.appendChild(c);
      }

      // Filtering never changes order — only init, ?sort= changes (select,
      // popstate) re-run applySort.
      function applyFilters(filters: Record<string, string> = readFilters()) {
        const ownedSet = new Set(owned);
        let visible = 0;
        for (const c of cards) {
          const show = cardMatches(c, filters, ownedSet);
          c.hidden = !show;
          if (show) visible++;
        }
        const myBarEmpty =
          Boolean(filters.makeable) && !hasVisibleOwned(owned, shownSpirits);
        if (emptyEl) emptyEl.hidden = visible > 0 || myBarEmpty;
        if (emptyMyBarEl) emptyMyBarEl.hidden = visible > 0 || !myBarEmpty;
        const active = PANEL_FIELDS.filter((k) => filters[k]).length;
        if (countEl)
          countEl.textContent = active ? `${active} active · ${visible}/${cards.length}` : '';
        for (const b of buttons) {
          const key = b.dataset.filter ?? '';
          const on = filters[key] === b.dataset.value;
          b.classList.toggle('chip-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        for (const b of myBarButtons) {
          const on = owned.includes(b.dataset.mybar ?? '');
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        if (myBarCountEl)
          myBarCountEl.textContent = owned.length ? `${owned.length} owned` : '';
        if (active > 0 && summary?.parentElement instanceof HTMLDetailsElement)
          summary.parentElement.open = true;
      }

      // The empty state says "Mark spirits in My Bar" — make sure the marking
      // UI is actually visible whenever that state is reachable: on load, on a
      // makeable click with nothing owned, and when the last spirit is unowned.
      function maybeRevealMyBar(filters: Record<string, string> = readFilters()) {
        if (
          filters.makeable &&
          !hasVisibleOwned(owned, shownSpirits) &&
          myBarEl instanceof HTMLDetailsElement
        )
          myBarEl.open = true;
      }

      function apply() {
        applySort();
        const f = readFilters();
        applyFilters(f);
        maybeRevealMyBar(f); // covers initial load and popstate into ?makeable=1
      }

      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          const f = readFilters();
          const key = btn.dataset.filter ?? '';
          const val = btn.dataset.value ?? '';
          if (f[key] === val) delete f[key];
          else f[key] = val;
          writeFilters(f);
          applyFilters(f);
          if (key === 'makeable' && f[key]) maybeRevealMyBar(f);
        });
      }
      for (const btn of myBarButtons) {
        btn.addEventListener('click', () => {
          const slug = btn.dataset.mybar ?? '';
          writeOwned(
            owned.includes(slug) ? owned.filter((s) => s !== slug) : [...owned, slug]
          );
          const f = readFilters();
          applyFilters(f);
          maybeRevealMyBar(f);
        });
      }

      // `owned` is read once at init and every toggle rewrites the whole array,
      // so without this a second open tab silently clobbers the first one's
      // toggles. The event fires only in *other* tabs, so there is no loop.
      // applyFilters re-derives chip aria-pressed and the owned count from
      // `owned`; maybeRevealMyBar has to run alongside it for the same reason
      // the local toggle path runs both — dropping the last visible spirit in
      // another tab surfaces "mark spirits in My Bar" here, and that message
      // must not point at a collapsed drawer.
      window.addEventListener('storage', (e) => {
        // key is null when another tab calls localStorage.clear(); that wipes
        // ownership too, so it must not be filtered out with the view-mode key.
        if (e.key !== null && e.key !== MY_BAR_STORAGE_KEY) return;
        owned = parseOwnedSpirits(e.newValue, SPIRITS); // null newValue → []
        const f = readFilters();
        applyFilters(f);
        maybeRevealMyBar(f);
      });
      clearBtn?.addEventListener('click', () => {
        // Clear only the panel's axes; makeable belongs to the My Bar bar and
        // is preserved explicitly (writeFilters deletes all FIELDS keys, so
        // the makeable chip itself can still toggle its param off).
        const f = { makeable: readFilters().makeable ?? '' };
        writeFilters(f);
        applyFilters(f);
      });
      sortSelect?.addEventListener('change', () => {
        if (sortSelect instanceof HTMLSelectElement) {
          writeSort(sortSelect.value);
          applySort();
        }
      });

      // View density is a personal preference, not shareable state —
      // localStorage, not URL. Degrades to session-only when storage throws.
      function applyView(view: string) {
        const compact = view === 'compact';
        grid.classList.toggle('grid-compact', compact);
        for (const b of viewButtons) {
          const on = (b.dataset.view === 'compact') === compact;
          b.classList.toggle('chip-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
      }
      applyView(storage.get(INDEX_VIEW_STORAGE_KEY) === 'compact' ? 'compact' : 'cards');
      for (const btn of viewButtons) {
        btn.addEventListener('click', () => {
          const view = btn.dataset.view === 'compact' ? 'compact' : 'cards';
          applyView(view);
          storage.set(INDEX_VIEW_STORAGE_KEY, view);
        });
      }

      window.addEventListener('popstate', apply);
      apply();
    })();
  </script>
</BaseLayout>

<style>
  .kicker {
    margin: 0 0 0.5rem;
  }

  .filter-bar {
    margin-bottom: 2rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .filter-bar > summary {
    cursor: pointer;
    padding: 0.85rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-fg);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .filter-bar > summary::-webkit-details-marker { display: none; }
  .filter-bar > summary::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid var(--color-fg-muted);
    border-bottom: 1.5px solid var(--color-fg-muted);
    transform: rotate(-45deg);
    transition: transform 150ms ease;
    margin-right: 0.25rem;
  }
  .filter-bar[open] > summary::before {
    transform: rotate(45deg);
  }
  .filter-label {
    flex: 0 0 auto;
  }
  .filter-count {
    color: var(--color-fg-muted);
    font-weight: 400;
    font-size: 0.75rem;
  }

  .filter-groups,
  .mybar-body {
    padding: 0.5rem 1rem 1.25rem;
    border-top: 1px solid var(--color-rule);
  }
  .filter-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.5rem;
  }
  .filter-group h3 {
    margin: 0 0 0.65rem;
  }
  .filter-group ul,
  .mybar-body ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .filter-group button {
    text-transform: capitalize;
  }

  .clear-btn {
    display: block;
    margin: 0 1rem 1rem auto;
    background: none;
    border: none;
    color: var(--color-fg-muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 2px;
    cursor: pointer;
    padding: 0;
  }
  .clear-btn:hover {
    color: var(--color-fg);
  }

  /* My Bar: persistent ownership, not a transient filter — owned chips get an
     outlined check treatment distinct from the filled accent filter chips. */
  .mybar-hint {
    margin: -0.35rem 0 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-fg-subtle);
  }
  .chip-mybar[aria-pressed='true'] {
    background: var(--color-surface);
    color: var(--color-accent);
    border-color: var(--color-accent);
    font-weight: 600;
  }
  .chip-mybar[aria-pressed='true']::before {
    content: '✓';
    font-weight: 700;
  }
  /* Standalone My Bar bar. The makeable chip renders in the header row but is
     a sibling of the <details> (positioned via the wrapper), so it stays
     visible/clickable while collapsed and out of the disclosure's accessible
     name — no interactive-inside-interactive nesting. */
  .my-bar-wrap {
    position: relative;
  }
  .my-bar > summary {
    padding-right: 11.5rem;
  }
  .chip-makeable {
    position: absolute;
    top: 0.55rem;
    right: 1rem;
  }

  /* Toolbar: sort + view density controls above the grid */
  .grid-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .sort-label {
    margin: 0;
  }
  .sort-select {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-fg);
  }
  .view-toggle {
    margin-left: auto;
    display: inline-flex;
    gap: 0.35rem;
  }

  /* Compact density: single-column rows, blurb hidden. Card internals live in
     RecipeCard.astro, so descendant selectors need :global(). */
  .recipe-grid.grid-compact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .recipe-grid.grid-compact :global(.card) {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    padding: 0.55rem 1rem;
  }
  .recipe-grid.grid-compact :global(.card h2) {
    font-size: 1.05rem;
  }
  .recipe-grid.grid-compact :global(.card-blurb) {
    display: none;
  }
  .recipe-grid.grid-compact :global(.recipe-card-meta) {
    margin-top: 0;
    margin-left: auto;
  }
</style>
