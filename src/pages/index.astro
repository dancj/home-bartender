---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { publishedRecipes } from '../lib/recipes';
import { label, groupByTax } from '../lib/taxonomy';
import Icon from '../components/Icon.astro';

const recipes = (await publishedRecipes()).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const spirits = [...new Set(recipes.flatMap((r) => r.data.spirits))].sort();
const flavors = [...groupByTax(recipes, 'flavors').keys()];
const difficulties = ['easy', 'medium', 'advanced'];
const methods = ['shaken', 'stirred', 'built', 'blended'].filter((m) =>
  recipes.some((r) => r.data.method === m)
);
---
<BaseLayout
  title="Home Bartender"
  description="Personal cocktail recipe collection."
  width="wide"
>
  <details class="filter-bar">
    <summary>
      <span class="filter-label">Filters</span>
      <span class="filter-count" id="filter-count"></span>
    </summary>
    <div class="filter-groups">
      <div class="filter-group">
        <h3 class="eyebrow">Spirit</h3>
        <ul>
          {spirits.map((s) => (
            <li>
              <button type="button" class="chip" data-filter="spirit" data-value={s}>
                <Icon field="spirits" slug={s} /> {label('spirits', s)}
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="filter-group">
        <h3 class="eyebrow">Difficulty</h3>
        <ul>
          {difficulties.map((d) => (
            <li>
              <button type="button" class="chip" data-filter="difficulty" data-value={d}>
                <Icon field="difficulty" slug={d} /> {label('difficulty', d)}
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="filter-group">
        <h3 class="eyebrow">Method</h3>
        <ul>
          {methods.map((m) => (
            <li>
              <button type="button" class="chip" data-filter="method" data-value={m}>
                <Icon field="method" slug={m} /> {label('method', m)}
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="filter-group">
        <h3 class="eyebrow">Flavor</h3>
        <ul>
          {flavors.map((f) => (
            <li>
              <button type="button" class="chip" data-filter="flavor" data-value={f}>
                <Icon field="flavor" slug={f} /> {label('flavor', f)}
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="filter-group filter-group-mybar">
        <h3 class="eyebrow">My Bar</h3>
        <p class="mybar-hint">Mark the spirits you own — the selection sticks around.</p>
        <ul>
          {spirits.map((s) => (
            <li>
              <button type="button" class="chip chip-mybar" data-mybar={s} aria-pressed="false">
                <Icon field="spirits" slug={s} /> {label('spirits', s)}
              </button>
            </li>
          ))}
        </ul>
        <button type="button" class="chip chip-makeable" data-filter="makeable" data-value="1">
          What can I make?
        </button>
      </div>
    </div>
    <button type="button" id="clear-filters" class="clear-btn">Clear filters</button>
  </details>

  <ul class="recipe-grid" id="recipe-grid">
    {recipes.map((r) => <RecipeCard recipe={r} />)}
  </ul>

  <EmptyState id="empty-state" message="No recipes match the current filters." hidden />
  <EmptyState
    id="empty-state-mybar"
    message="Mark spirits in My Bar to see what you can make."
    hidden
  />

  <script>
    // Processed module (not is:inline) so the tested lib code IS the shipped
    // code — see plan KTD3. It's a deferred module, but so was the previous
    // end-of-body inline script; both run after the DOM is parsed.
    import { isMakeable, parseOwnedSpirits, MY_BAR_STORAGE_KEY } from '../lib/myBar';
    import { SPIRITS } from '../taxonomy.generated';

    (function () {
      const grid = document.getElementById('recipe-grid');
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.recipe-card'));
      const emptyEl = document.getElementById('empty-state');
      const emptyMyBarEl = document.getElementById('empty-state-mybar');
      const countEl = document.getElementById('filter-count');
      const summary = document.querySelector('.filter-bar > summary');
      const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('button[data-filter]')
      );
      const myBarButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('button[data-mybar]')
      );
      const clearBtn = document.getElementById('clear-filters');

      const FIELDS = ['spirit', 'difficulty', 'method', 'flavor', 'makeable'];

      // localStorage can throw (private mode, disabled) — degrade to
      // session-only ownership rather than breaking the page.
      function readOwned(): string[] {
        try {
          return parseOwnedSpirits(localStorage.getItem(MY_BAR_STORAGE_KEY), SPIRITS);
        } catch {
          return owned;
        }
      }
      function writeOwned(next: string[]) {
        owned = next;
        try {
          localStorage.setItem(MY_BAR_STORAGE_KEY, JSON.stringify(next));
        } catch {
          /* session-only fallback */
        }
      }
      let owned: string[] = [];
      owned = readOwned();

      function readFilters(): Record<string, string> {
        const params = new URLSearchParams(location.search);
        const f: Record<string, string> = {};
        for (const key of FIELDS) {
          const v = params.get(key);
          if (v) f[key] = v;
        }
        return f;
      }

      function writeFilters(filters: Record<string, string>) {
        const params = new URLSearchParams();
        for (const [k, v] of Object.entries(filters)) if (v) params.set(k, v);
        const qs = params.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }

      // data-spirits="" must read as "no spirits required", not [""] — the
      // zero-spirit-makeable edge the lib tests enshrine.
      function cardSpirits(card: HTMLElement): string[] {
        return (card.dataset.spirits ?? '').split(',').filter(Boolean);
      }

      function cardMatches(card: HTMLElement, filters: Record<string, string>): boolean {
        const ds = card.dataset;
        if (filters.spirit && !cardSpirits(card).includes(filters.spirit)) return false;
        if (filters.flavor && !(ds.flavors ?? '').split(',').includes(filters.flavor))
          return false;
        if (filters.method && ds.method !== filters.method) return false;
        if (filters.difficulty && ds.difficulty !== filters.difficulty) return false;
        if (filters.makeable && !isMakeable(cardSpirits(card), owned)) return false;
        return true;
      }

      function apply() {
        const filters = readFilters();
        let visible = 0;
        for (const c of cards) {
          const show = cardMatches(c, filters);
          c.hidden = !show;
          if (show) visible++;
        }
        const myBarEmpty = Boolean(filters.makeable) && owned.length === 0;
        if (emptyEl) emptyEl.hidden = visible > 0 || myBarEmpty;
        if (emptyMyBarEl) emptyMyBarEl.hidden = visible > 0 || !myBarEmpty;
        const active = Object.keys(filters).length;
        if (countEl)
          countEl.textContent = active ? `${active} active · ${visible}/${cards.length}` : '';
        for (const b of buttons) {
          const key = b.dataset.filter ?? '';
          const on = filters[key] === b.dataset.value;
          b.classList.toggle('chip-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        for (const b of myBarButtons) {
          const on = owned.includes(b.dataset.mybar ?? '');
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        if (active > 0 && summary?.parentElement instanceof HTMLDetailsElement)
          summary.parentElement.open = true;
      }

      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          const f = readFilters();
          const key = btn.dataset.filter ?? '';
          const val = btn.dataset.value ?? '';
          if (f[key] === val) delete f[key];
          else f[key] = val;
          writeFilters(f);
          apply();
        });
      }
      for (const btn of myBarButtons) {
        btn.addEventListener('click', () => {
          const slug = btn.dataset.mybar ?? '';
          writeOwned(
            owned.includes(slug) ? owned.filter((s) => s !== slug) : [...owned, slug]
          );
          apply();
        });
      }
      clearBtn?.addEventListener('click', () => {
        writeFilters({});
        apply();
      });
      window.addEventListener('popstate', apply);
      apply();
    })();
  </script>
</BaseLayout>

<style>
  .kicker {
    margin: 0 0 0.5rem;
  }

  .filter-bar {
    margin-bottom: 2rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .filter-bar > summary {
    cursor: pointer;
    padding: 0.85rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-fg);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .filter-bar > summary::-webkit-details-marker { display: none; }
  .filter-bar > summary::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid var(--color-fg-muted);
    border-bottom: 1.5px solid var(--color-fg-muted);
    transform: rotate(-45deg);
    transition: transform 150ms ease;
    margin-right: 0.25rem;
  }
  .filter-bar[open] > summary::before {
    transform: rotate(45deg);
  }
  .filter-label {
    flex: 0 0 auto;
  }
  .filter-count {
    color: var(--color-fg-muted);
    font-weight: 400;
    font-size: 0.75rem;
  }

  .filter-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.5rem;
    padding: 0.5rem 1rem 1.25rem;
    border-top: 1px solid var(--color-rule);
  }
  .filter-group h3 {
    margin: 0 0 0.65rem;
  }
  .filter-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .filter-group button {
    text-transform: capitalize;
  }

  .clear-btn {
    display: block;
    margin: 0 1rem 1rem auto;
    background: none;
    border: none;
    color: var(--color-fg-muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 2px;
    cursor: pointer;
    padding: 0;
  }
  .clear-btn:hover {
    color: var(--color-fg);
  }

  /* My Bar: persistent ownership, not a transient filter — owned chips get an
     outlined check treatment distinct from the filled accent filter chips. */
  .mybar-hint {
    margin: -0.35rem 0 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-fg-subtle);
  }
  .chip-mybar[aria-pressed='true'] {
    background: var(--color-surface);
    color: var(--color-accent);
    border-color: var(--color-accent);
    font-weight: 600;
  }
  .chip-mybar[aria-pressed='true']::before {
    content: '✓';
    font-weight: 700;
  }
  .chip-makeable {
    margin-top: 0.75rem;
  }
</style>
