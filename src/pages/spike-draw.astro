---
// THROWAWAY SPIKE at /spike-draw/ — DELETE BEFORE MERGE (lives only on this branch).
// Purpose: workshop the draw-on-scroll feel and pick a technique + timing
// values for U4. Two variants:
//   A. IntersectionObserver trigger-once + CSS class (recommended primary)
//   B. CSS animation-timeline: view() scrubbed (progressive enhancement)
// Sliders write --draw-dur / --draw-stagger so you can read off final numbers.
import BaseLayout from '../layouts/BaseLayout.astro';

// Sample fan: root + 5 branches (mirrors the real vertical-fan geometry).
const ROOT = { x: 300, y: 60 };
const branches = [150, 226, 302, 378, 454].map((y) => ({ x: 372, y }));
const elbow = (sx: number, sy: number, ex: number, ey: number) => {
  const my = (sy + ey) / 2;
  return `M${sx} ${sy} C${sx} ${my} ${ex} ${my} ${ex} ${ey}`;
};
const vb = '0 0 600 520';
---
<BaseLayout title="SPIKE: scroll-draw" description="throwaway" width="wide">
  <div class="spike">
    <p class="spike-warn">⚠️ Throwaway spike — delete before merge. Scroll down to trigger each map.</p>

    <div class="controls">
      <label>duration <input id="dur" type="range" min="100" max="1600" step="50" value="650" /> <output id="durOut">650ms</output></label>
      <label>stagger <input id="stag" type="range" min="0" max="250" step="10" value="90" /> <output id="stagOut">90ms</output></label>
      <button id="replay" type="button">Replay variant A</button>
    </div>

    <section class="bay">
      <h2>Variant A — IntersectionObserver, trigger-once</h2>
      <p>Draws when scrolled into view; fixed-duration CSS transition, per-branch stagger.</p>
      <svg class="map" data-variant="a" viewBox={vb} preserveAspectRatio="xMidYMid meet">
        {branches.map((b, i) => (
          <path class="wire" style={`--i:${i}`} d={elbow(ROOT.x, ROOT.y, b.x, b.y)} pathLength="1" />
        ))}
        <circle cx={ROOT.x} cy={ROOT.y} r="20" class="node" />
        {branches.map((b) => <circle cx={b.x} cy={b.y} r="12" class="node" />)}
      </svg>
    </section>

    <div class="spacer">↓ keep scrolling ↓</div>

    <section class="bay">
      <h2>Variant B — CSS animation-timeline: view() (scrubbed)</h2>
      <p>Drawing scrubs to scroll position. Falls back to fully-drawn where unsupported (e.g. Firefox).</p>
      <svg class="map" data-variant="b" viewBox={vb} preserveAspectRatio="xMidYMid meet">
        {branches.map((b, i) => (
          <path class="wire-b" style={`--i:${i}`} d={elbow(ROOT.x, ROOT.y, b.x, b.y)} pathLength="1" />
        ))}
        <circle cx={ROOT.x} cy={ROOT.y} r="20" class="node" />
        {branches.map((b) => <circle cx={b.x} cy={b.y} r="12" class="node" />)}
      </svg>
    </section>

    <div class="spacer">end</div>
  </div>
</BaseLayout>

<style>
  .spike { --draw-dur: 650ms; --draw-stagger: 90ms; max-width: 640px; margin: 0 auto; }
  .spike-warn { background: #ffe8e0; padding: 0.6rem 1rem; border-radius: 8px; font-size: 0.9rem; }
  .controls { position: sticky; top: 0.5rem; z-index: 5; display: flex; gap: 1.2rem; flex-wrap: wrap; align-items: center; background: var(--color-surface); padding: 0.7rem 1rem; border: 1px solid var(--color-rule); border-radius: 8px; }
  .controls label { display: flex; gap: 0.5rem; align-items: center; font-size: 0.85rem; }
  .bay { min-height: 80vh; padding-top: 6vh; }
  .bay h2 { font-family: var(--font-display); }
  .map { width: 100%; height: auto; overflow: visible; }
  .node { fill: var(--color-surface-muted); stroke: var(--color-rule-strong); stroke-width: 2; }
  .spacer { height: 60vh; display: grid; place-items: center; color: var(--color-fg-subtle); }

  /* Shared wire look */
  .wire, .wire-b {
    fill: none; stroke: var(--color-rule-strong); stroke-width: 2; stroke-linecap: round;
  }

  /* Variant A: undrawn by default; .drawn (added by JS on enter) animates in. */
  .map[data-variant='a'] .wire { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .map[data-variant='a'].drawn .wire {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--draw-dur) ease-out;
    transition-delay: calc(var(--i) * var(--draw-stagger));
  }

  /* Variant B: scroll-linked. Fully drawn where view() unsupported. */
  .wire-b { stroke-dasharray: 1; stroke-dashoffset: 0; }
  @supports (animation-timeline: view()) {
    .wire-b {
      stroke-dashoffset: 1;
      animation: draw-b linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 45%;
    }
  }
  @keyframes draw-b { to { stroke-dashoffset: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .map[data-variant='a'] .wire,
    .wire-b { stroke-dashoffset: 0 !important; animation: none !important; transition: none !important; }
  }
</style>

<script>
  const root = document.querySelector('.spike') as HTMLElement;
  const dur = document.getElementById('dur') as HTMLInputElement;
  const stag = document.getElementById('stag') as HTMLInputElement;
  const durOut = document.getElementById('durOut')!;
  const stagOut = document.getElementById('stagOut')!;
  const sync = () => {
    root.style.setProperty('--draw-dur', `${dur.value}ms`);
    root.style.setProperty('--draw-stagger', `${stag.value}ms`);
    durOut.textContent = `${dur.value}ms`;
    stagOut.textContent = `${stag.value}ms`;
  };
  dur.addEventListener('input', sync);
  stag.addEventListener('input', sync);
  sync();

  const mapA = document.querySelector(".map[data-variant='a']") as SVGElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { mapA.classList.add('drawn'); io.unobserve(e.target); }
      }
    }, { threshold: 0.4 });
    io.observe(mapA);
  } else {
    mapA.classList.add('drawn');
  }

  document.getElementById('replay')!.addEventListener('click', () => {
    mapA.classList.remove('drawn');
    // force reflow so the transition restarts
    void (mapA as unknown as HTMLElement).offsetWidth;
    mapA.classList.add('drawn');
  });
</script>
