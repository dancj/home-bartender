---
import BaseLayout from '../layouts/BaseLayout.astro';
import FamilyMap from '../components/FamilyMap.astro';
import { publishedRecipes } from '../lib/recipes';
import { ROOTS, label, groupByTax } from '../lib/taxonomy';

const recipes = await publishedRecipes();
const counts = groupByTax(recipes, 'roots');
const countFor = (slug: string) => counts.get(slug)?.length ?? 0;
---
<BaseLayout
  title="Roots — Home Bartending"
  description="The six Cocktail Codex root families every cocktail descends from."
  width="wide"
>
  <section class="page-head">
    <p class="families-lede">The six root families every cocktail descends from.</p>
    <p class="family-credit">
      Framework from <cite>Cocktail Codex</cite> by the team behind Death &amp; Co.
    </p>
  </section>

  <div class="family-switcher">
    <div class="family-tabs" role="tablist" aria-label="Cocktail roots">
      {ROOTS.map((slug, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${slug}`}
          class:list={['family-tab', { 'is-empty': countFor(slug) === 0 }]}
          data-family={slug}
          aria-controls={`panel-${slug}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {label('roots', slug)}
          <span class="family-tab-count">{countFor(slug)}</span>
        </button>
      ))}
    </div>

    {ROOTS.map((slug, i) => (
      <div
        role="tabpanel"
        id={`panel-${slug}`}
        class="family-panel"
        aria-labelledby={`tab-${slug}`}
        hidden={i !== 0}
      >
        <FamilyMap family={slug} recipes={recipes} />
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .families-lede {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--color-fg);
    letter-spacing: -0.01em;
  }
  .family-credit {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: var(--color-fg-muted);
  }
  .family-credit cite {
    font-style: italic;
  }

  .family-switcher {
    margin-top: 1.5rem;
  }
  .family-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    /* Let the strip shrink to its container so its min-content width can't push
       <main> wider than the viewport (the classic flexbox overflow). The mobile
       rule below turns the overflow into a contained horizontal scroll. */
    min-width: 0;
    max-width: 100%;
  }
  .family-tab {
    appearance: none;
    border: 1px solid var(--color-rule-strong);
    background: var(--color-surface);
    color: var(--color-fg-muted);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    cursor: pointer;
    transition: var(--transition-base);
  }
  .family-tab:hover {
    border-color: var(--color-accent);
    color: var(--color-fg);
  }
  .family-tab[aria-selected='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-fg);
  }
  .family-tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .family-tab-count {
    margin-left: 0.4rem;
    font-size: 0.8rem;
    opacity: 0.55;
    font-variant-numeric: tabular-nums;
  }
  /* Families with no recipes (Flip) are greyed but still selectable. */
  .family-tab.is-empty {
    opacity: 0.5;
  }
  .family-tab.is-empty[aria-selected='true'] {
    background: var(--color-surface-muted);
    border-color: var(--color-rule-strong);
    color: var(--color-fg-muted);
  }

  .family-panel {
    max-width: 640px;
    margin: 0 auto;
  }

  @media (max-width: 30rem) {
    /* Wrap the six tabs onto multiple rows on a phone — nothing runs off the
       edge, no horizontal scroll, no clipped last tab. */
    .family-tabs {
      gap: 0.35rem;
    }
    .family-tab {
      font-size: 0.85rem;
      padding: 0.35rem 0.7rem;
    }
  }
</style>

<script>
  const tablist = document.querySelector<HTMLElement>('.family-tabs');
  if (tablist) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panelFor = (tab: HTMLButtonElement) =>
      document.getElementById(tab.getAttribute('aria-controls') ?? '');

    type RootMaps = Map<string, { play(): void }>;

    function select(index: number, moveFocus = true) {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = panelFor(tab);
        if (panel) panel.hidden = !selected;
      });
      // The revealed panel was display:none, so its map's arrow anchors had no
      // box — now that it's laid out, recompute geometry and replay the draw.
      const family = tabs[index].dataset.family;
      const maps = (window as unknown as { rootMaps?: RootMaps }).rootMaps;
      if (family) maps?.get(family)?.play();
      if (moveFocus) tabs[index].focus();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (e) => {
        let next: number | null = null;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next !== null) {
          e.preventDefault();
          select(next);
        }
      });
    });
  }
</script>
