---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/learn-prose.css';

export async function getStaticPaths() {
  // Sections with their own dedicated, richer page (interactive calculator or
  // bespoke visual layout) are excluded here so they don't also resolve through
  // this generic prose route. `section.id` is the bare slug (e.g. `introduction`),
  // not the filename, for the glob content loader.
  const dedicated = new Set(['super-juice', 'tools', 'techniques']);
  const sections = (await getCollection('sections')).filter(
    (section) => !dedicated.has(section.id),
  );
  return sections.map((section) => ({
    params: { slug: section.id },
    props: { section },
  }));
}

const { section } = Astro.props;
const { Content } = await render(section);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout
  title={`${section.data.title} — Home Bartender`}
  description={section.data.summary}
>
  <p class="back">
    <a href={`${base}/learn/`}>← Learn</a>
  </p>
  <article data-pagefind-body class="prose">
    <Content />
  </article>
</BaseLayout>
