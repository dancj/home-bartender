---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/learn-prose.css';

export async function getStaticPaths() {
  // `super-juice` is served by its own page (src/pages/learn/super-juice.astro)
  // so it can mount the interactive calculator. Exclude it here to avoid a
  // duplicate `/learn/super-juice/` route. `section.id` is the bare slug
  // (e.g. `glossary`), not the filename, for the glob content loader.
  const sections = (await getCollection('sections')).filter(
    (section) => section.id !== 'super-juice',
  );
  return sections.map((section) => ({
    params: { slug: section.id },
    props: { section },
  }));
}

const { section } = Astro.props;
const { Content } = await render(section);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout
  title={`${section.data.title} — Home Bartender`}
  description={section.data.summary}
>
  <p class="back">
    <a href={`${base}/learn/`}>← Learn</a>
  </p>
  <article data-pagefind-body class="prose">
    <Content />
  </article>
</BaseLayout>
