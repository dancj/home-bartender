---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SuperJuiceCalculator from '../../components/SuperJuiceCalculator.astro';

// Dedicated route for the Super Juice technique: renders the section prose from
// the `sections` collection (so it still appears in the /learn index) and mounts
// the interactive calculator below it. [slug].astro excludes this slug so the
// two pages don't collide on /learn/super-juice/.
const section = await getEntry('sections', 'super-juice');
if (!section) throw new Error('Missing sections/super-juice.md');
const { Content } = await render(section);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={`${section.data.title} — Home Bartender`} description={section.data.summary}>
  <p class="back">
    <a href={`${base}/learn/`}>← Learn</a>
  </p>
  <article data-pagefind-body class="prose">
    <Content />
  </article>
  <SuperJuiceCalculator />
</BaseLayout>

<style>
  .back {
    margin-bottom: 1.25rem;
  }
  .back a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .back a:hover { color: var(--color-fg); }

  .prose :global(h1) {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin: 0 0 1rem;
  }
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    color: var(--color-fg);
  }
  .prose :global(p),
  .prose :global(li) {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-fg);
  }
  .prose :global(p) { margin-block: 0.75rem; }
  .prose :global(ul) {
    margin-block: 0.75rem;
    padding-inline-start: 1.5rem;
  }
  .prose :global(li) { margin-block: 0.35rem; }
  .prose :global(a) {
    color: var(--color-accent);
    text-underline-offset: 2px;
  }
  .prose :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }
  .prose :global(em) { color: var(--color-fg-muted); }
</style>
