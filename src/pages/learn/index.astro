---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

// Techniques: the house moves, one line each, each pointing at a recipe that
// leans on it. Formerly one chapter of the Learn scroll; the rest (tools, stir
// or shake, super juice) was dropped — tips now live on recipes and syrups.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Each move borrows the closest glyph from the recipe icon set.
// `uses` points at a recipe on this site that leans on the move.
const moves = [
  { icon: ['ice', 'cubed'], title: 'Dilution', body: 'Not a mistake — an ingredient. The water from melting ice opens up the flavors, especially in spirit-forward drinks. Don’t rush it.', uses: { slug: 'manhattan', title: 'Manhattan' } },
  { icon: ['sections', 'float'], title: 'The Float', body: 'Pour slowly over the back of a bar spoon so it rests as a separate layer — smoke on the nose before the balanced sip beneath.', uses: { slug: 'penicillin', title: 'Penicillin' } },
  { icon: ['sections', 'house-made'], title: 'Fat Washing', body: 'Steep butter, bacon grease, or coconut cream in a spirit, freeze, strain. The flavor stays; the texture doesn’t.', uses: { slug: 'maple-bacon-old-fashioned', title: 'Maple Bacon Old Fashioned' } },
  { icon: ['flavors', 'herbal'], title: 'Muddling', body: 'Press and twist — never pound. Over-muddled mint turns bitter; properly muddled mint stays bright.', uses: { slug: 'prosecco-mojito', title: 'Prosecco Mojito' } },
  { icon: ['method', 'shaken'], title: 'Dry Shaking', body: 'Egg-white drinks: shake once without ice to build the foam, then again with ice to chill.', uses: { slug: 'lavender-fields', title: 'Lavender Fields' } },
  { icon: ['flavors', 'smoky'], title: 'Flaming a Peel', body: 'Torch the peel itself until the oils catch and char, then drop it straight into the drink — smoky, caramelized citrus on the nose.', uses: { slug: 'oaxaca-old-fashioned', title: 'Oaxaca Old Fashioned' } },
  { icon: ['sections', 'batch'], title: 'Batching', body: 'Pre-dilute 20–25% if the batch won’t meet ice, add bubbles at the last moment, garnish each glass on its own.', uses: { slug: 'paper-plane', title: 'Paper Plane' } },
];
---
<BaseLayout
  title="Techniques — Home Bartending"
  description="Seven techniques beyond the shaker, each with a recipe that uses it."
  width="wide"
>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <div class="journey" data-journey>
    <section class="chapter" aria-labelledby="moves-title">
      <header class="chapter__head rv">
        <h1 class="hero__title" id="moves-title">Techniques</h1>
        <p class="chapter__kicker">Seven techniques beyond the shaker, in one line each.</p>
      </header>
      <ol class="moves" role="list">
        {moves.map((m, i) => (
          <li class="moves__item rv" style={`--d:${(i % 2) * 60}ms`}>
            <Icon field={m.icon[0]} slug={m.icon[1]} class="moves__icon" />
            <div>
              <h2 class="moves__title">{m.title}</h2>
              <p class="moves__body">{m.body}</p>
              <p class="moves__uses">
                <a href={`${base}/recipes/${m.uses.slug}/`}>Try it: {m.uses.title} →</a>
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>

<script>
  // Reveal-on-scroll. Bails under prefers-reduced-motion (CSS shows the final
  // state) and no-JS (html.js gates the hidden initial state).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const journey = document.querySelector<HTMLElement>('[data-journey]');

  if (journey && !reduceMotion) {
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            reveal.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -5% 0px' }
    );
    journey.querySelectorAll('.rv').forEach((el) => reveal.observe(el));
  }
</script>

<style>
  .chapter {
    max-width: 56rem;
    margin: 0 auto;
    padding: 4.5rem 0;
  }
  .chapter__head {
    margin-bottom: 2.5rem;
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .chapter__kicker {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-fg-muted);
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
    line-height: 1.55;
    margin-top: 0.6rem;
    max-width: 52ch;
  }

  .moves {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem 3rem;
  }
  @media (min-width: 48rem) {
    .moves {
      grid-template-columns: 1fr 1fr;
    }
  }
  .moves__item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    align-items: start;
  }
  .moves__item :global(.tax-icon) {
    --icon-size: 2.25rem;
    color: var(--color-accent);
    margin-top: 0.15rem;
    grid-column: 1;
  }
  /* Text always lands in the wide column even if an icon slug resolves to
     nothing (Icon renders empty on unknown field/slug). */
  .moves__item > div {
    grid-column: 2;
  }
  .moves__title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .moves__body {
    font-family: var(--font-serif);
    font-size: 0.9875rem;
    line-height: 1.6;
    color: var(--color-fg-muted);
  }
  .moves__uses {
    margin-top: 0.45rem;
  }
  .moves__uses a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .moves__uses a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── reveal motion — gated on JS so no-JS renders everything ────── */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .rv {
      opacity: 0;
      transform: translateY(1.1rem);
      transition: opacity 0.65s ease var(--d, 0ms), transform 0.65s ease var(--d, 0ms);
    }
    :global(html.js) .rv.is-in {
      opacity: 1;
      transform: none;
    }
  }
</style>
