---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const sections = (await getCollection('sections')).sort(
  (a, b) => a.data.order - b.data.order
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout
  title="Learn — Home Bartender"
  description="Techniques, tools, glossary, and prose about home bartending."
>
  <section class="page-head">
    <p class="eyebrow">Reference</p>
    <h1>Learn</h1>
    <p class="lede">
      Techniques, tools, vocabulary, and the philosophy behind this collection.
    </p>
  </section>

  <ul class="section-list">
    {sections.map((s) => (
      <li>
        <a href={`${base}/learn/${s.id}/`} class="card">
          <h2 class="section-title">{s.data.title}</h2>
          {s.data.summary && <p class="section-summary">{s.data.summary}</p>}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .section-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    color: hsl(var(--fg));
    letter-spacing: -0.01em;
  }
  .section-summary {
    margin: 0;
    color: hsl(var(--fg-muted));
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.45;
  }
</style>
