---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import SuperJuiceCalculator from '../../components/SuperJuiceCalculator.astro';

// The Learn index is a single scroll journey ("Behind the Bar") rather than a
// card grid: four chapters in learning order, chained by a terracotta spine
// that fills as you scroll, with dark bar-mat interludes between them. Copy
// here is condensed from the full chapter pages (tools.astro, techniques.astro,
// super-juice.astro), which remain the canonical long-form routes.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const chapters = [
  { id: 'kit', num: '01', title: 'Tools', hook: 'Six tools cover every recipe.' },
  { id: 'call', num: '02', title: 'Stir or Shake', hook: 'The first decision every drink asks.' },
  { id: 'moves', num: '03', title: 'The Moves', hook: 'Seven techniques beyond the shaker.' },
  { id: 'juice', num: '04', title: 'Super Juice', hook: 'Citrus math, with a calculator.' },
];

// Chapter 01 — inline line-art keys into the `tools` glyphs drawn in the markup
// below (no taxonomy icons exist for barware; these are page-local artwork).
const kit = [
  { glyph: 'shaker', name: 'Shaker', desc: 'Tin + tin or tin + glass. Cobbler with a built-in strainer works fine at home.' },
  { glyph: 'strainer', name: 'Strainer', desc: 'Hawthorne (the spring coil) for shaken drinks, julep for the mixing glass.' },
  { glyph: 'jigger', name: 'Jigger', desc: 'Measure your pours. Eyeballing is a bar skill; at home, measure.' },
  { glyph: 'mixing-glass', name: 'Mixing glass', desc: 'A heavy glass that chills and stirs without aerating.' },
  { glyph: 'barspoon', name: 'Bar spoon', desc: 'Long, twisted handle — stirs deep and controls layered pours.' },
  { glyph: 'peeler', name: 'Peeler', desc: 'For citrus peels and garnishes.' },
];
const niceToHave = ['Smoking kit', 'Microplane', 'Big ice tray', 'Muddler', 'Fine mesh strainer'];

// Chapter 03 — each move borrows the closest glyph from the recipe icon set.
// `uses` points at a recipe on this site that leans on the move.
const moves = [
  { icon: ['ice', 'cubed'], title: 'Dilution', body: 'Not a mistake — an ingredient. The water from melting ice opens up the flavors, especially in spirit-forward drinks. Don’t rush it.', uses: { slug: 'manhattan', title: 'Manhattan' } },
  { icon: ['sections', 'float'], title: 'The Float', body: 'Pour slowly over the back of a bar spoon so it rests as a separate layer — smoke on the nose before the balanced sip beneath.', uses: { slug: 'penicillin', title: 'Penicillin' } },
  { icon: ['sections', 'house-made'], title: 'Fat Washing', body: 'Steep butter, bacon grease, or coconut cream in a spirit, freeze, strain. The flavor stays; the texture doesn’t.', uses: { slug: 'maple-bacon-old-fashioned', title: 'Maple Bacon Old Fashioned' } },
  { icon: ['flavors', 'herbal'], title: 'Muddling', body: 'Press and twist — never pound. Over-muddled mint turns bitter; properly muddled mint stays bright.', uses: { slug: 'prosecco-mojito', title: 'Prosecco Mojito' } },
  { icon: ['method', 'shaken'], title: 'Dry Shaking', body: 'Egg-white drinks: shake once without ice to build the foam, then again with ice to chill.', uses: { slug: 'lavender-fields', title: 'Lavender Fields' } },
  { icon: ['flavors', 'smoky'], title: 'Flaming a Peel', body: 'Torch the peel itself until the oils catch and char, then drop it straight into the drink — smoky, caramelized citrus on the nose.', uses: { slug: 'oaxaca-old-fashioned', title: 'Oaxaca Old Fashioned' } },
  { icon: ['sections', 'batch'], title: 'Batching', body: 'Pre-dilute 20–25% if the batch won’t meet ice, add bubbles at the last moment, garnish each glass on its own.', uses: { slug: 'paper-plane', title: 'Paper Plane' } },
];

const interludes = [
  { icon: ['ice', 'large-cube'], label: 'House tip', tip: 'Big two-inch cubes melt slowly — that’s dilution control in a rocks drink.' },
  { icon: ['glass', 'coupe'], label: 'House tip', tip: 'Chill the glass while you work. A warm coupe undoes a good stir.' },
  { icon: ['flavors', 'citrus'], label: 'Up next', tip: 'Two lemons or three limes make about four cups of party citrus. Here’s the math.' },
];
---
<BaseLayout
  title="Learn — Home Bartender"
  description="The home bar in four chapters: tools, stir or shake, techniques, and super juice."
  width="wide"
>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Chapter jump rail (desktop). Scrollspy sets aria-current from the script below. -->
  <nav class="rail" aria-label="Chapters">
    {chapters.map((c) => (
      <a href={`#${c.id}`} data-spy-link={c.id}>
        <span class="rail__num">{c.num}</span>
        <span class="rail__label">{c.title}</span>
      </a>
    ))}
  </nav>

  <div class="journey" data-journey>
    <header class="hero">
      <h1 class="hero__title">Learn</h1>
      <ol class="hero__toc" role="list">
        {chapters.map((c) => (
          <li>
            <a href={`#${c.id}`}>
              <span class="hero__toc-num" aria-hidden="true">{c.num}</span>
              <span class="hero__toc-title">{c.title}</span>
              <span class="hero__toc-hook">{c.hook}</span>
            </a>
          </li>
        ))}
      </ol>
    </header>

    <div class="spine" aria-hidden="true"></div>

    <!-- ── Chapter 01 · The Kit ─────────────────────────────────────── -->
    <section class="chapter" id="kit" data-chapter="kit" aria-labelledby="kit-title">
      <header class="chapter__head rv">
        <span class="chapter__num" aria-hidden="true">01</span>
        <h2 class="chapter__title" id="kit-title">Tools</h2>
        <p class="chapter__kicker">Every recipe on this site, six tools.</p>
      </header>
      <ul class="kitgrid" role="list">
        {kit.map((t, i) => (
          <li class="kitgrid__item rv" style={`--d:${i * 60}ms`}>
            <svg class="toolglyph" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {t.glyph === 'shaker' && (
                <>
                  <rect x="20" y="4" width="8" height="5" rx="1.5" />
                  <path d="M17.5 9.5h13l-1.5 7h-10z" />
                  <path d="M15.5 16.5h17L30 41.5c-.1 1.4-1.2 2.5-2.6 2.5h-6.8c-1.4 0-2.5-1.1-2.6-2.5z" />
                </>
              )}
              {t.glyph === 'strainer' && (
                <>
                  <circle cx="24" cy="29" r="10.5" />
                  <circle cx="24" cy="29" r="6.5" stroke-dasharray="2.5 3.5" />
                  <path d="M24 18.5V7M19 7h10" />
                </>
              )}
              {t.glyph === 'jigger' && (
                <>
                  <path d="M15 7h18l-9 16.5z" />
                  <path d="M15 41h18l-9-16.5z" />
                </>
              )}
              {t.glyph === 'mixing-glass' && (
                <>
                  <path d="M14.5 8.5h19L31.5 41h-15z" />
                  <path d="M14.5 8.5 11 5" />
                  <path d="m20 22 7.5-7.5M21 31l11-11" />
                </>
              )}
              {t.glyph === 'barspoon' && (
                <>
                  <path d="M24 4v6" />
                  <path d="M24 10c2.4 1.6-2.4 3.4 0 5s-2.4 3.4 0 5 -2.4 3.4 0 5" />
                  <path d="M24 25v6" />
                  <ellipse cx="24" cy="37" rx="4" ry="6" />
                </>
              )}
              {t.glyph === 'peeler' && (
                <>
                  <path d="M24 44V27" />
                  <path d="M24 27 15 15.5M24 27l9-11.5" />
                  <path d="M14 15.5h20" />
                  <path d="M17.5 11.5h13" />
                </>
              )}
            </svg>
            <h3 class="kitgrid__name">{t.name}</h3>
            <p class="kitgrid__desc">{t.desc}</p>
          </li>
        ))}
      </ul>
      <p class="chapter__aside rv">
        <span class="chapter__aside-label">Worth it later</span>
        {niceToHave.map((n) => <span class="chapter__chip">{n}</span>)}
      </p>
      <p class="chapter__more rv"><a href={`${base}/learn/tools/`}>Full chapter: Tools →</a></p>
    </section>

    <aside class="interlude" aria-label="House tip">
      <Icon field={interludes[0].icon[0]} slug={interludes[0].icon[1]} class="interlude__decal" />
      <div class="interlude__inner container-wide rv">
        <span class="interlude__label">{interludes[0].label}</span>
        <p class="interlude__tip">{interludes[0].tip}</p>
      </div>
    </aside>

    <!-- ── Chapter 02 · Stir or Shake ───────────────────────────────── -->
    <section class="chapter" id="call" data-chapter="call" aria-labelledby="call-title">
      <header class="chapter__head rv">
        <span class="chapter__num" aria-hidden="true">02</span>
        <h2 class="chapter__title" id="call-title">Stir or Shake</h2>
        <p class="chapter__kicker">The most important decision in making a cocktail is how you combine it.</p>
      </header>
      <div class="verdict">
        <div class="verdict__panel rv">
          <Icon field="method" slug="stirred" class="verdict__icon" />
          <h3 class="verdict__verb">Stir</h3>
          <p class="verdict__rule">All spirit, no juice</p>
          <p class="verdict__body">
            Spirits, liqueurs, and syrups only. Stirring chills and dilutes
            without aeration — clear and silky. Old fashioneds, Negronis,
            Manhattans. Aim for 30–45 seconds.
          </p>
        </div>
        <div class="verdict__panel rv" style="--d:120ms">
          <Icon field="method" slug="shaken" class="verdict__icon" />
          <h3 class="verdict__verb">Shake</h3>
          <p class="verdict__rule">Juice, cream, or egg</p>
          <p class="verdict__body">
            Anything that needs to be emulsified or broken down. Shaking aerates
            — slightly cloudy, livelier texture. Margaritas, sours, mojitos.
          </p>
        </div>
      </div>
      <p class="chapter__more rv"><a href={`${base}/learn/techniques/`}>Full chapter: Techniques →</a></p>
    </section>

    <aside class="interlude" aria-label="House tip">
      <Icon field={interludes[1].icon[0]} slug={interludes[1].icon[1]} class="interlude__decal" />
      <div class="interlude__inner container-wide rv">
        <span class="interlude__label">{interludes[1].label}</span>
        <p class="interlude__tip">{interludes[1].tip}</p>
      </div>
    </aside>

    <!-- ── Chapter 03 · The Moves ───────────────────────────────────── -->
    <section class="chapter" id="moves" data-chapter="moves" aria-labelledby="moves-title">
      <header class="chapter__head rv">
        <span class="chapter__num" aria-hidden="true">03</span>
        <h2 class="chapter__title" id="moves-title">The Moves</h2>
        <p class="chapter__kicker">Foundational techniques, in one line each. The full chapter goes deeper.</p>
      </header>
      <ol class="moves" role="list">
        {moves.map((m, i) => (
          <li class="moves__item rv" style={`--d:${(i % 2) * 60}ms`}>
            <Icon field={m.icon[0]} slug={m.icon[1]} class="moves__icon" />
            <div>
              <h3 class="moves__title">{m.title}</h3>
              <p class="moves__body">{m.body}</p>
              <p class="moves__uses">
                <a href={`${base}/recipes/${m.uses.slug}/`}>Try it: {m.uses.title} →</a>
              </p>
            </div>
          </li>
        ))}
      </ol>
      <p class="chapter__more rv"><a href={`${base}/learn/techniques/`}>Full chapter: Techniques →</a></p>
    </section>

    <aside class="interlude" aria-label="Up next">
      <Icon field={interludes[2].icon[0]} slug={interludes[2].icon[1]} class="interlude__decal" />
      <div class="interlude__inner container-wide rv">
        <span class="interlude__label">{interludes[2].label}</span>
        <p class="interlude__tip">{interludes[2].tip}</p>
      </div>
    </aside>

    <!-- ── Chapter 04 · Super Juice ─────────────────────────────────── -->
    <section class="chapter" id="juice" data-chapter="juice" aria-labelledby="juice-title">
      <header class="chapter__head rv">
        <span class="chapter__num" aria-hidden="true">04</span>
        <h2 class="chapter__title" id="juice-title">Super Juice</h2>
        <p class="chapter__kicker">
          Eight times the citrus from the same fruit: steep the peels in acid,
          blend with water and the juice. Everything is measured against the
          weight of the peels.
        </p>
      </header>
      <div class="ratios rv">
        <div class="ratios__row">
          <span class="ratios__fruit">Lime</span>
          <span class="ratios__fig"><b>0.66×</b> citric</span>
          <span class="ratios__fig"><b>0.33×</b> malic</span>
          <span class="ratios__fig"><b>16.66×</b> water</span>
        </div>
        <div class="ratios__row">
          <span class="ratios__fruit">Lemon</span>
          <span class="ratios__fig"><b>1.0×</b> citric</span>
          <span class="ratios__fig"><b>16.66×</b> water</span>
        </div>
      </div>
      <div class="rv">
        <SuperJuiceCalculator />
      </div>
      <p class="chapter__more rv"><a href={`${base}/learn/super-juice/`}>Full chapter: Super Juice →</a></p>
    </section>

    <footer class="outro rv">
      <p class="outro__line"><a href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;">Back to the top ↑</a></p>
    </footer>
  </div>
</BaseLayout>

<script>
  // Journey motion: reveal-on-scroll, chapter scrollspy for the rail, and the
  // spine fill. All three bail under prefers-reduced-motion (CSS shows the
  // final states) and no-JS (html.js gates the hidden initial states).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const journey = document.querySelector<HTMLElement>('[data-journey]');

  if (journey && !reduceMotion) {
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            reveal.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -5% 0px' }
    );
    journey.querySelectorAll('.rv').forEach((el) => reveal.observe(el));

    // Scrollspy: the chapter crossing mid-viewport lights its rail link and
    // ignites its numeral.
    const links = new Map<string, HTMLElement>();
    document
      .querySelectorAll<HTMLElement>('[data-spy-link]')
      .forEach((a) => links.set(a.dataset.spyLink!, a));
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const id = (e.target as HTMLElement).dataset.chapter!;
          e.target.classList.toggle('is-live', e.isIntersecting);
          const link = links.get(id);
          if (link) {
            if (e.isIntersecting) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          }
        }
      },
      { rootMargin: '-40% 0px -50% 0px' }
    );
    journey.querySelectorAll('[data-chapter]').forEach((s) => spy.observe(s));

    // Spine fill: 0 at the journey's top hitting mid-viewport, 1 at its bottom.
    let ticking = false;
    const fill = () => {
      ticking = false;
      const r = journey.getBoundingClientRect();
      const p = (window.innerHeight * 0.55 - r.top) / r.height;
      journey.style.setProperty('--fill', String(Math.min(1, Math.max(0, p))));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(fill);
      }
    };
    fill();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }
  /* Full-bleed interludes overhang the container by 50vw; clip the sliver the
     scrollbar-inclusive vw unit adds. */
  :global(body) {
    overflow-x: clip;
  }

  .journey {
    --fill: 0;
    position: relative;
  }

  /* ── hero ───────────────────────────────────────────────────────── */
  .hero {
    max-width: 64ch;
    margin: 0 auto 4.5rem;
    text-align: center;
  }
  .hero .eyebrow {
    display: block;
    margin-bottom: 0.6rem;
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .hero__lede {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-fg-muted);
    font-size: clamp(1.0625rem, 2.5vw, 1.25rem);
    line-height: 1.5;
    margin: 0.9rem auto 0;
    max-width: 46ch;
  }
  .hero__toc {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    text-align: left;
    border-top: 1px solid var(--color-rule);
  }
  .hero__toc a {
    display: grid;
    grid-template-columns: 3rem 11rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
    transition: background-color var(--transition-base);
  }
  .hero__toc a:hover {
    background: var(--color-surface);
  }
  .hero__toc-num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .hero__toc-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .hero__toc-hook {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-fg-muted);
  }
  @media (max-width: 40rem) {
    .hero__toc a {
      grid-template-columns: 2.5rem 1fr;
    }
    .hero__toc-hook {
      display: none;
    }
  }

  /* ── spine ──────────────────────────────────────────────────────── */
  .spine {
    display: none;
  }
  @media (min-width: 64rem) {
    .spine {
      display: block;
      position: absolute;
      top: 16rem; /* below the hero */
      bottom: 6rem;
      left: 1.4rem;
      width: 2px;
      background: var(--color-rule);
    }
    .spine::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--color-accent);
      transform-origin: top;
      transform: scaleY(var(--fill));
    }
    @media (prefers-reduced-motion: reduce) {
      .spine::after {
        transform: none;
      }
    }
  }

  /* ── chapters ───────────────────────────────────────────────────── */
  .chapter {
    position: relative;
    max-width: 56rem;
    margin: 0 auto;
    padding: 4.5rem 0;
    scroll-margin-top: 5.5rem;
  }
  .chapter__head {
    position: relative;
    margin-bottom: 2.5rem;
  }
  .chapter__num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 5.5rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--color-rule-strong);
    font-variant-numeric: tabular-nums;
    transition: color 0.6s ease;
    margin-bottom: 0.75rem;
  }
  .chapter.is-live .chapter__num {
    color: var(--color-accent);
  }
  .chapter__title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 5vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .chapter__kicker {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-fg-muted);
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
    line-height: 1.55;
    margin-top: 0.6rem;
    max-width: 52ch;
  }
  .chapter__more {
    margin-top: 2.25rem;
  }
  .chapter__more a {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .chapter__more a:hover {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }

  /* ── ch 01 · kit grid ───────────────────────────────────────────── */
  .kitgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .kitgrid__item {
    padding: 1.5rem;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .toolglyph {
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-accent);
    margin-bottom: 0.85rem;
  }
  .kitgrid__name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .kitgrid__desc {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-fg-muted);
  }
  .chapter__aside {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }
  .chapter__aside-label {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-subtle);
    margin-right: 0.35rem;
  }
  .chapter__chip {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-fg-muted);
    background: var(--color-surface);
  }

  /* ── ch 02 · the verdict diptych ────────────────────────────────── */
  .verdict {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 44rem) {
    .verdict {
      grid-template-columns: 1fr 1fr;
    }
  }
  .verdict__panel {
    padding: 2.25rem 2rem;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--transition-lift), transform var(--transition-lift);
  }
  @media (hover: hover) {
    .verdict__panel:hover {
      box-shadow: var(--shadow-card-hover);
      transform: translateY(-3px);
    }
  }
  /* Icon spans render inside Icon.astro, outside this page's style scope —
     size them via :global under scoped parents. */
  .verdict__panel :global(.tax-icon) {
    --icon-size: 3.25rem;
    color: var(--color-accent);
    display: block;
    margin-bottom: 1rem;
  }
  .verdict__verb {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }
