---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { publishedRecipes } from '../../lib/recipes';
import { label } from '../../lib/taxonomy';
import Icon from '../../components/Icon.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { breadcrumbTrail } from '../../lib/breadcrumbs';

export async function getStaticPaths() {
  const recipes = await publishedRecipes();
  const buckets = new Map<string, typeof recipes>();
  for (const r of recipes) {
    const d = r.data.difficulty;
    buckets.set(d, [...(buckets.get(d) ?? []), r]);
  }
  return [...buckets].map(([difficulty, items]) => ({
    params: { difficulty },
    props: { difficulty, items },
  }));
}

const { difficulty, items } = Astro.props;
const displayName = label('difficulty', difficulty);
---
<BaseLayout
  title={`${displayName} cocktails — Home Bartender`}
  description={`${items.length} ${displayName.toLowerCase()} cocktails.`}
  width="wide"
>
  <section class="page-head">
    <Breadcrumb segments={breadcrumbTrail('difficulty', displayName)} />
    <h1><Icon field="difficulty" slug={difficulty} class="head-icon" /> {displayName}</h1>
    <p class="lede">{items.length} {items.length === 1 ? 'recipe' : 'recipes'}.</p>
  </section>
  <ul class="recipe-grid">
    {items
      .sort((a, b) => a.data.title.localeCompare(b.data.title))
      .map((r) => <RecipeCard recipe={r} />)}
  </ul>
</BaseLayout>
