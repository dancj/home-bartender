---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Search from '../components/Search.astro';
import logoFullSrc from '../assets/brand/logo-full.png';
import logoCoupeSrc from '../assets/brand/logo-coupe.png';

interface Props {
  title: string;
  description?: string;
  width?: 'prose' | 'wide';
}
const { title, description, width = 'prose' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const containerClass = width === 'wide' ? 'container-wide' : 'container-prose';

const path = Astro.url.pathname;
const isLearn = path.startsWith(`${base}/learn`);
const isFamilies = path.startsWith(`${base}/families`);
const navLinks = [
  { href: `${base}/`, label: 'Recipes', current: !isLearn && !isFamilies },
  { href: `${base}/families/`, label: 'Families', current: isFamilies },
  { href: `${base}/learn/`, label: 'Learn', current: isLearn },
];

// Generate at high density so both header states stay crisp on retina; CSS
// scales these down. The wordmark renders at its native source width (1426px)
// — its largest on-screen use is the full-width mobile hero, and the 1426×511
// transparent source can't be upscaled past that without softening. The coupe
// only ever shows small (the ~64px collapsed icon), so 256px gives 2–4×.
const logoFull = await getImage({ src: logoFullSrc, width: 1426, height: 511, format: 'webp' });
const logoCoupe = await getImage({ src: logoCoupeSrc, width: 256, height: 256, format: 'webp' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header sticky top-0 z-10 bg-header-bg" data-collapsing-header>
      <div class="container-wide site-header__content">
        <a href={`${base}/`} class="brand no-underline" aria-label="Home Bartender">
          <img class="brand-wordmark" src={logoFull.src} alt="" width={logoFull.attributes.width} height={logoFull.attributes.height} />
          <img class="brand-coupe" src={logoCoupe.src} alt="" width={logoCoupe.attributes.width} height={logoCoupe.attributes.height} />
        </a>
        <nav class="nav-links flex" aria-label="Primary">
          {navLinks.map(link => (
            <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a>
          ))}
          <button
            type="button"
            class="nav-search-toggle"
            aria-label="Search recipes"
            aria-expanded="false"
            aria-controls="header-search-panel"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </button>
        </nav>
      </div>
      <div id="header-search-panel" class="header-search-panel" hidden>
        <Search mode="compact" id="header-search-input" />
      </div>
    </header>
    <script is:inline>
      (function () {
        const btn = document.querySelector('.nav-search-toggle');
        const panel = document.getElementById('header-search-panel');
        if (!btn || !panel) return;
        const open = () => {
          panel.hidden = false;
          btn.setAttribute('aria-expanded', 'true');
          const input = panel.querySelector('input');
          if (input) input.focus();
        };
        const close = () => {
          panel.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
        };
        btn.addEventListener('click', () => (panel.hidden ? open() : close()));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !panel.hidden) { close(); btn.focus(); }
        });
        document.addEventListener('click', (e) => {
          if (panel.hidden) return;
          if (!panel.contains(e.target) && !btn.contains(e.target)) close();
        });
      })();
    </script>
    <main class={`${containerClass} flex-1 w-full pt-10 pb-16 lg:pt-12 lg:pb-20`}>
      <slot />
    </main>
    <footer class="site-footer border-t border-rule py-8 font-sans text-[0.8125rem] text-fg-muted text-center">
      <div class="container-wide">
        <p>
          Recipes shared under
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
          <a href="https://github.com/dancj/home-bartender">Framework on GitHub</a>.
        </p>
      </div>
    </footer>
    <script>
      import { headerProgress } from '../scripts/headerProgress';

      const header = document.querySelector<HTMLElement>('[data-collapsing-header]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      // The header's CSS default is the hero; reduced-motion forces compact via
      // media query. This script is what makes the hero *collapse*: it writes
      // --header-progress inline as you scroll. Under reduced-motion we bail so
      // the compact media-query value stands and nothing animates (R10). With no
      // JS the hero stays put (static, non-collapsing) — a reasonable fallback.
      if (header && !reduceMotion.matches) {
        const rootFontPx = () =>
          parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;

        // Read a rem/px length custom property off the header as px.
        const readLength = (name: string): number => {
          const raw = getComputedStyle(header).getPropertyValue(name).trim();
          const n = parseFloat(raw);
          if (Number.isNaN(n)) return 0;
          return raw.endsWith('rem') ? n * rootFontPx() : n;
        };

        // Collapse distance = the band's large-minus-compact height. Recomputed
        // on resize because both are rem values that change at the breakpoint.
        let collapseDistance = 0;
        const measure = () => {
          collapseDistance = readLength('--hb-large') - readLength('--hb-compact');
        };

        let ticking = false;
        const apply = () => {
          ticking = false;
          const progress = headerProgress(window.scrollY, collapseDistance);
          header.style.setProperty('--header-progress', String(progress));
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(apply);
          }
        };

        measure();
        apply(); // set the frame for the current scroll position (no-op at the top)
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', () => {
          measure();
          apply();
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  /* ── Collapsing header ────────────────────────────────────────────────
     One markup tree renders two states, interpolated by --header-progress:
       0 = large hero (big centered/full-width wordmark, tabs beneath)
       1 = compact slim bar (today's header: small logo left, tabs right)
     --header-progress defaults to 0 (hero), so the header renders hero-first and
     the scroll script has nothing to "expand" on load — this avoids a flash of the
     compact bar when navigating between pages. Reduced-motion forces 1 (compact)
     via the media query below; the scroll script writes the property inline on
     scroll. With no JS the hero stays put (static, non-collapsing).

     The dark chrome occupies real, interpolated height (see .site-header__content
     `height`), so <main> always flows directly below the header in both states —
     no overlap, no leftover gap. The header is sticky, so as you scroll it shrinks
     and pins to the top. Logo/tabs ride transforms keyed to the same progress. */
  .site-header {
    /* Tunable geometry — adjust these to tune the hero proportions. */
    --hb-compact: 4rem;            /* slim-bar height = logo height */
    --hb-large: 12.4rem;           /* hero height (mobile default) */
    --brand-scale-hero: 1.6;       /* desktop wordmark enlargement at hero */
    /* Default to the hero (0). Rendering hero-first means JS has nothing to
       "expand" on load — at the top of a fresh page the scroll script just
       confirms 0 — so there's no flash of the compact bar when navigating
       between pages. The scroll script writes --header-progress inline as you
       scroll; reduced-motion forces compact below. */
    --header-progress: 0;          /* 0 = hero, 1 = compact (U3 drives this) */
    --h: calc(1 - var(--header-progress)); /* hero amount: 1 = hero, 0 = compact */
  }

  /* Reduced motion: render the compact sticky bar and never animate (R10).
     CSS-only, so it holds with or without JS; the scroll script also bails out
     under reduced motion, so nothing overrides this back to the hero. */
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      --header-progress: 1;
    }
  }

  .site-header__content {
    position: relative;
    container-type: inline-size;   /* establishes cqw for tab centring */
    /* Real height interpolated large→compact. <main> sits directly below it,
       so collapsing pulls the page up rather than revealing/covering content. */
    height: calc(var(--hb-compact) + (var(--hb-large) - var(--hb-compact)) * var(--h));
  }

  /* The link is a layout-neutral wrapper; each mark positions itself. */
  .brand {
    display: contents;
    border-radius: 0;
  }
  .brand-wordmark,
  .brand-coupe {
    position: absolute;
    object-fit: contain;
  }

  /* ── Mobile (Compact, <40rem) ───────────────────────────────────────────
     Crossfade: full-width wordmark (hero) ⇄ square coupe (compact). No scale. */
  .brand-coupe {
    top: 0;
    left: 0;
    height: var(--hb-compact);
    width: var(--hb-compact);
    opacity: var(--header-progress); /* visible compact, fades out into hero */
  }
  .brand-wordmark {
    top: 0;
    left: 50%;
    width: min(100%, 22rem);
    height: auto;
    transform: translateX(-50%) translateY(calc(0.9rem * var(--h)));
    opacity: var(--h); /* visible hero, fades out into compact */
  }

  /* ── Desktop (Comfortable / Wide, ≥40rem) ───────────────────────────────
     One wordmark scales between compact-left and hero-centered; coupe unused. */
  @media (min-width: 40rem) {
    .brand-coupe { display: none; }
    .brand-wordmark {
      --scale: calc(1 + (var(--brand-scale-hero) - 1) * var(--h));
      top: 0;
      height: var(--hb-compact);
      width: auto;
      left: calc(50% * var(--h));
      transform-origin: top left;
      transform:
        translateX(calc(-50% * var(--scale) * var(--h)))
        translateY(calc(0.9rem * var(--h)))
        scale(var(--scale));
      opacity: 1;
    }
    .site-header {
      --hb-large: 11rem;
    }
  }

  /* Folder-tab nav — each link is a cream-filled tab that sits flush with
     the bottom of the dark header chrome and visually merges into the page
     below. Top corners round; bottom corners are square so the tab "opens"
     into the page surface.

     Compact: small logo left, tabs at the right edge, vertically centred in
     the slim bar. Hero: tabs drop beneath the logo, horizontally centred.
     Both positions are reached by interpolating the same --h. */
  .nav-links {
    position: absolute;
    /* Flush with the header's bottom edge in BOTH states, so the folder tabs
       always open into the page surface (no dark gap below them). The header's
       interpolated height does the vertical morph for free. */
    bottom: 0;
    top: auto;
    right: 0;                 /* compact: anchored to the right edge (R5) */
    left: auto;
    gap: 0.25rem;
    /* x only: right-anchored (compact) → horizontally centred (hero).
       (50% - 50cqw) shifts the cluster's centre from the right edge to the
       container centre; 50% is half the nav's own width, 50cqw half the bar. */
    transform: translateX(calc((50% - 50cqw) * var(--h)));
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    /* Inactive tabs are orange so they read as "other folders" sitting in the
       chrome; the active tab matches the page bg and visually continues it. */
    background: var(--color-accent);
    color: var(--color-accent-fg);
    text-decoration: none;
    padding: 0.5rem 1.1rem 0.55rem;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    transition: background-color var(--transition-base),
      color var(--transition-base);
  }
  .nav-links a:hover {
    background: color-mix(in srgb, var(--color-accent), white 8%);
  }
  .nav-links a[aria-current="page"],
  .nav-links a[aria-current="page"]:hover {
    background: var(--color-bg);
    color: var(--color-fg);
  }

  /* Search affordance — an icon toggle that rides inside the nav cluster, so
     it stays correctly placed in both header states without fighting the
     --header-progress transforms. The panel is a separate, absolutely-
     positioned dropdown (not inside .nav-links) so it doesn't inherit the
     cluster's translate. Dark chrome to match the header + the compact input. */
  .nav-search-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-header-fg-muted);
    cursor: pointer;
    padding: 0 0.35rem;
    margin-left: 0.15rem;
    align-self: stretch;
    transition: color var(--transition-base);
  }
  .nav-search-toggle:hover,
  .nav-search-toggle[aria-expanded="true"] {
    color: var(--color-header-fg);
  }
  .nav-search-toggle svg {
    width: 1.05rem;
    height: 1.05rem;
    display: block;
  }

  .header-search-panel {
    position: absolute;
    top: 100%;
    right: 1rem;
    width: min(24rem, calc(100vw - 2rem));
    margin-top: 0.5rem;
    padding: 0.85rem;
    background: var(--color-header-bg);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    z-index: 30;
    /* Cap height so long result lists scroll inside the panel rather than
       running off the viewport; contain scroll so it doesn't chain to body. */
    max-height: min(70vh, 32rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  /* Pagefind's defaults theme results for the cream page; inside the dark panel
     they'd render dark-on-dark. Flip the result text/background to the header
     palette so titles and excerpts stay legible. */
  .header-search-panel :global(.pagefind-ui) {
    --pagefind-ui-text: var(--color-header-fg);
    --pagefind-ui-background: var(--color-header-bg);
    --pagefind-ui-border: rgb(255 255 255 / 0.15);
  }
  .header-search-panel :global(.pagefind-ui__result-title a) {
    color: var(--color-header-fg);
  }
  .header-search-panel :global(.pagefind-ui__result-excerpt) {
    color: var(--color-header-fg-muted);
  }

  /* Softer footer underlines — global default uses --color-rule-strong */
  .site-footer a {
    text-decoration-color: var(--color-rule);
  }
</style>
