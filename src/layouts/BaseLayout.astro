---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '../styles/global.css';
import Search from '../components/Search.astro';
import { getImage } from 'astro:assets';
import logoFullSrc from '../assets/brand/logo-full.png';
import logoCoupeSrc from '../assets/brand/logo-coupe.png';

interface Props {
  title: string;
  description?: string;
  width?: 'prose' | 'wide';
}
const { title, description, width = 'prose' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const containerClass = width === 'wide' ? 'container-wide' : 'container-prose';

const logoFull = await getImage({ src: logoFullSrc, width: 228, height: 80, format: 'webp' });
const logoCoupe = await getImage({ src: logoCoupeSrc, width: 80, height: 80, format: 'webp' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header sticky top-0 z-10 border-b border-rule bg-bg">
      <div class="container-wide site-header-row">
        <a href={`${base}/`} class="brand inline-flex items-center no-underline" aria-label="Home Bartender">
          <picture>
            <source media="(max-width: 40rem)" srcset={logoCoupe.src} />
            <img src={logoFull.src} alt="" width={logoFull.attributes.width} height={logoFull.attributes.height} class="block h-10 w-auto" />
          </picture>
        </a>
        <nav class="nav-links flex gap-1 justify-center" aria-label="Primary">
          <a href={`${base}/`}>Recipes</a>
          <a href={`${base}/learn/`}>Learn</a>
        </nav>
        <div class="header-search justify-self-end w-[min(18rem,100%)]">
          <Search mode="compact" />
        </div>
      </div>
    </header>
    <main class={`${containerClass} flex-1 w-full pt-10 pb-16 lg:pt-12 lg:pb-20`}>
      <slot />
    </main>
    <footer class="site-footer border-t border-rule py-8 font-sans text-[0.8125rem] text-fg-muted text-center">
      <div class="container-wide">
        <p>
          Recipes shared under
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
          <a href="https://github.com/dancj/home-bartender">Framework on GitHub</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Sticky-blur header — backdrop-filter values are non-default in Tailwind */
  .site-header {
    backdrop-filter: saturate(180%) blur(8px);
  }
  .site-header-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.875rem;
  }
  .brand { border-radius: var(--radius-md); }

  /* Nav links — short scoped block keeps the hover/transition decisions
     in one place rather than spraying 6 utilities on each <a>. */
  .nav-links a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-fg-muted);
    text-decoration: none;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-base),
      color var(--transition-base);
  }
  .nav-links a:hover {
    color: var(--color-fg);
    background: var(--color-surface-muted);
  }

  /* Softer footer underlines — global default uses --color-rule-strong */
  .site-footer a {
    text-decoration-color: var(--color-rule);
  }

  /* Mobile layout: grid-template-areas can't be expressed cleanly in Tailwind */
  @media (max-width: 40rem) {
    .site-header-row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand nav"
        "search search";
      row-gap: 0.5rem;
    }
    .brand { grid-area: brand; }
    .nav-links { grid-area: nav; justify-content: flex-end; }
    .header-search { grid-area: search; width: 100%; }
  }
</style>
