---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header>
      <nav>
        <a href={`${base}/`}>Home Bartender</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Recipes shared under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Framework <a href="https://github.com/dancj/home-bartender">on GitHub</a>.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-accent: #2c4a3e;
    --color-soft: #f5f0e8;
    --color-muted: #8c7b6b;
    --color-rule: #ddd8cf;
    --color-text: #1a1a1a;
    --color-bg: #fefcf7;
    --font-serif: 'Newsreader', Georgia, serif;
    --font-sans: system-ui, -apple-system, sans-serif;
    --measure: 65ch;
  }

  * { box-sizing: border-box; }

  html { font-family: var(--font-serif); color: var(--color-text); background: var(--color-bg); line-height: 1.5; }
  body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; }

  main { flex: 1; max-width: var(--measure); margin: 0 auto; padding: 1.5rem 1rem; width: 100%; }

  header {
    border-bottom: 1px solid var(--color-rule);
    padding: 1rem;
  }
  header nav {
    max-width: var(--measure);
    margin: 0 auto;
  }
  header a {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.875rem;
  }

  footer {
    border-top: 1px solid var(--color-rule);
    padding: 1.5rem 1rem;
    font-size: 0.875rem;
    color: var(--color-muted);
    text-align: center;
  }
  footer a { color: var(--color-muted); }

  h1, h2, h3 { color: var(--color-accent); line-height: 1.2; }
  h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); margin-block: 0.5rem; }
  h2 { font-size: 1.25rem; margin-block-start: 2rem; }
  h3 { font-size: 1.1rem; }

  a { color: var(--color-accent); }
</style>
