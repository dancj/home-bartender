---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/newsreader/700.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header>
      <nav>
        <a href={`${base}/`} class="brand">Home Bartender</a>
        <div class="nav-links">
          <a href={`${base}/learn/`}>Learn</a>
          <a href={`${base}/search/`}>Search</a>
        </div>
        <div class="header-search"><Search mode="compact" /></div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Recipes shared under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. <a href="https://github.com/dancj/home-bartender">Framework on GitHub</a>.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-accent: #2c4a3e;
    --color-accent-soft: #3a5e51;
    --color-soft: #f5f0e8;
    --color-muted: #8c7b6b;
    --color-rule: #ddd8cf;
    --color-text: #1a1a1a;
    --color-bg: #fefcf7;
    --color-card: #ffffff;
    --shadow-card: 0 1px 2px rgba(28, 30, 25, 0.04);
    --shadow-card-hover: 0 6px 16px rgba(28, 30, 25, 0.08);

    --font-serif: 'Newsreader', Georgia, 'Times New Roman', serif;
    --font-sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

    --measure: 65ch;
    --radius: 6px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-accent: #98c7b3;
      --color-accent-soft: #b9d8c8;
      --color-soft: #2a2925;
      --color-muted: #968b7c;
      --color-rule: #383530;
      --color-text: #ece6da;
      --color-bg: #1a1916;
      --color-card: #21201c;
      --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.4);
      --shadow-card-hover: 0 6px 20px rgba(0, 0, 0, 0.5);
    }
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    font-family: var(--font-serif);
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.55;
    font-feature-settings: 'liga', 'kern', 'onum';
    -webkit-text-size-adjust: 100%;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    max-width: var(--measure);
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
    width: 100%;
  }

  header {
    border-bottom: 1px solid var(--color-rule);
    padding: 1rem 1.25rem;
    background: var(--color-bg);
  }
  header nav {
    max-width: var(--measure);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  header .brand {
    font-family: var(--font-serif);
    font-weight: 600;
    font-style: italic;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 1.125rem;
    letter-spacing: 0;
  }
  header .nav-links { display: flex; gap: 1.25rem; }
  header .nav-links a {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  header .nav-links a:hover { color: var(--color-accent); }
  header .header-search { flex: 0 1 16rem; min-width: 0; }
  @media (max-width: 38rem) {
    header .header-search { flex-basis: 100%; }
  }

  footer {
    border-top: 1px solid var(--color-rule);
    padding: 2rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-align: center;
  }
  footer a { color: var(--color-muted); text-decoration: underline; text-decoration-color: var(--color-rule); text-underline-offset: 2px; }
  footer a:hover { color: var(--color-accent); text-decoration-color: currentColor; }

  h1, h2, h3 {
    color: var(--color-accent);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-block: 0;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.875rem);
    font-weight: 700;
    margin-block: 0.25rem 0.5rem;
  }
  h2 {
    font-size: 1.375rem;
    font-weight: 600;
    margin-block-start: 2rem;
    margin-block-end: 0.5rem;
  }
  h3 {
    font-size: 1.125rem;
    font-weight: 600;
  }

  a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms;
  }
  a:hover { text-decoration-color: currentColor; }

  ::selection { background: var(--color-accent); color: var(--color-bg); }
</style>
