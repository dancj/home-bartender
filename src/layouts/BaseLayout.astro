---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/newsreader/700.css';
import '../styles/global.css';
import Search from '../components/Search.astro';
import { getImage } from 'astro:assets';
import logoFullSrc from '../assets/brand/logo-full.png';
import logoCoupeSrc from '../assets/brand/logo-coupe.png';

interface Props {
  title: string;
  description?: string;
  width?: 'prose' | 'wide';
}
const { title, description, width = 'prose' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const containerClass = width === 'wide' ? 'container-wide' : 'container-prose';

const logoFull = await getImage({ src: logoFullSrc, width: 228, height: 80, format: 'webp' });
const logoCoupe = await getImage({ src: logoCoupeSrc, width: 80, height: 80, format: 'webp' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <div class="container-wide site-header-row">
        <a href={`${base}/`} class="brand" aria-label="Home Bartender">
          <picture>
            <source media="(max-width: 42rem)" srcset={logoCoupe.src} />
            <img src={logoFull.src} alt="" width={logoFull.attributes.width} height={logoFull.attributes.height} />
          </picture>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={`${base}/`}>Recipes</a>
          <a href={`${base}/learn/`}>Learn</a>
        </nav>
        <div class="header-search">
          <Search mode="compact" />
        </div>
      </div>
    </header>
    <main class={containerClass}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container-wide">
        <p>
          Recipes shared under
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
          <a href="https://github.com/dancj/home-bartender">Framework on GitHub</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  main {
    flex: 1;
    width: 100%;
    padding-block: 2.5rem 4rem;
  }

  .site-header {
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: saturate(180%) blur(8px);
  }
  .site-header-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.875rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    border-radius: var(--radius-md);
  }
  .brand:focus-visible {
    outline: 2px solid var(--color-fg);
    outline-offset: 3px;
  }
  .brand img {
    display: block;
    height: 2.5rem;
    width: auto;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
    justify-content: center;
  }
  .nav-links a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-fg-muted);
    text-decoration: none;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-md);
    transition: background-color 120ms ease, color 120ms ease;
  }
  .nav-links a:hover {
    color: var(--color-fg);
    background: var(--color-surface-muted);
  }

  .header-search {
    justify-self: end;
    width: min(18rem, 100%);
  }

  @media (max-width: 42rem) {
    .site-header-row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand nav"
        "search search";
      row-gap: 0.5rem;
    }
    .brand { grid-area: brand; }
    .nav-links { grid-area: nav; justify-content: flex-end; }
    .header-search { grid-area: search; width: 100%; }
  }

  .site-footer {
    border-top: 1px solid var(--color-rule);
    padding-block: 2rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    text-align: center;
  }
  .site-footer a {
    text-decoration-color: var(--color-rule);
  }
</style>
