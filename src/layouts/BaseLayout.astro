---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/newsreader/700.css';
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
  width?: 'prose' | 'wide';
}
const { title, description, width = 'prose' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const containerClass = width === 'wide' ? 'container-wide' : 'container-prose';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <div class="container-wide site-header-row">
        <a href={`${base}/`} class="brand">Home Bartender</a>
        <nav class="nav-links" aria-label="Primary">
          <a href={`${base}/`}>Recipes</a>
          <a href={`${base}/learn/`}>Learn</a>
        </nav>
        <div class="header-search">
          <Search mode="compact" />
        </div>
      </div>
    </header>
    <main class={containerClass}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container-wide">
        <p>
          Recipes shared under
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
          <a href="https://github.com/dancj/home-bartender">Framework on GitHub</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  main {
    flex: 1;
    width: 100%;
    padding-block: 2.5rem 4rem;
  }

  .site-header {
    border-bottom: 1px solid hsl(var(--rule));
    background: hsl(var(--bg));
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: saturate(180%) blur(8px);
  }
  .site-header-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.875rem;
  }

  .brand {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.0625rem;
    color: hsl(var(--fg));
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
    justify-content: center;
  }
  .nav-links a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: hsl(var(--fg-muted));
    text-decoration: none;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-md);
    transition: background-color 120ms ease, color 120ms ease;
  }
  .nav-links a:hover {
    color: hsl(var(--fg));
    background: hsl(var(--surface-muted));
  }

  .header-search {
    justify-self: end;
    width: min(18rem, 100%);
  }

  @media (max-width: 42rem) {
    .site-header-row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand nav"
        "search search";
      row-gap: 0.5rem;
    }
    .brand { grid-area: brand; }
    .nav-links { grid-area: nav; justify-content: flex-end; }
    .header-search { grid-area: search; width: 100%; }
  }

  .site-footer {
    border-top: 1px solid hsl(var(--rule));
    padding-block: 2rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: hsl(var(--fg-muted));
    text-align: center;
  }
  .site-footer a {
    text-decoration-color: hsl(var(--rule));
  }
</style>
