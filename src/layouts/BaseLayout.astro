---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import logoFullSrc from '../assets/brand/logo-full.png';
import logoCoupeSrc from '../assets/brand/logo-coupe.png';

interface Props {
  title: string;
  description?: string;
  width?: 'prose' | 'wide';
}
const { title, description, width = 'prose' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const containerClass = width === 'wide' ? 'container-wide' : 'container-prose';

const path = Astro.url.pathname;
const isLearn = path.startsWith(`${base}/learn`);
const navLinks = [
  { href: `${base}/`, label: 'Recipes', current: !isLearn },
  { href: `${base}/learn/`, label: 'Learn', current: isLearn },
];

// Generate at high density so both header states stay crisp on retina; CSS
// scales these down. The wordmark renders at its native source width (1024px)
// — its largest on-screen use is the full-width mobile hero, and the 1024×360
// source can't be upscaled past that without softening. The coupe only ever
// shows small (the ~64px collapsed icon), so 256px gives comfortable 2–4×.
const logoFull = await getImage({ src: logoFullSrc, width: 1024, height: 360, format: 'webp' });
const logoCoupe = await getImage({ src: logoCoupeSrc, width: 256, height: 256, format: 'webp' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header sticky top-0 z-10 bg-header-bg">
      <div class="container-wide site-header-row">
        <a href={`${base}/`} class="brand inline-flex items-center no-underline" aria-label="Home Bartender">
          <picture>
            <source media="(max-width: 40rem)" srcset={logoCoupe.src} />
            <img src={logoFull.src} alt="" width={logoFull.attributes.width} height={logoFull.attributes.height} class="brand-img block" />
          </picture>
        </a>
        <nav class="nav-links flex" aria-label="Primary">
          {navLinks.map(link => (
            <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class={`${containerClass} flex-1 w-full pt-10 pb-16 lg:pt-12 lg:pb-20`}>
      <slot />
    </main>
    <footer class="site-footer border-t border-rule py-8 font-sans text-[0.8125rem] text-fg-muted text-center">
      <div class="container-wide">
        <p>
          Recipes shared under
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
          <a href="https://github.com/dancj/home-bartender">Framework on GitHub</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Sticky-blur header — backdrop-filter values are non-default in Tailwind */
  .site-header {
    backdrop-filter: saturate(180%) blur(8px);
  }
  .site-header-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  /* Logo is flush with the header chrome — image height defines the row height.
     Width is pinned explicitly per breakpoint because <picture> swaps the
     source srcset on mobile but the <img> keeps the desktop ratio attrs. */
  .brand { border-radius: 0; }
  .brand-img { height: 4rem; width: calc(4rem * 228 / 80); object-fit: contain; }

  /* Mobile: square coupe + push the tab cluster to the right edge. */
  @media (max-width: 40rem) {
    .brand-img { width: 4rem; }
    .nav-links { margin-left: auto; }
  }

  /* Folder-tab nav — each link is a cream-filled tab that sits flush with
     the bottom of the dark header chrome and visually merges into the page
     below. Top corners round; bottom corners are square so the tab "opens"
     into the page surface. */
  .nav-links {
    align-self: end;
    gap: 0.25rem;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    /* Inactive tabs are orange so they read as "other folders" sitting in the
       chrome; the active tab matches the page bg and visually continues it. */
    background: var(--color-accent);
    color: var(--color-accent-fg);
    text-decoration: none;
    padding: 0.5rem 1.1rem 0.55rem;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    transition: background-color var(--transition-base),
      color var(--transition-base);
  }
  .nav-links a:hover {
    background: color-mix(in srgb, var(--color-accent), white 8%);
  }
  .nav-links a[aria-current="page"],
  .nav-links a[aria-current="page"]:hover {
    background: var(--color-bg);
    color: var(--color-fg);
  }

  /* Softer footer underlines — global default uses --color-rule-strong */
  .site-footer a {
    text-decoration-color: var(--color-rule);
  }
</style>
