---
import BaseLayout from './BaseLayout.astro';
import type { Recipe } from '../lib/recipes';
import { label } from '../lib/taxonomy';
import Ingredients from '../components/recipe/Ingredients.astro';
import Steps from '../components/recipe/Steps.astro';
import HouseMade from '../components/recipe/HouseMade.astro';
import BatchInstructions from '../components/recipe/BatchInstructions.astro';
import Icon from '../components/Icon.astro';
import { iconUrl } from '../lib/icon-urls';

interface Props {
  recipe: Recipe;
}
const { recipe } = Astro.props;
const { data } = recipe;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasAttribution =
  data.attribution.creator || data.attribution.bar || data.attribution.year;

// Markdown-rendered headings (## Notes, ## Variations) can't host the Icon
// component — their icons ride in via ::before masks fed by these custom
// properties on .recipe-body.
const mdHeadingIcons = [
  ['--icon-notes', iconUrl('sections', 'notes')],
  ['--icon-variations', iconUrl('sections', 'variations')],
]
  .filter(([, url]) => url)
  .map(([prop, url]) => `${prop}: url("${url}")`)
  .join('; ');
---
<BaseLayout title={`${data.title} — Home Bartender`} description={data.blurb}>
  <article data-pagefind-body>
    <header class="recipe-header">
      <p class="back">
        <a href={`${base}/`}>← All recipes</a>
      </p>
      <h1>{data.title}</h1>
      <p class="blurb">{data.blurb}</p>

      <dl class="facts">
        {data.families.length > 0 && (
          <div>
            <dt class="eyebrow">Family</dt>
            <dd>
              {data.families.map((f: string, i: number) => (
                <>
                  {i > 0 && <span class="note"> · </span>}
                  <Icon field="family" slug={f} />
                  <a href={`${base}/by-family/${f}/`}>{label('family', f)}</a>
                </>
              ))}
            </dd>
          </div>
        )}
        <div>
          <dt class="eyebrow">Glass</dt>
          <dd>
            <Icon field="glass" slug={data.glass} />
            {label('glass', data.glass)}
            {data.glass_note && <span class="note">· {data.glass_note}</span>}
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Method</dt>
          <dd>
            <Icon field="method" slug={data.method} />
            {label('method', data.method)}
            {data.method_note && <span class="note">· {data.method_note}</span>}
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Ice</dt>
          <dd>
            <Icon field="ice" slug={data.ice} />
            {label('ice', data.ice)}
            {data.ice_note && <span class="note">· {data.ice_note}</span>}
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Difficulty</dt>
          <dd><Icon field="difficulty" slug={data.difficulty} /> {label('difficulty', data.difficulty)}</dd>
        </div>
      </dl>

      {(data.flavors.length > 0 || data.spirits.length > 0) && (
        <div class="taxonomy">
          {data.spirits.length > 0 && (
            <ul class="tags" aria-label="Spirits">
              {data.spirits.map((s: string) => (
                <li>
                  <a href={`${base}/by-spirit/${s}/`} class="chip chip-spirit">
                    <Icon field="spirits" slug={s} /> {label('spirits', s)}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {data.flavors.length > 0 && (
            <ul class="tags" aria-label="Flavors">
              {data.flavors.map((f: string) => (
                <li>
                  <a href={`${base}/by-flavor/${f}/`} class="chip">
                    <Icon field="flavor" slug={f} /> {label('flavor', f)}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )}
    </header>

    <div class="recipe-body" style={mdHeadingIcons || undefined}>
      {data.ingredients.length > 0 && (
        <Ingredients items={data.ingredients} garnish={data.garnish} float={data.float} />
      )}
      {data.house_made && <HouseMade {...data.house_made} />}
      {data.steps.length > 0 && <Steps items={data.steps} />}
      {data.batch && <BatchInstructions {...data.batch} />}
      <slot />
    </div>

    {hasAttribution && (
      <aside class="attribution" data-pagefind-ignore>
        <h2 class="aside-title">Attribution</h2>
        <p>
          {data.attribution.creator && <>Created by <strong>{data.attribution.creator}</strong></>}
          {data.attribution.bar && <> at <strong>{data.attribution.bar}</strong></>}
          {data.attribution.year && <> in {data.attribution.year}</>}.
          {data.attribution.source_url && <> <a href={data.attribution.source_url} rel="noopener">Source</a></>}
        </p>
      </aside>
    )}

    {data.related.length > 0 && (
      <aside class="related">
        <h2 class="aside-title"><Icon field="sections" slug="related" /> Related</h2>
        <ul>
          {data.related.map((slug: string) => (
            <li><a href={`${base}/recipes/${slug}/`}>{slug.replace(/-/g, ' ')}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .recipe-header {
    margin-bottom: 2rem;
  }

  .back {
    margin-bottom: 1rem;
  }
  .back a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--color-fg);
  }

  .recipe-header h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin-bottom: 0.5rem;
  }

  .blurb {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1875rem;
    color: var(--color-fg-muted);
    line-height: 1.4;
    margin-bottom: 1.5rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.85rem 1.5rem;
    margin: 0;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
  }
  .facts > div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-fg);
  }
  .facts dd .tax-icon {
    --icon-size: 1.15rem;
    margin-right: 0.3rem;
    vertical-align: -0.22em;
    color: var(--color-fg-muted);
  }
  .facts .note {
    color: var(--color-fg-muted);
    margin-left: 0.25rem;
    font-style: italic;
  }
  .facts dd a {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--color-rule-strong);
  }
  .facts dd a:hover {
    text-decoration-color: var(--color-fg);
  }

  .taxonomy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 1.25rem;
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip-spirit {
    background: var(--color-surface-muted);
    color: var(--color-fg);
    border-color: var(--color-rule-strong);
    font-weight: 600;
  }

  .recipe-body :global(h2) {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg-muted);
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .recipe-body :global(h2:first-child) {
    margin-top: 1.5rem;
  }
  /* Section-heading icons: one visual treatment whether the icon comes
     from the Icon component (component-rendered sections) or the ::before
     mask (markdown-rendered ## Notes / ## Variations). */
  .recipe-body :global(h2 .tax-icon) {
    --icon-size: 1.5em;
    margin-right: 0.4em;
    vertical-align: -0.4em;
  }
  .recipe-body :global(h2#notes)::before,
  .recipe-body :global(h2#variations)::before {
    content: '';
    display: inline-block;
    width: 1.5em;
    height: 1.5em;
    margin-right: 0.4em;
    vertical-align: -0.4em;
    background-color: currentColor;
    -webkit-mask: var(--md-icon) center / contain no-repeat;
    mask: var(--md-icon) center / contain no-repeat;
  }
  .recipe-body :global(h2#notes)::before {
    --md-icon: var(--icon-notes);
  }
  .recipe-body :global(h2#variations)::before {
    --md-icon: var(--icon-variations);
  }
  .recipe-body :global(p .tax-icon.inline-icon) {
    --icon-size: 1.1em;
    margin-right: 0.15em;
    vertical-align: -0.18em;
    color: var(--color-fg-muted);
  }
  .recipe-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 1.25rem 0 0.5rem;
  }
  .recipe-body :global(p),
  .recipe-body :global(li) {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-fg);
  }
  .recipe-body :global(p) {
    margin-block: 0.75rem;
  }
  .recipe-body :global(ul),
  .recipe-body :global(ol) {
    margin-block: 0.5rem;
    padding-inline-start: 1.25rem;
  }
  .recipe-body :global(li) {
    margin-block: 0.3rem;
  }
  .recipe-body :global(em) {
    color: var(--color-fg-muted);
  }
  .recipe-body :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }
  .recipe-body :global(hr) {
    display: none;
  }

  .attribution,
  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-fg-muted);
  }
  .aside-title {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg-muted);
    margin: 0 0 0.5rem;
  }
  .aside-title .tax-icon {
    --icon-size: 1.5em;
    margin-right: 0.35em;
    vertical-align: -0.4em;
  }
  .attribution strong {
    color: var(--color-fg);
    font-weight: 600;
  }
  .related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .related li a {
    text-transform: capitalize;
    text-decoration: none;
  }
  .related li a {
    display: inline-flex;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    transition: border-color 120ms ease, color 120ms ease;
  }
  .related li a:hover {
    border-color: var(--color-rule-strong);
    color: var(--color-fg);
  }
</style>
