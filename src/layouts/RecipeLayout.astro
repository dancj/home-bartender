---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import type { Recipe } from '../lib/recipes';
import { publishedRecipes } from '../lib/recipes';
import { resolveRelated } from '../lib/related';
import RecipeCard from '../components/RecipeCard.astro';
import { label } from '../lib/taxonomy';
import { spiritAccentVar, flavorAccentVar } from '../lib/accents';
import { iconUrl } from '../lib/icon-urls';
import Ingredients from '../components/recipe/Ingredients.astro';
import Steps from '../components/recipe/Steps.astro';
import HouseMade from '../components/recipe/HouseMade.astro';
import BatchInstructions from '../components/recipe/BatchInstructions.astro';
import { buildTabList, type TabId } from '../scripts/recipeTabs';

interface Props {
  recipe: Recipe;
}
const { recipe } = Astro.props;
const { data } = recipe;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Trim so whitespace-only fields don't render a phantom Source tab / dead link.
const creator = data.attribution.creator.trim();
const bar = data.attribution.bar.trim();
const year = data.attribution.year.trim();
const sourceUrl = data.attribution.source_url.trim();
const hasAttribution = creator || bar || year;

// Refresh: identity (spirit accent, category), photo rail, and root callout.
const primarySpirit = data.spirits[0];
const accent = spiritAccentVar(primarySpirit);
const primaryRoot = data.roots[0];
const hasHero = Boolean(data.hero_image);
const glassIcon = iconUrl('glass', data.glass);
// Ingredient illustrations (the gallery field) render inside the recipe,
// between ingredients and steps. The rail holds only the hero.
const galleryItems = (data.gallery ?? []).slice(0, 2);

// Resolve related[] slugs to full recipes so cards render real titles instead
// of de-slugged text. Order follows the related[] list (see resolveRelated).
const relatedRecipes =
  data.related.length > 0 ? resolveRelated(await publishedRecipes(), data.related) : [];

// The markdown body (## Notes / ## Variations / tasting notes) is the Notes
// tab. Capture it now — Astro.slots.render consumes the default slot, so the
// Notes panel re-emits it via set:html rather than a second <slot />. An empty
// body means no Notes tab.
const notesHtml = (await Astro.slots.render('default')).trim();
// Measure visible text, not raw length: a body that renders to only a comment,
// an <hr>, or &nbsp; is empty in practice and must not spawn an empty Notes tab.
const hasNotes =
  notesHtml
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/<[^>]*>/g, '')
    .replace(/&nbsp;/g, '')
    .trim().length > 0;
const hasBatch = !!data.batch;
// Source tab renders for any attribution, including a lone source_url link
// (hasAttribution only covers creator/bar/year).
const hasSource = Boolean(hasAttribution) || Boolean(sourceUrl);

// Which tabs exist, in fixed order. Panels are namespaced `panel-<id>` so the
// Notes panel id can't collide with the markdown `## Notes` heading slug.
const tabIds = buildTabList({ hasBatch, hasNotes, hasSource });
const tabLabels: Record<TabId, string> = {
  recipe: 'Recipe',
  batching: 'Batching',
  notes: 'Notes',
  source: 'Source',
};
const isTabbed = tabIds.length > 1;
---
<BaseLayout title={`${data.title} — Home Bartending`} description={data.blurb}>
  <article data-pagefind-body>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href={`${base}/`}>Recipes</a></li>
        <li aria-current="page">{data.title}</li>
      </ol>
    </nav>

    <div class="detail-grid" style={`--accent: ${accent}`}>
      {/* Left: sticky photo rail. Fallback tile until hero_image exists. */}
      <div class="detail-rail">
        <div class:list={['detail-hero', !hasHero && 'detail-hero--empty']}>
          {data.hero_image ? (
            <Image
              src={data.hero_image}
              alt={data.title}
              widths={[300, 600, 900]}
              sizes="(min-width: 700px) 40vw, 90vw"
              loading="eager"
              decoding="async"
            />
          ) : (
            <>
              {glassIcon && (
                <span class="tax-icon tile-icon" style={`--icon-url: url("${glassIcon}")`} aria-hidden="true"></span>
              )}
              {primarySpirit && <span class="tile-name">{label('spirits', primarySpirit)}</span>}
            </>
          )}
        </div>
      </div>

      {/* Right: identity, facts, tabs, root callout. */}
      <div class="detail-main">
        <p class="detail-eyebrow">
          {primarySpirit && <>{label('spirits', primarySpirit)}</>}
          {primarySpirit && <> · </>}{label('category', data.category)}
        </p>
        <h1 class="detail-title">{data.title}</h1>
        <p class="detail-lede">{data.blurb}</p>

        <div class="facts-grid">
          <div class="fact-cell">
            <span class="fact-label">Glass</span>
            <span class="fact-value">{label('glass', data.glass)}{data.glass_note && <span class="fact-note"> {data.glass_note}</span>}</span>
          </div>
          <div class="fact-cell">
            <span class="fact-label">Method</span>
            <span class="fact-value">{label('method', data.method)}{data.method_note && <span class="fact-note"> {data.method_note}</span>}</span>
          </div>
          <div class="fact-cell">
            <span class="fact-label">Ice</span>
            <span class="fact-value">{label('ice', data.ice)}{data.ice_note && <span class="fact-note"> {data.ice_note}</span>}</span>
          </div>
        </div>

        {data.flavors.length > 0 && (
          <ul class="flavor-chips" aria-label="Flavors">
            {data.flavors.map((f: string) => (
              <li>
                <a href={`${base}/by-flavor/${f}/`} class="chip flavor-chip" style={`--accent: ${flavorAccentVar(f)}`}>
                  <span class="chip-dot" aria-hidden="true"></span> {label('flavor', f)}
                </a>
              </li>
            ))}
          </ul>
        )}

        {/* Pre-paint guard: hide non-default panels before the island runs so JS
            users don't see all panels flash then collapse. Removed by the island
            on init; absent with JS off so the no-JS stack stays intact. */}
        {isTabbed && <script is:inline>document.documentElement.classList.add('js-tabs');</script>}

        <div class="recipe-tabs" data-recipe-tabs>
          {isTabbed && (
            <nav class="recipe-tablist" aria-label="Recipe sections">
              {tabIds.map((id) => (
                <a class="recipe-tab" href={`#panel-${id}`} id={`tab-${id}`} data-tab-link={id}>
                  {tabLabels[id]}
                </a>
              ))}
            </nav>
          )}

          <section class="recipe-tabpanel recipe-body" id="panel-recipe" data-tab="recipe" data-default>
            {data.ingredients.length > 0 && (
              <Ingredients items={data.ingredients} garnish={data.garnish} float={data.float} />
            )}
            {galleryItems.map((img) => (
              <figure class="ingredients-art">
                <Image
                  src={img}
                  alt={`Ingredients for ${data.title}`}
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 700px) 40vw, 90vw"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
            {data.house_made && <HouseMade {...data.house_made} />}
            {data.steps.length > 0 && <Steps items={data.steps} />}
          </section>

          {data.batch && (
            <section class="recipe-tabpanel recipe-body" id="panel-batching" data-tab="batching">
              <BatchInstructions {...data.batch} />
            </section>
          )}

          {hasNotes && (
            <section
              class="recipe-tabpanel recipe-body"
              id="panel-notes"
              data-tab="notes"
            >
              <Fragment set:html={notesHtml} />
            </section>
          )}

          {hasSource && (
            <section class="recipe-tabpanel source-panel" id="panel-source" data-tab="source" data-pagefind-ignore>
              <h2 class="aside-title">Attribution</h2>
              <p>
                {hasAttribution && (
                  <>
                    {creator && <>Created by <strong>{creator}</strong></>}
                    {bar && <> at <strong>{bar}</strong></>}
                    {year && <> in {year}</>}.
                  </>
                )}
                {sourceUrl && <> <a href={sourceUrl} rel="noopener">Source</a></>}
              </p>
            </section>
          )}
        </div>

        {primaryRoot && (
          <div class="root-callout">
            <div class="root-callout-text">
              <span class="root-callout-eyebrow">Root</span>
              <span class="root-callout-name">{label('root', primaryRoot)}</span>
            </div>
            <a href={`${base}/by-root/${primaryRoot}/`} class="root-callout-link">See the family →</a>
          </div>
        )}
      </div>
    </div>

    {relatedRecipes.length > 0 && (
      <aside class="related">
        <h2 class="aside-title">Related</h2>
        <ul class="recipe-grid">
          {relatedRecipes.map((r) => <RecipeCard recipe={r} />)}
        </ul>
      </aside>
    )}
  </article>
</BaseLayout>

<script>
  import { resolveActiveTab, nextTabIndex } from '../scripts/recipeTabs';

  const root = document.querySelector<HTMLElement>('[data-recipe-tabs]');
  const tablist = root?.querySelector<HTMLElement>('.recipe-tablist');
  const tabs = tablist
    ? Array.from(tablist.querySelectorAll<HTMLAnchorElement>('[data-tab-link]'))
    : [];
  const panels = root
    ? Array.from(root.querySelectorAll<HTMLElement>('.recipe-tabpanel'))
    : [];
  const ids = panels.map((p) => p.dataset.tab ?? '');

  // Only wire the tab widget when there's a real choice. Single-panel recipes
  // stay plain <section> stacks — no tab roles, no orphan tabpanel.
  if (tablist && tabs.length > 0 && panels.length > 1) {
    // Add the ARIA that was deliberately kept out of the static HTML, so JS-off
    // / pre-hydration users never see a tab widget whose contract isn't met.
    tablist.setAttribute('role', 'tablist');
    tabs.forEach((t) => {
      t.setAttribute('role', 'tab');
      t.setAttribute('aria-controls', `panel-${t.dataset.tabLink}`);
    });
    panels.forEach((p) => {
      p.setAttribute('role', 'tabpanel');
      p.setAttribute('aria-labelledby', `tab-${p.dataset.tab}`);
      p.tabIndex = 0;
    });

    // A hash may target a heading *inside* a panel (a Pagefind sub-result like
    // #storage) rather than a panel. Map it to its owning panel via closest(),
    // and keep the heading element so we can scroll to it once the panel shows.
    const resolveTarget = (hash: string): { id: string; heading: HTMLElement | null } => {
      const clean = hash.replace(/^#/, '');
      const el = clean ? document.getElementById(clean) : null;
      const owner = el?.closest<HTMLElement>('.recipe-tabpanel');
      if (owner && owner.dataset.tab && ids.includes(owner.dataset.tab)) {
        // el is the panel itself for a #panel-<id> hash; only a sub-heading scrolls.
        return { id: owner.dataset.tab, heading: el === owner ? null : el };
      }
      return { id: resolveActiveTab(hash, ids), heading: null };
    };

    const activate = (id: string, focusPanel = false) => {
      panels.forEach((p) => {
        p.hidden = p.dataset.tab !== id;
      });
      tabs.forEach((t) => {
        const selected = t.dataset.tabLink === id;
        t.setAttribute('aria-selected', String(selected));
        t.tabIndex = selected ? 0 : -1;
      });
      if (focusPanel) {
        panels.find((p) => p.dataset.tab === id)?.focus();
      }
    };

    // Show the panel a hash targets, then bring its sub-heading into view — the
    // panel was display:none at parse, so the browser's native fragment scroll
    // no-oped and must be replayed once the panel is visible.
    const activateFromHash = (hash: string, focusPanel: boolean) => {
      const { id, heading } = resolveTarget(hash);
      activate(id, focusPanel && !heading);
      heading?.scrollIntoView();
    };

    // Hand authority from the pre-paint CSS guard to the hidden attribute in one
    // synchronous pass, so a deep-linked non-default panel never flickers hidden.
    document.documentElement.classList.remove('js-tabs');
    activateFromHash(location.hash, false);

    // Select a tab: show its panel, sync the URL, and move focus to it.
    const selectTab = (t: HTMLAnchorElement) => {
      const id = t.dataset.tabLink!;
      activate(id);
      history.replaceState(null, '', `#panel-${id}`);
      t.focus();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', (e) => {
        e.preventDefault();
        selectTab(t);
      });
      t.addEventListener('keydown', (e) => {
        const next = nextTabIndex(e.key, i, tabs.length);
        if (next < 0) return;
        e.preventDefault();
        selectTab(tabs[next]);
      });
    });

    // Pagefind result clicks and cross-recipe #panel-batching / #heading links
    // change the hash without a tab click — re-resolve and move focus so the
    // swap is announced.
    window.addEventListener('hashchange', () => {
      activateFromHash(location.hash, true);
    });
  }
</script>

<style>
  /* ── Breadcrumb ───────────────────────────────────────────────────────── */
  .breadcrumb {
    margin-bottom: 22px;
  }
  .breadcrumb a {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* ── Two-column layout: sticky photo rail + identity/facts/tabs ───────── */
  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    align-items: start;
  }
  .detail-rail {
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: sticky;
    top: 5rem; /* clears the compact collapsing header (--hb-compact 4rem) */
    align-self: start;
  }
  /* Below the two-column breakpoint the rail stacks above the content, so drop
     the stickiness (a sticky first row would trap scroll on mobile). */
  @media (max-width: 700px) {
    .detail-rail {
      position: static;
    }
  }
  .detail-hero {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-hero);
    overflow: hidden;
    box-shadow: var(--shadow-hero);
    background: var(--color-surface-muted);
  }
  .detail-hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .detail-hero--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .detail-hero--empty .tile-icon {
    --icon-size: 84px;
    color: var(--accent);
    opacity: 0.55;
  }
  .detail-hero--empty .tile-name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    color: var(--accent);
    opacity: 0.75;
  }
  /* Ingredient illustration inside the recipe tab: shown whole at its own
     shape (hand-drawn art, possibly transparent), no crop or card chrome. */
  .ingredients-art {
    margin: 0;
  }
  .ingredients-art img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-photo);
  }

  .detail-main {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .detail-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .detail-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.25rem, 5vw, 3.375rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: -14px 0 -14px; /* absorb the flex gap around the eyebrow/lede */
  }
  .detail-lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    line-height: 1.5;
    color: var(--color-fg-muted);
    max-width: 44ch;
  }

  /* Hairline facts grid — 1px gaps on a rule-coloured backdrop read as single
     rules between cells (no per-cell borders). No icons (they were the cut). */
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-facts);
    overflow: hidden;
  }
  .fact-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    background: var(--color-surface);
  }
  .fact-label {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .fact-value {
    font-family: var(--font-serif);
    font-size: 19px;
    color: var(--color-fg);
  }
  .fact-note {
    color: var(--color-fg-muted);
    font-style: italic;
  }

  /* Flavor chips — shared .chip shape, inactive, each with an accent dot. */
  .flavor-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .flavor-chip {
    gap: 7px;
    padding: 7px 15px;
    font-size: 13px;
  }

  /* ── Tabs (chrome only; logic/ARIA live in the island above) ──────────── */
  .recipe-tabs {
    margin-top: 0;
  }
  .recipe-tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.625rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-sans);
  }
  .recipe-tab {
    padding: 0 0 12px;
    margin-bottom: -1px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg-subtle);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .recipe-tab:hover {
    color: var(--color-fg);
  }
  .recipe-tab[aria-selected='true'] {
    color: var(--color-fg);
    border-bottom-color: var(--color-accent);
  }
  .recipe-tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .recipe-tabpanel:focus {
    outline: none;
  }
  .recipe-tabpanel:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  /* Pre-paint guard (see the is:inline above). The island removes .js-tabs on
     init and takes over via [hidden]. Absent with JS off — the full stack shows. */
  :global(html.js-tabs) .recipe-tabpanel:not([data-default]) {
    display: none;
  }

  /* Section headings inside the body: uppercase eyebrows, no line icons (the
     jigger/ordered-list header marks are dropped on this screen). */
  .recipe-body :global(h2) {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-subtle);
    margin: 2rem 0 1rem;
  }
  .recipe-body :global(h2:first-child) {
    margin-top: 0.5rem;
  }
  .recipe-body :global(h2 .tax-icon) {
    display: none;
  }

  .recipe-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 1.25rem 0 0.5rem;
  }
  .recipe-body :global(p),
  .recipe-body :global(li) {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-fg);
  }
  .recipe-body :global(p) {
    margin-block: 0.75rem;
  }
  .recipe-body :global(em) {
    color: var(--color-fg-muted);
  }
  .recipe-body :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }
  .recipe-body :global(hr) {
    display: none;
  }

  /* Recipe tab: ingredient rows as hairline-separated lines; steps as numbered
     accent-soft circles. Scoped to #panel-recipe so Notes/Variations lists in
     the markdown body keep normal list styling. */
  :global(#panel-recipe) ul {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
  }
  :global(#panel-recipe) ul > li {
    padding: 11px 0;
    border-bottom: 1px solid var(--color-rule-ingredient);
    line-height: 1.45;
  }
  :global(#panel-recipe) ol {
    list-style: none;
    counter-reset: step;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  :global(#panel-recipe) ol > li {
    counter-increment: step;
    display: flex;
    gap: 14px;
    margin: 0;
    line-height: 1.45;
  }
  :global(#panel-recipe) ol > li::before {
    content: counter(step);
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Batching tab body: plainer sans instructions under the ingredient rows. */
  :global(#panel-batching) ul {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
  }
  :global(#panel-batching) ul > li {
    padding: 11px 0;
    border-bottom: 1px solid var(--color-rule-ingredient);
  }

  /* Source tab — attribution prose. */
  .source-panel {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-fg-muted);
  }
  .source-panel p {
    margin: 0.5rem 0 0;
  }
  .source-panel strong {
    color: var(--color-fg);
    font-weight: 600;
  }

  /* ── Root callout ─────────────────────────────────────────────────────── */
  .root-callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    background: var(--color-header-bg);
    color: var(--color-header-fg);
    border-radius: var(--radius-callout);
    padding: 24px 26px;
  }
  .root-callout-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .root-callout-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-header-fg-muted);
  }
  .root-callout-name {
    font-family: var(--font-serif);
    font-size: 24px;
  }
  .root-callout-link {
    flex: none;
    background: var(--color-accent);
    color: var(--color-accent-fg);
    border-radius: 999px;
    padding: 10px 20px;
    font-family: var(--font-sans);
    font-size: 13.5px;
    text-decoration: none;
  }
  .root-callout-link:hover {
    background: color-mix(in srgb, var(--color-accent), white 8%);
  }

  /* ── Related (full width, below the two-column grid) ──────────────────── */
  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
  }
  .aside-title {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg-muted);
    margin: 0 0 0.5rem;
