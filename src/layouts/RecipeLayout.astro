---
import BaseLayout from './BaseLayout.astro';
import type { Recipe } from '../lib/recipes';
import { publishedRecipes } from '../lib/recipes';
import { resolveRelated } from '../lib/related';
import RecipeCard from '../components/RecipeCard.astro';
import { label } from '../lib/taxonomy';
import Ingredients from '../components/recipe/Ingredients.astro';
import Steps from '../components/recipe/Steps.astro';
import HouseMade from '../components/recipe/HouseMade.astro';
import BatchInstructions from '../components/recipe/BatchInstructions.astro';
import Icon from '../components/Icon.astro';
import { iconUrl } from '../lib/icon-urls';
import { buildTabList, type TabId } from '../scripts/recipeTabs';

interface Props {
  recipe: Recipe;
}
const { recipe } = Astro.props;
const { data } = recipe;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Trim so whitespace-only fields don't render a phantom Source tab / dead link.
const creator = data.attribution.creator.trim();
const bar = data.attribution.bar.trim();
const year = data.attribution.year.trim();
const sourceUrl = data.attribution.source_url.trim();
const hasAttribution = creator || bar || year;

// Resolve related[] slugs to full recipes so cards render real titles instead
// of de-slugged text. Order follows the related[] list (see resolveRelated).
const relatedRecipes =
  data.related.length > 0 ? resolveRelated(await publishedRecipes(), data.related) : [];

// Markdown-rendered headings (## Notes, ## Variations) can't host the Icon
// component — their icons ride in via ::before masks fed by these custom
// properties, set on the Notes panel (.recipe-body) below.
const mdHeadingIcons = [
  ['--icon-notes', iconUrl('sections', 'notes')],
  ['--icon-variations', iconUrl('sections', 'variations')],
]
  .filter(([, url]) => url)
  .map(([prop, url]) => `${prop}: url("${url}")`)
  .join('; ');

// The markdown body (## Notes / ## Variations / tasting notes) is the Notes
// tab. Capture it now — Astro.slots.render consumes the default slot, so the
// Notes panel re-emits it via set:html rather than a second <slot />. An empty
// body means no Notes tab.
const notesHtml = (await Astro.slots.render('default')).trim();
// Measure visible text, not raw length: a body that renders to only a comment,
// an <hr>, or &nbsp; is empty in practice and must not spawn an empty Notes tab.
const hasNotes =
  notesHtml
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/<[^>]*>/g, '')
    .replace(/&nbsp;/g, '')
    .trim().length > 0;
const hasBatch = !!data.batch;
// Source tab renders for any attribution, including a lone source_url link
// (hasAttribution only covers creator/bar/year).
const hasSource = Boolean(hasAttribution) || Boolean(sourceUrl);

// Which tabs exist, in fixed order. Panels are namespaced `panel-<id>` so the
// Notes panel id can't collide with the markdown `## Notes` heading slug.
const tabIds = buildTabList({ hasBatch, hasNotes, hasSource });
const tabLabels: Record<TabId, string> = {
  recipe: 'Recipe',
  batching: 'Batching',
  notes: 'Notes',
  source: 'Source',
};
const isTabbed = tabIds.length > 1;
---
<BaseLayout title={`${data.title} — Home Bartending`} description={data.blurb}>
  <article data-pagefind-body>
    <header class="recipe-header">
      <p class="back">
        <a href={`${base}/`}>← All recipes</a>
      </p>
      <h1>{data.title}</h1>
      <p class="blurb">{data.blurb}</p>

      <dl class="facts">
        {data.roots.length > 0 && (
          <div>
            <dt class="eyebrow">Root</dt>
            <dd class="fact-stack">
              {data.roots.map((f: string) => (
                <span class="fact-line">
                  <Icon field="root" slug={f} />
                  <span class="fact-text">
                    <a href={`${base}/by-root/${f}/`}>{label('root', f)}</a>
                  </span>
                </span>
              ))}
            </dd>
          </div>
        )}
        <div>
          <dt class="eyebrow">Glass</dt>
          <dd>
            <Icon field="glass" slug={data.glass} />
            <span class="fact-text">
              {label('glass', data.glass)}
              {data.glass_note && <span class="note">· {data.glass_note}</span>}
            </span>
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Method</dt>
          <dd>
            <Icon field="method" slug={data.method} />
            <span class="fact-text">
              {label('method', data.method)}
              {data.method_note && <span class="note">· {data.method_note}</span>}
            </span>
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Ice</dt>
          <dd>
            <Icon field="ice" slug={data.ice} />
            <span class="fact-text">
              {label('ice', data.ice)}
              {data.ice_note && <span class="note">· {data.ice_note}</span>}
            </span>
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Difficulty</dt>
          <dd><Icon field="difficulty" slug={data.difficulty} /> <span class="fact-text">{label('difficulty', data.difficulty)}</span></dd>
        </div>
      </dl>

      {(data.flavors.length > 0 || data.spirits.length > 0) && (
        <div class="taxonomy">
          {data.spirits.length > 0 && (
            <div class="tag-group">
              <span class="eyebrow tag-label">Spirits</span>
              <ul class="tags" aria-label="Spirits">
                {data.spirits.map((s: string) => (
                  <li>
                    <a href={`${base}/by-spirit/${s}/`} class="chip">
                      <Icon field="spirits" slug={s} /> {label('spirits', s)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {data.flavors.length > 0 && (
            <div class="tag-group">
              <span class="eyebrow tag-label">Flavors</span>
              <ul class="tags" aria-label="Flavors">
                {data.flavors.map((f: string) => (
                  <li>
                    <a href={`${base}/by-flavor/${f}/`} class="chip">
                      <Icon field="flavor" slug={f} /> {label('flavor', f)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </header>

    {/* Pre-paint guard: hide non-default panels before the island runs so JS
        users don't see all panels flash then collapse. Removed by the island
        on init; absent with JS off so the no-JS stack stays intact. */}
    {isTabbed && <script is:inline>document.documentElement.classList.add('js-tabs');</script>}

    <div class="recipe-tabs" data-recipe-tabs>
      {isTabbed && (
        <nav class="recipe-tablist" aria-label="Recipe sections">
          {tabIds.map((id) => (
            <a class="recipe-tab" href={`#panel-${id}`} id={`tab-${id}`} data-tab-link={id}>
              {tabLabels[id]}
            </a>
          ))}
        </nav>
      )}

      <section class="recipe-tabpanel recipe-body" id="panel-recipe" data-tab="recipe" data-default>
        {data.ingredients.length > 0 && (
          <Ingredients items={data.ingredients} garnish={data.garnish} float={data.float} />
        )}
        {data.house_made && <HouseMade {...data.house_made} />}
        {data.steps.length > 0 && <Steps items={data.steps} />}
      </section>

      {hasBatch && (
        <section class="recipe-tabpanel recipe-body" id="panel-batching" data-tab="batching">
          <BatchInstructions {...data.batch} />
        </section>
      )}

      {hasNotes && (
        <section
          class="recipe-tabpanel recipe-body"
          id="panel-notes"
          data-tab="notes"
          style={mdHeadingIcons || undefined}
        >
          <Fragment set:html={notesHtml} />
        </section>
      )}

      {hasSource && (
        <section class="recipe-tabpanel source-panel" id="panel-source" data-tab="source" data-pagefind-ignore>
          <h2 class="aside-title">Attribution</h2>
          <p>
            {hasAttribution && (
              <>
                {creator && <>Created by <strong>{creator}</strong></>}
                {bar && <> at <strong>{bar}</strong></>}
                {year && <> in {year}</>}.
              </>
            )}
            {sourceUrl && <> <a href={sourceUrl} rel="noopener">Source</a></>}
          </p>
        </section>
      )}
    </div>

    {relatedRecipes.length > 0 && (
      <aside class="related">
        <h2 class="aside-title"><Icon field="sections" slug="related" /> Related</h2>
        <ul class="recipe-grid">
          {relatedRecipes.map((r) => <RecipeCard recipe={r} />)}
        </ul>
      </aside>
    )}
  </article>
</BaseLayout>

<script>
  import { resolveActiveTab, nextTabIndex } from '../scripts/recipeTabs';

  const root = document.querySelector<HTMLElement>('[data-recipe-tabs]');
  const tablist = root?.querySelector<HTMLElement>('.recipe-tablist');
  const tabs = tablist
    ? Array.from(tablist.querySelectorAll<HTMLAnchorElement>('[data-tab-link]'))
    : [];
  const panels = root
    ? Array.from(root.querySelectorAll<HTMLElement>('.recipe-tabpanel'))
    : [];
  const ids = panels.map((p) => p.dataset.tab ?? '');

  // Only wire the tab widget when there's a real choice. Single-panel recipes
  // stay plain <section> stacks — no tab roles, no orphan tabpanel.
  if (tablist && tabs.length > 0 && panels.length > 1) {
    // Add the ARIA that was deliberately kept out of the static HTML, so JS-off
    // / pre-hydration users never see a tab widget whose contract isn't met.
    tablist.setAttribute('role', 'tablist');
    tabs.forEach((t) => {
      t.setAttribute('role', 'tab');
      t.setAttribute('aria-controls', `panel-${t.dataset.tabLink}`);
    });
    panels.forEach((p) => {
      p.setAttribute('role', 'tabpanel');
      p.setAttribute('aria-labelledby', `tab-${p.dataset.tab}`);
      p.tabIndex = 0;
    });

    // A hash may target a heading *inside* a panel (a Pagefind sub-result like
    // #storage) rather than a panel. Map it to its owning panel via closest(),
    // and keep the heading element so we can scroll to it once the panel shows.
    const resolveTarget = (hash: string): { id: string; heading: HTMLElement | null } => {
      const clean = hash.replace(/^#/, '');
      const el = clean ? document.getElementById(clean) : null;
      const owner = el?.closest<HTMLElement>('.recipe-tabpanel');
      if (owner && owner.dataset.tab && ids.includes(owner.dataset.tab)) {
        // el is the panel itself for a #panel-<id> hash; only a sub-heading scrolls.
        return { id: owner.dataset.tab, heading: el === owner ? null : el };
      }
      return { id: resolveActiveTab(hash, ids), heading: null };
    };

    const activate = (id: string, focusPanel = false) => {
      panels.forEach((p) => {
        p.hidden = p.dataset.tab !== id;
      });
      tabs.forEach((t) => {
        const selected = t.dataset.tabLink === id;
        t.setAttribute('aria-selected', String(selected));
        t.tabIndex = selected ? 0 : -1;
      });
      if (focusPanel) {
        panels.find((p) => p.dataset.tab === id)?.focus();
      }
    };

    // Show the panel a hash targets, then bring its sub-heading into view — the
    // panel was display:none at parse, so the browser's native fragment scroll
    // no-oped and must be replayed once the panel is visible.
    const activateFromHash = (hash: string, focusPanel: boolean) => {
      const { id, heading } = resolveTarget(hash);
      activate(id, focusPanel && !heading);
      heading?.scrollIntoView();
    };

    // Hand authority from the pre-paint CSS guard to the hidden attribute in one
    // synchronous pass, so a deep-linked non-default panel never flickers hidden.
    document.documentElement.classList.remove('js-tabs');
    activateFromHash(location.hash, false);

    // Select a tab: show its panel, sync the URL, and move focus to it.
    const selectTab = (t: HTMLAnchorElement) => {
      const id = t.dataset.tabLink!;
      activate(id);
      history.replaceState(null, '', `#panel-${id}`);
      t.focus();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', (e) => {
        e.preventDefault();
        selectTab(t);
      });
      t.addEventListener('keydown', (e) => {
        const next = nextTabIndex(e.key, i, tabs.length);
        if (next < 0) return;
        e.preventDefault();
        selectTab(tabs[next]);
      });
    });

    // Pagefind result clicks and cross-recipe #panel-batching / #heading links
    // change the hash without a tab click — re-resolve and move focus so the
    // swap is announced.
    window.addEventListener('hashchange', () => {
      activateFromHash(location.hash, true);
    });
  }
</script>

<style>
  .recipe-header {
    margin-bottom: 2rem;
  }

  .back {
    margin-bottom: 1rem;
  }
  .back a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--color-fg);
  }

  .recipe-header h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin-bottom: 0.5rem;
  }

  .blurb {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1875rem;
    color: var(--color-fg-muted);
    line-height: 1.4;
    margin-bottom: 1.5rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.85rem 1.5rem;
    margin: 0;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
  }
  .facts > div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-fg);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .facts dd.fact-stack {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }
  .facts .fact-line {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .facts .fact-text {
    min-width: 0;
  }
  .facts dd :global(.tax-icon) {
    --icon-size: 2.5rem;
    color: var(--color-fg-muted);
  }
  .facts .note {
    color: var(--color-fg-muted);
    margin-left: 0.25rem;
    font-style: italic;
  }
  .facts dd a {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--color-rule-strong);
  }
  .facts dd a:hover {
    text-decoration-color: var(--color-fg);
  }

  .taxonomy {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .tag-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .tag-label {
    flex: none;
    min-width: 4.5rem;
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Tabs — the tablist wraps to a second row on narrow viewports rather than
     scrolling, so no tab is ever hidden and the page body never h-scrolls. */
  .recipe-tabs {
    margin-top: 1.5rem;
  }
  .recipe-tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-sans);
  }
  .recipe-tab {
    padding: 0.5rem 0.85rem;
    margin-bottom: -1px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .recipe-tab:hover {
    color: var(--color-fg);
  }
  .recipe-tab[aria-selected='true'] {
    color: var(--color-fg);
    border-bottom-color: var(--color-accent);
  }
  .recipe-tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .recipe-tabpanel:focus {
    outline: none;
  }
  .recipe-tabpanel:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  /* Pre-paint guard (see the is:inline above). The island removes .js-tabs on
     init and takes over via [hidden], so this only governs the pre-hydration
     frame. Absent with JS off — the full stack shows. */
  :global(html.js-tabs) .recipe-tabpanel:not([data-default]) {
    display: none;
  }

  .recipe-body :global(h2) {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg-muted);
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .recipe-body :global(h2:first-child) {
    margin-top: 1.5rem;
  }
  /* Section-heading icons: one visual treatment whether the icon comes
     from the Icon component (component-rendered sections) or the ::before
     mask (markdown-rendered ## Notes / ## Variations). */
  .recipe-body :global(h2 .tax-icon) {
    --icon-size: 3.4em;
    margin-right: 0.5em;
    vertical-align: -1.3em;
  }
  .recipe-body :global(h2#notes)::before,
  .recipe-body :global(h2#variations)::before {
    content: '';
    display: inline-block;
    width: 3.4em;
    height: 3.4em;
    margin-right: 0.5em;
    vertical-align: -1.3em;
    background-color: currentColor;
    -webkit-mask: var(--md-icon) center / contain no-repeat;
    mask: var(--md-icon) center / contain no-repeat;
  }
  .recipe-body :global(h2#notes)::before {
    --md-icon: var(--icon-notes);
  }
  .recipe-body :global(h2#variations)::before {
    --md-icon: var(--icon-variations);
  }
  .recipe-body :global(p .tax-icon.inline-icon) {
    --icon-size: 2.4em;
    margin-right: 0.25em;
    vertical-align: -0.8em;
    color: var(--color-fg-muted);
  }
  .recipe-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 1.25rem 0 0.5rem;
  }
  .recipe-body :global(p),
  .recipe-body :global(li) {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-fg);
  }
  .recipe-body :global(p) {
    margin-block: 0.75rem;
  }
  .recipe-body :global(ul),
  .recipe-body :global(ol) {
    margin-block: 0.5rem;
    padding-inline-start: 1.25rem;
  }
  .recipe-body :global(li) {
    margin-block: 0.3rem;
  }
  .recipe-body :global(em) {
    color: var(--color-fg-muted);
  }
  .recipe-body :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }
  .recipe-body :global(hr) {
    display: none;
  }

  /* Source tab — attribution prose. */
  .source-panel {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-fg-muted);
  }
  .source-panel p {
    margin: 0.5rem 0 0;
  }
  .source-panel strong {
    color: var(--color-fg);
    font-weight: 600;
  }

  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-fg-muted);
  }
  .aside-title {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg-muted);
    margin: 0 0 0.5rem;
  }
  .aside-title :global(.tax-icon) {
    --icon-size: 3.6em;
    margin-right: 0.5em;
    vertical-align: -1.4em;
  }
  /* Related uses the shared .recipe-grid (RecipeCard) — give the cards a little
     more room to breathe below the muted aside-title. */
  .related .recipe-grid {
    margin-top: 0.25rem;
  }

  /* Print: no tabs, every panel expanded to a single stacked document. */
  @media print {
    .recipe-tablist {
      display: none;
    }
    .recipe-tabpanel,
    .recipe-tabpanel[hidden] {
      display: block !important;
    }
  }
</style>
