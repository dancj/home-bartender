---
import BaseLayout from './BaseLayout.astro';
import type { Recipe } from '../lib/recipes';
import { label } from '../lib/taxonomy';

interface Props {
  recipe: Recipe;
}
const { recipe } = Astro.props;
const { data } = recipe;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasAttribution =
  data.attribution.creator || data.attribution.bar || data.attribution.year;
---
<BaseLayout title={`${data.title} — Home Bartender`} description={data.blurb}>
  <article data-pagefind-body>
    <header class="recipe-header">
      <p class="back">
        <a href={`${base}/`}>← All recipes</a>
      </p>
      <h1>{data.title}</h1>
      <p class="blurb">{data.blurb}</p>

      <dl class="facts">
        <div>
          <dt class="eyebrow">Glass</dt>
          <dd>
            {label('glass', data.glass)}
            {data.glass_note && <span class="note">· {data.glass_note}</span>}
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Method</dt>
          <dd>
            {label('method', data.method)}
            {data.method_note && <span class="note">· {data.method_note}</span>}
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Ice</dt>
          <dd>
            {label('ice', data.ice)}
            {data.ice_note && <span class="note">· {data.ice_note}</span>}
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Difficulty</dt>
          <dd>{label('difficulty', data.difficulty)}</dd>
        </div>
      </dl>

      {(data.flavors.length > 0 || data.spirits.length > 0) && (
        <div class="taxonomy">
          {data.spirits.length > 0 && (
            <ul class="tags" aria-label="Spirits">
              {data.spirits.map((s: string) => (
                <li>
                  <a href={`${base}/by-spirit/${s}/`} class="chip chip-spirit">
                    {label('spirits', s)}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {data.flavors.length > 0 && (
            <ul class="tags" aria-label="Flavors">
              {data.flavors.map((f: string) => (
                <li>
                  <a href={`${base}/by-flavor/${f}/`} class="chip">
                    {f}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )}
    </header>

    <div class="recipe-body">
      <slot />
    </div>

    {hasAttribution && (
      <aside class="attribution" data-pagefind-ignore>
        <h2 class="aside-title">Attribution</h2>
        <p>
          {data.attribution.creator && <>Created by <strong>{data.attribution.creator}</strong></>}
          {data.attribution.bar && <> at <strong>{data.attribution.bar}</strong></>}
          {data.attribution.year && <> in {data.attribution.year}</>}.
          {data.attribution.source_url && <> <a href={data.attribution.source_url} rel="noopener">Source</a></>}
        </p>
      </aside>
    )}

    {data.related.length > 0 && (
      <aside class="related">
        <h2 class="aside-title">Related</h2>
        <ul>
          {data.related.map((slug: string) => (
            <li><a href={`${base}/recipes/${slug}/`}>{slug.replace(/-/g, ' ')}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .recipe-header {
    margin-bottom: 2rem;
  }

  .back {
    margin-bottom: 1rem;
  }
  .back a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: hsl(var(--fg-muted));
    text-decoration: none;
  }
  .back a:hover {
    color: hsl(var(--fg));
  }

  .recipe-header h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin-bottom: 0.5rem;
  }

  .blurb {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1875rem;
    color: hsl(var(--fg-muted));
    line-height: 1.4;
    margin-bottom: 1.5rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.85rem 1.5rem;
    margin: 0;
    padding: 1rem 1.25rem;
    background: hsl(var(--surface));
    border: 1px solid hsl(var(--rule));
    border-radius: var(--radius-md);
  }
  .facts > div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: hsl(var(--fg));
  }
  .facts .note {
    color: hsl(var(--fg-muted));
    margin-left: 0.25rem;
    font-style: italic;
  }

  .taxonomy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 1.25rem;
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip-spirit {
    background: hsl(var(--surface-muted));
    color: hsl(var(--fg));
    border-color: hsl(var(--rule-strong));
    font-weight: 600;
  }

  .recipe-body :global(h2) {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: hsl(var(--fg-muted));
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid hsl(var(--rule));
  }
  .recipe-body :global(h2:first-child) {
    margin-top: 1.5rem;
  }
  .recipe-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 1.25rem 0 0.5rem;
  }
  .recipe-body :global(p),
  .recipe-body :global(li) {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: hsl(var(--fg));
  }
  .recipe-body :global(p) {
    margin-block: 0.75rem;
  }
  .recipe-body :global(ul),
  .recipe-body :global(ol) {
    margin-block: 0.5rem;
    padding-inline-start: 1.25rem;
  }
  .recipe-body :global(li) {
    margin-block: 0.3rem;
  }
  .recipe-body :global(em) {
    color: hsl(var(--fg-muted));
  }
  .recipe-body :global(strong) {
    color: hsl(var(--fg));
    font-weight: 600;
  }
  .recipe-body :global(hr) {
    display: none;
  }

  .attribution,
  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid hsl(var(--rule));
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: hsl(var(--fg-muted));
  }
  .aside-title {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: hsl(var(--fg-muted));
    margin: 0 0 0.5rem;
  }
  .attribution strong {
    color: hsl(var(--fg));
    font-weight: 600;
  }
  .related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .related li a {
    text-transform: capitalize;
    text-decoration: none;
  }
  .related li a {
    display: inline-flex;
    padding: 0.25rem 0.7rem;
    border: 1px solid hsl(var(--rule));
    border-radius: 999px;
    font-size: 0.75rem;
    color: hsl(var(--fg-muted));
    transition: border-color 120ms ease, color 120ms ease;
  }
  .related li a:hover {
    border-color: hsl(var(--rule-strong));
    color: hsl(var(--fg));
  }
</style>
