{
  "name": "home-bartender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:search": "npm run search:index && astro dev",
    "search:index": "astro build && pagefind --site dist --output-path public/pagefind",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "node scripts/validate.mjs",
    "promote": "node scripts/promote.mjs",
    "migrate:bodies": "node scripts/migrate-body-to-frontmatter.mjs",
    "codegen": "node scripts/codegen-taxonomy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-favicons": "node scripts/generate-favicons.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "recipes/**/*.md": "node scripts/validate.mjs --files"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/newsreader": "^5.2.10",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.0.0",
    "pagefind": "^1.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "png-to-ico": "^3.0.0",
    "sharp": "^0.34.0",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
